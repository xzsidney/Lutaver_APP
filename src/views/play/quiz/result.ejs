<%- include('../../partials/header') %>
    <%- include('../../partials/navbar') %>

        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8 text-center">

                    <% if (isPassed) { %>
                        <!-- PASSED: Green Success Card -->
                        <div class="card shadow-lg border-success overflow-hidden">
                            <div class="card-header bg-success text-white py-4 border-0">
                                <h1 class="fw-bold mb-0">🎉 Parabéns!</h1>
                                <p class="mb-0 opacity-75">
                                    <%= adventure.title %>
                                </p>
                            </div>

                            <div class="card-body p-5">
                                <div class="mb-4">
                                    <div style="font-size: 5rem;" class="mb-2">🏆</div>
                                    <h2 class="fw-bold text-success">Você foi Aprovado!</h2>
                                    <p class="text-muted">Você atingiu a nota mínima de <%= passThreshold %>% e concluiu
                                            esta aventura!</p>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded border">
                                            <div class="text-muted small text-uppercase fw-bold">Acertos</div>
                                            <div class="fs-2 fw-bold text-primary">
                                                <%= score %> / <%= total %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded border">
                                            <div class="text-muted small text-uppercase fw-bold">Precisão</div>
                                            <div class="fs-2 fw-bold text-success">
                                                <%= Math.round(percentage) %>%
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded border">
                                            <div class="text-muted small text-uppercase fw-bold">XP Ganho</div>
                                            <div class="fs-2 fw-bold text-warning">+<%= xpEarned %>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <% if (adventure.discipline && affinityGain> 0) { %>
                                    <div
                                        class="alert alert-info border-0 d-flex align-items-center justify-content-center gap-3 mb-4">
                                        <span class="fs-3">
                                            <%= adventure.discipline.icon %>
                                        </span>
                                        <div class="text-start">
                                            <strong>Afinidade com <%= adventure.discipline.name %></strong>
                                            <p class="mb-0 small">Sua afinidade aumentou em +<%= affinityGain %>%!</p>
                                        </div>
                                    </div>
                                    <% } %>

                                        <div class="alert alert-success border-0">
                                            <i class="bi bi-check-circle-fill me-2"></i>
                                            Esta aventura foi marcada como <strong>concluída</strong> e não pode ser
                                            jogada novamente.
                                        </div>

                                        <div class="d-grid gap-2 mt-4">
                                            <a href="/play" class="btn btn-primary btn-lg">
                                                <i class="bi bi-arrow-left me-2"></i> Explorar Outras Aventuras
                                            </a>
                                        </div>
                            </div>
                        </div>

                        <% } else { %>
                            <!-- FAILED: Red/Warning Card -->
                            <div class="card shadow-lg border-danger overflow-hidden">
                                <div class="card-header bg-danger text-white py-4 border-0">
                                    <h1 class="fw-bold mb-0">📚 Continue Tentando!</h1>
                                    <p class="mb-0 opacity-75">
                                        <%= adventure.title %>
                                    </p>
                                </div>

                                <div class="card-body p-5">
                                    <div class="mb-4">
                                        <div style="font-size: 5rem;" class="mb-2">💪</div>
                                        <h2 class="fw-bold text-danger">Você ainda não atingiu <%= passThreshold %>%
                                        </h2>
                                        <p class="text-muted">Continue praticando! Você pode tentar quantas vezes
                                            quiser.</p>
                                    </div>

                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <div class="p-3 bg-light rounded border">
                                                <div class="text-muted small text-uppercase fw-bold">Seu Resultado</div>
                                                <div class="fs-2 fw-bold text-primary">
                                                    <%= score %> / <%= total %>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-3 bg-light rounded border">
                                                <div class="text-muted small text-uppercase fw-bold">Precisão</div>
                                                <div class="fs-2 fw-bold text-danger">
                                                    <%= Math.round(percentage) %>%
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="alert alert-warning border-0">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        Você precisa de <strong>
                                            <%= passThreshold %>%
                                        </strong> ou mais para ser aprovado e ganhar recompensas.
                                    </div>

                                    <div class="d-grid gap-2 d-md-flex justify-content-center mt-4">
                                        <a href="/play" class="btn btn-outline-secondary btn-lg px-4">
                                            <i class="bi bi-arrow-left me-2"></i> Voltar
                                        </a>
                                        <a href="/play/quiz/<%= adventure.id %>/<%= character.id %>"
                                            class="btn btn-danger btn-lg px-4">
                                            <i class="bi bi-arrow-repeat me-2"></i> Refazer Aventura
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% } %>

                </div>
            </div>
        </div>

        <%- include('../../partials/footer') %>