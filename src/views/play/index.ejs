<%- include('../partials/header') %>
    <style>
        :root {
            --azul-magico: #1E90FF;
            --amarelo-faisca: #F7D046;
            --verde-energia: #34D399;
            --branco-radiante: #FFFFFF;
        }

        body {
            background: #F5F7FA;
        }

        .page-header {
            background: linear-gradient(135deg, var(--azul-magico) 0%, #1873CC 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
            border-radius: 0 0 15px 15px;
        }

        .page-header h1 {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .page-header p {
            font-size: 1rem;
            opacity: 0.9;
        }

        .section-title {
            color: var(--azul-magico);
            font-weight: bold;
            font-size: 1.5rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .game-card {
            background: var(--branco-radiante);
            border-radius: 12px;
            padding: 18px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            border: 2px solid transparent;
            height: 100%;
        }

        .game-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.12);
        }

        .character-card {
            border-color: var(--amarelo-faisca);
            text-align: center;
            cursor: pointer;
        }

        .character-card.selected {
            border-color: var(--verde-energia);
            box-shadow: 0 6px 15px rgba(52, 211, 153, 0.3);
        }

        .character-avatar {
            width: 60px;
            height: 60px;
            background: #E8E8E8;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 10px;
        }

        .character-name {
            color: var(--azul-magico);
            font-weight: bold;
            font-size: 1.05rem;
            margin-bottom: 3px;
        }

        .character-year {
            color: #666;
            font-size: 0.8rem;
            margin-bottom: 10px;
        }

        .character-stats {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-bottom: 10px;
        }

        .stat-badge {
            padding: 4px 8px;
            border-radius: 5px;
            font-size: 0.75rem;
            font-weight: bold;
            color: white;
        }

        .stat-level {
            background: var(--amarelo-faisca);
        }

        .stat-xp {
            background: var(--azul-magico);
        }

        .btn-select {
            background: var(--azul-magico);
            color: white;
            border: none;
            padding: 6px 16px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-select:hover {
            background: #1873CC;
        }

        .selected-badge {
            background: var(--verde-energia);
            color: white;
            padding: 6px 16px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: bold;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .how-it-works-card {
            border-color: var(--azul-magico);
            background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
            padding: 20px;
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .step-icon {
            width: 40px;
            height: 40px;
            background: var(--azul-magico);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: white;
            flex-shrink: 0;
        }

        .step-text {
            font-size: 0.9rem;
            color: #333;
            font-weight: 500;
        }

        .adventure-card {
            border-color: var(--amarelo-faisca);
            text-align: center;
        }

        .adventure-card.completed {
            border-color: var(--verde-energia);
            opacity: 0.85;
        }

        .adventure-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 12px;
        }

        .adventure-title {
            color: var(--azul-magico);
            font-weight: bold;
            font-size: 1.05rem;
            margin-bottom: 8px;
        }

        .adventure-meta {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .meta-badge {
            padding: 3px 8px;
            border-radius: 5px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-discipline {
            background: var(--azul-magico);
            color: white;
        }

        .badge-year {
            background: #E8E8E8;
            color: #666;
        }

        .badge-difficulty {
            background: var(--amarelo-faisca);
            color: #333;
        }

        .adventure-description {
            color: #666;
            font-size: 0.8rem;
            margin-bottom: 10px;
            min-height: 45px;
        }

        .adventure-reward {
            background: #FFF3CD;
            border: 2px solid var(--amarelo-faisca);
            border-radius: 6px;
            padding: 6px;
            text-align: center;
            margin-bottom: 10px;
            font-weight: bold;
            font-size: 0.85rem;
            color: #856404;
        }

        .btn-play {
            background: var(--azul-magico);
            color: white;
            border: none;
            padding: 8px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-play:hover {
            background: #1873CC;
        }

        .completed-seal {
            background: var(--verde-energia);
            color: white;
            padding: 8px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: bold;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .completed-list-card {
            border-color: var(--verde-energia);
        }

        .completed-item {
            background: #F0FDF4;
            border-left: 3px solid var(--verde-energia);
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 10px;
        }

        .completed-item-title {
            color: var(--azul-magico);
            font-weight: bold;
            font-size: 0.95rem;
            margin-bottom: 5px;
        }

        .completed-item-meta {
            display: flex;
            gap: 12px;
            font-size: 0.8rem;
            color: #666;
        }

        .trophy-icon {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 12px;
        }

        @media (max-width: 768px) {
            .page-header h1 {
                font-size: 1.75rem;
            }

            .step-item {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>

    <%- include('../partials/navbar') %>

        <div class="page-header">
            <div class="container">
                <h1>🎮 Aventuras Educacionais</h1>
                <p>Escolha seu personagem e comece sua jornada!</p>
            </div>
        </div>

        <div class="container mb-5">
            <% if (!activeCharacter || characters.length===0) { %>
                <div class="alert alert-warning text-center">
                    <strong>⚠️ Atenção:</strong> Você ainda não criou seu personagem!
                    <a href="/my/characters/new" class="alert-link">Clique aqui para criar</a> antes de jogar.
                </div>
                <% } else { %>

                    <!-- MEUS PERSONAGENS -->
                    <section class="mb-4">
                        <h2 class="section-title">
                            <i class="bi bi-people-fill"></i>
                            Meus Personagens
                        </h2>
                        <div class="row">
                            <% characters.forEach(char=> { %>
                                <div class="col-md-4 mb-3">
                                    <div
                                        class="game-card character-card <%= char.id === activeCharacter.id ? 'selected' : '' %>">
                                        <div class="character-avatar">👤</div>
                                        <h4 class="character-name">
                                            <%= char.name %>
                                        </h4>
                                        <p class="character-year">
                                            <%= char.school_year %>º Ano
                                        </p>

                                        <div class="character-stats">
                                            <span class="stat-badge stat-level">Nv <%= char.level %></span>
                                            <span class="stat-badge stat-xp">
                                                <%= char.experience %> XP
                                            </span>
                                        </div>

                                        <% if (char.id===activeCharacter.id) { %>
                                            <span class="selected-badge">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Selecionado
                                            </span>
                                            <% } else { %>
                                                <a href="/play?character_id=<%= char.id %>">
                                                    <button class="btn-select">Selecionar</button>
                                                </a>
                                                <% } %>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                    </section>

                    <!-- COMO FUNCIONA -->
                    <section class="mb-4">
                        <h2 class="section-title">
                            <i class="bi bi-info-circle-fill"></i>
                            Como Funciona
                        </h2>
                        <div class="game-card how-it-works-card">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="step-item">
                                        <div class="step-icon">1️⃣</div>
                                        <div class="step-text">Escolha um personagem</div>
                                    </div>
                                    <div class="step-item">
                                        <div class="step-icon">2️⃣</div>
                                        <div class="step-text">Selecione uma aventura</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="step-item">
                                        <div class="step-icon">3️⃣</div>
                                        <div class="step-text">Resolva o quiz</div>
                                    </div>
                                    <div class="step-item">
                                        <div class="step-icon">4️⃣</div>
                                        <div class="step-text">Acerte 70%+ para ganhar XP</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- AVENTURAS DISPONÍVEIS -->
                    <section class="mb-4">
                        <h2 class="section-title">
                            <i class="bi bi-map-fill"></i>
                            Aventuras Disponíveis
                        </h2>

                        <% if (adventures.length===0) { %>
                            <div class="game-card text-center py-5">
                                <div style="font-size: 4rem; margin-bottom: 15px;">🗺️</div>
                                <h3 class="text-muted">Nenhuma aventura disponível</h3>
                                <p class="text-secondary">Volte mais tarde!</p>
                            </div>
                            <% } else { %>
                                <div class="row">
                                    <% adventures.forEach(adv=> { %>
                                        <% const isCompleted=completedAdventureIds.includes(adv.id); %>
                                            <div class="col-md-4 mb-3">
                                                <div
                                                    class="game-card adventure-card <%= isCompleted ? 'completed' : '' %>">
                                                    <div class="adventure-icon"
                                                        style="background: linear-gradient(135deg, <%= adv.discipline ? adv.discipline.color_theme : '#667eea' %> 0%, <%= adv.discipline ? adv.discipline.color_theme + 'dd' : '#764ba2' %> 100%);">
                                                        <%= adv.discipline ? adv.discipline.icon : '🗺️' %>
                                                    </div>

                                                    <h4 class="adventure-title">
                                                        <%= adv.title %>
                                                    </h4>

                                                    <div class="adventure-meta">
                                                        <span class="meta-badge badge-discipline">
                                                            <%= adv.discipline ? adv.discipline.name : 'Geral' %>
                                                        </span>
                                                        <span class="meta-badge badge-year">
                                                            <%= adv.school_year %>º Ano
                                                        </span>
                                                        <span class="meta-badge badge-difficulty">
                                                            <% for(let i=0; i < adv.difficulty; i++) { %>⭐<% } %>
                                                        </span>
                                                    </div>

                                                    <p class="adventure-description">
                                                        <%= adv.description ? adv.description.substring(0, 80) + '...'
                                                            : 'Aventura educacional!' %>
                                                    </p>

                                                    <div class="adventure-reward">
                                                        <i class="bi bi-star-fill"></i> +<%= adv.reward_xp %> XP
                                                    </div>

                                                    <% if (isCompleted) { %>
                                                        <div class="completed-seal">
                                                            <i class="bi bi-check-circle-fill"></i>
                                                            Concluída
                                                        </div>
                                                        <% } else { %>
                                                            <a href="/play/quiz/<%= adv.id %>/<%= activeCharacter.id %>"
                                                                style="text-decoration: none;">
                                                                <button class="btn-play">
                                                                    <i class="bi bi-play-fill"></i>
                                                                    Jogar
                                                                </button>
                                                            </a>
                                                            <% } %>
                                                </div>
                                            </div>
                                            <% }); %>
                                </div>
                                <% } %>
                    </section>

                    <!-- AVENTURAS CONCLUÍDAS -->
                    <% const completedAdventures=adventures.filter(adv=> completedAdventureIds.includes(adv.id));
                        if (completedAdventures.length > 0) {
                        %>
                        <section class="mb-4">
                            <h2 class="section-title">
                                <i class="bi bi-trophy-fill"></i>
                                Concluídas
                            </h2>
                            <div class="game-card completed-list-card">
                                <div class="trophy-icon">🏆</div>
                                <% completedAdventures.forEach(adv=> { %>
                                    <div class="completed-item">
                                        <div class="completed-item-title">
                                            <%= adv.discipline ? adv.discipline.icon : '🗺️' %>
                                                <%= adv.title %>
                                        </div>
                                        <div class="completed-item-meta">
                                            <span><strong>Disciplina:</strong>
                                                <%= adv.discipline ? adv.discipline.name : 'Geral' %>
                                            </span>
                                            <span><strong>XP:</strong> +<%= adv.reward_xp %></span>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>
                        </section>
                        <% } %>

                            <% } %>
        </div>

        <%- include('../partials/footer') %>