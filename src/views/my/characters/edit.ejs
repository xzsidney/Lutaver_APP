<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Personagem - Lutaver</title>
    <link rel="stylesheet" href="/css/lutaver.css">
</head>

<body>
    <%- include('../../partials/navbar', { user }) %>

        <div class="dashboard-container">
            <div class="header">
                <h1>✏️ Editar Personagem</h1>
                <p>Atualize os dados de <%= character.name %>
                </p>
            </div>

            <div
                style="background: white; padding: 30px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); max-width: 600px;">
                <% if (error) { %>
                    <div class="error-message">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/my/characters/<%= character.id %>" method="POST">
                            <div class="form-group">
                                <label for="name">Nome do Personagem *</label>
                                <input type="text" id="name" name="name" value="<%= character.name %>" required>
                            </div>

                            <div class="form-group">
                                <label for="school_year">Ano Escolar *</label>
                                <select id="school_year" name="school_year" required>
                                    <option value="6" <%=character.school_year===6 ? 'selected' : '' %>>6º Ano</option>
                                    <option value="7" <%=character.school_year===7 ? 'selected' : '' %>>7º Ano</option>
                                    <option value="8" <%=character.school_year===8 ? 'selected' : '' %>>8º Ano</option>
                                    <option value="9" <%=character.school_year===9 ? 'selected' : '' %>>9º Ano</option>
                                </select>
                            </div>

                            <div style="display: flex; gap: 10px; margin-top: 20px;">
                                <button type="submit" class="btn btn-success">Salvar Alterações</button>
                                <a href="/my/characters" class="btn btn-secondary">Cancelar</a>
                            </div>
                        </form>
            </div>
        </div>
</body>

</html>