<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Disciplina - Lutaver</title>
    <link rel="stylesheet" href="/css/lutaver.css">
</head>

<body>
    <%- include('../partials/navbar', { user }) %>

        <div class="dashboard-container">
            <div class="header">
                <h1>📚 Editar Disciplina</h1>
                <p>Atualize os dados da disciplina <%= discipline.name %>
                </p>
            </div>

            <div
                style="background: white; padding: 30px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); max-width: 800px;">
                <% if (error) { %>
                    <div class="error-message">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/disciplines/<%= discipline.id %>" method="POST">
                            <div class="form-group">
                                <label for="name">Nome da Disciplina *</label>
                                <input type="text" id="name" name="name" value="<%= discipline.name %>" required>
                            </div>

                            <div class="form-group">
                                <label for="code">Código *</label>
                                <input type="text" id="code" name="code" value="<%= discipline.code %>" required
                                    maxlength="10" style="text-transform: uppercase;">
                                <small style="color: #666;">Código curto para identificação (será convertido para
                                    maiúsculas)</small>
                            </div>

                            <div class="form-group">
                                <label for="description">Descrição</label>
                                <textarea id="description" name="description"
                                    rows="3"><%= discipline.description || '' %></textarea>
                            </div>

                            <div class="form-group">
                                <label for="school_level">Nível Escolar *</label>
                                <select id="school_level" name="school_level" required>
                                    <option value="fundamental_1" <%=discipline.school_level==='fundamental_1'
                                        ? 'selected' : '' %>>
                                        Fundamental I (1º ao 5º ano)
                                    </option>
                                    <option value="fundamental_2" <%=discipline.school_level==='fundamental_2'
                                        ? 'selected' : '' %>>
                                        Fundamental II (6º ao 9º ano)
                                    </option>
                                    <option value="medio" <%=discipline.school_level==='medio' ? 'selected' : '' %>>
                                        Ensino Médio
                                    </option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="icon">Ícone (Emoji)</label>
                                <input type="text" id="icon" name="icon" value="<%= discipline.icon || '' %>"
                                    maxlength="2">
                                <small style="color: #666;">Escolha um emoji para representar a disciplina (ex: 📐 📚 🧪
                                    🌍 🎨)</small>
                            </div>

                            <div class="form-group">
                                <label for="color_theme">Cor Tema</label>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <input type="color" id="color_theme" name="color_theme"
                                        value="<%= discipline.color_theme || '#1E90FF' %>"
                                        style="width: 60px; height: 40px; cursor: pointer;">
                                    <input type="text" id="color_text"
                                        value="<%= discipline.color_theme || '#1E90FF' %>" readonly
                                        style="width: 100px; background: #f5f5f5;">
                                </div>
                                <small style="color: #666;">Cor que representa a disciplina no sistema</small>
                            </div>

                            <div class="form-group">
                                <div class="checkbox-group">
                                    <input type="checkbox" id="is_active" name="is_active" <%=discipline.is_active
                                        ? 'checked' : '' %>>
                                    <label for="is_active" style="margin: 0;">Disciplina ativa?</label>
                                </div>
                            </div>

                            <div style="display: flex; gap: 10px; margin-top: 30px;">
                                <button type="submit" class="btn btn-success">Salvar Alterações</button>
                                <a href="/disciplines" class="btn btn-secondary">Cancelar</a>
                            </div>
                        </form>
            </div>
        </div>

        <script>
            // Sync color picker with text input
            const colorPicker = document.getElementById('color_theme');
            const colorText = document.getElementById('color_text');

            colorPicker.addEventListener('input', (e) => {
                colorText.value = e.target.value.toUpperCase();
            });
        </script>
</body>

</html>