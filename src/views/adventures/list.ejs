<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aventuras - Lutaver</title>
    <link rel="stylesheet" href="/css/lutaver.css">
</head>

<body>
    <%- include('../partials/navbar', { user }) %>

        <div class="dashboard-container">
            <div class="header">
                <h1>🗺️ Gerenciar Aventuras</h1>
                <p>Gerencie as aventuras educacionais disponíveis no sistema</p>
            </div>

            <div style="margin-bottom: 20px;">
                <a href="/adventures/new" class="btn btn-primary">+ Nova Aventura</a>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Disciplina</th>
                            <th>Ano Escolar</th>
                            <th>Dificuldade</th>
                            <th>Recompensa XP</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (adventures.length===0) { %>
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 40px; color: #999;">
                                    Nenhuma aventura cadastrada
                                </td>
                            </tr>
                            <% } else { %>
                                <% adventures.forEach(adv=> { %>
                                    <tr>
                                        <td><strong>
                                                <%= adv.title %>
                                            </strong></td>
                                        <td>
                                            <% if (adv.discipline) { %>
                                                <div style="display: flex; align-items: center; gap: 8px;">
                                                    <span style="font-size: 20px;">
                                                        <%= adv.discipline.icon || '📚' %>
                                                    </span>
                                                    <span class="badge"
                                                        style="background: <%= adv.discipline.color_theme || '#1E90FF' %>;">
                                                        <%= adv.discipline.name %>
                                                    </span>
                                                </div>
                                                <% } else { %>
                                                    <span style="color: #999;">-</span>
                                                    <% } %>
                                        </td>
                                        <td>
                                            <%= adv.school_year %>
                                        </td>
                                        <td>
                                            <div style="color: #F7D046; font-size: 16px;">
                                                <% for(let i=0; i < adv.difficulty; i++) { %>⭐<% } %>
                                                        <% for(let i=adv.difficulty; i < 5; i++) { %>☆<% } %>
                                            </div>
                                        </td>
                                        <td>
                                            <strong style="color: #34D399;">
                                                <%= adv.reward_xp %> XP
                                            </strong>
                                        </td>
                                        <td>
                                            <span
                                                class="badge <%= adv.is_active ? 'badge-active' : 'badge-inactive' %>">
                                                <%= adv.is_active ? 'Ativa' : 'Inativa' %>
                                            </span>
                                        </td>
                                        <td>
                                            <div style="display: flex; gap: 5px;">
                                                <a href="/adventures/<%= adv.id %>" class="btn btn-info btn-sm"
                                                    style="background-color: #1E90FF; color: white;">Ver</a>
                                                <a href="/adventures/<%= adv.id %>/edit"
                                                    class="btn btn-warning btn-sm">Editar</a>
                                                <form action="/adventures/<%= adv.id %>/delete" method="POST"
                                                    style="display: inline;"
                                                    onsubmit="return confirm('Tem certeza que deseja excluir esta aventura?');">
                                                    <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
</body>

</html>