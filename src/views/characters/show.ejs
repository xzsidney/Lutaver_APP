<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ficha do Personagem - <%= character.name %>
    </title>
    <link rel="stylesheet" href="/css/lutaver.css">
    <style>
        .stat-box {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            position: relative;
        }

        .stat-value {
            font-size: 24px;
            font-weight: bold;
            color: #2c3e50;
        }

        .stat-label {
            font-size: 12px;
            text-transform: uppercase;
            color: #7f8c8d;
            margin-top: 5px;
        }

        .btn-upgrade {
            background: #2ecc71;
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 16px;
            line-height: 24px;
            cursor: pointer;
            position: absolute;
            top: -10px;
            right: -10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .affinity-bar {
            height: 10px;
            background: #e9ecef;
            border-radius: 5px;
            overflow: hidden;
            margin-top: 5px;
        }

        .affinity-fill {
            height: 100%;
            background: linear-gradient(to right, #3498db, #2ecc71);
        }

        .power-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            background: white;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .power-icon {
            font-size: 24px;
            width: 40px;
            height: 40px;
            background: #f0f9ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .locked {
            opacity: 0.6;
            filter: grayscale(1);
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar', { user }) %>

        <div class="dashboard-container">
            <!-- Header -->
            <div class="card"
                style="margin-bottom: 20px; background: linear-gradient(135deg, #1E90FF 0%, #34D399 100%); color: white;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <h1 style="margin: 0; font-size: 32px;">
                            <%= character.name %>
                        </h1>
                        <p style="margin: 5px 0; opacity: 0.9;">
                            <%= character.title %> | <%= character.school_year %>º Ano
                        </p>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 24px; font-weight: bold;">Nível <%= character.level %>
                        </div>
                        <div style="font-size: 14px; opacity: 0.9;">
                            <%= character.total_xp %> XP
                        </div>
                    </div>
                </div>
                <div style="margin-top: 15px; background: rgba(255,255,255,0.2); padding: 10px; border-radius: 5px;">
                    📍 Local Atual: <strong>
                        <%= character.current_map %>
                    </strong>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <!-- Atributos -->
                <div class="card">
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <h2 style="margin: 0; color: #1E90FF;">📊 Atributos</h2>
                        <% if (character.evolution_points> 0) { %>
                            <span class="badge" style="background: #F7D046; color: #1A1A1A;">
                                💎 <%= character.evolution_points %> Pontos Disponíveis
                            </span>
                            <% } %>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px;">
                        <% const attrs=[ { key: 'strength' , label: 'Força' , icon: '💪' }, { key: 'dexterity' ,
                            label: 'Destreza' , icon: '🏃' }, { key: 'constitution' , label: 'Constituição' , icon: '❤️'
                            }, { key: 'intelligence' , label: 'Inteligência' , icon: '🧠' }, { key: 'reasoning' ,
                            label: 'Raciocínio' , icon: '💡' }, { key: 'luck' , label: 'Sorte' , icon: '🍀' } ]; %>

                            <% attrs.forEach(attr=> { %>
                                <div class="stat-box">
                                    <div style="font-size: 20px; margin-bottom: 5px;">
                                        <%= attr.icon %>
                                    </div>
                                    <div class="stat-value">
                                        <%= character[attr.key] %>
                                    </div>
                                    <div class="stat-label">
                                        <%= attr.label %>
                                    </div>

                                    <% if (character.evolution_points> 0) { %>
                                        <form action="/characters/<%= character.id %>/attributes" method="POST">
                                            <input type="hidden" name="attribute" value="<%= attr.key %>">
                                            <button type="submit" class="btn-upgrade"
                                                title="Evoluir Atributo">+</button>
                                        </form>
                                        <% } %>
                                </div>
                                <% }); %>
                    </div>
                </div>

                <!-- Afinidades -->
                <div class="card">
                    <h2 style="margin: 0 0 15px 0; color: #9333EA;">📚 Afinidades</h2>

                    <% if (character.affinities && character.affinities.length> 0) { %>
                        <div style="display: grid; gap: 15px;">
                            <% character.affinities.forEach(aff=> { %>
                                <div>
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                                        <strong>
                                            <%= aff.discipline.icon || '📘' %>
                                                <%= aff.discipline.name %>
                                        </strong>
                                        <span class="badge" style="background: #eee; color: #333;">Nível <%=
                                                aff.affinity_level %></span>
                                    </div>
                                    <div class="affinity-bar">
                                        <div class="affinity-fill"
                                            style="width: <%= Math.min(aff.affinity_level * 10, 100) %>%"></div>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <p style="color: #999; text-align: center;">Nenhuma afinidade registrada ainda.</p>
                            <% } %>
                </div>
            </div>

            <!-- Poderes -->
            <div class="card" style="margin-top: 20px;">
                <h2 style="margin: 0 0 15px 0; color: #E74C3C;">⚡ Poderes</h2>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <!-- Aprendidos -->
                    <div>
                        <h3 style="font-size: 16px; color: #666; border-bottom: 2px solid #eee; padding-bottom: 5px;">
                            Aprendidos</h3>
                        <% if (character.powers && character.powers.length> 0) { %>
                            <% character.powers.forEach(power=> { %>
                                <div class="power-card" style="border-left: 4px solid #2ecc71;">
                                    <div class="power-icon">
                                        <%= power.icon || '⚡' %>
                                    </div>
                                    <div>
                                        <strong style="display: block;">
                                            <%= power.name %>
                                        </strong>
                                        <small style="color: #666;">
                                            <%= power.description %>
                                        </small>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <p style="color: #999; font-style: italic;">Nenhum poder aprendido ainda.</p>
                                        <% } %>
                    </div>

                    <!-- Disponíveis -->
                    <div>
                        <h3 style="font-size: 16px; color: #666; border-bottom: 2px solid #eee; padding-bottom: 5px;">
                            Disponíveis para Aprender</h3>
                        <% if (availablePowers && availablePowers.length> 0) { %>
                            <% availablePowers.forEach(power=> { %>
                                <div class="power-card" style="border-left: 4px solid #3498db;">
                                    <div class="power-icon">
                                        <%= power.icon || '✨' %>
                                    </div>
                                    <div style="flex: 1;">
                                        <strong style="display: block;">
                                            <%= power.name %>
                                        </strong>
                                        <small style="color: #666;">
                                            <%= power.discipline.name %> (Req: <%= power.required_affinity %>)
                                        </small>
                                    </div>
                                    <form action="/characters/<%= character.id %>/powers" method="POST">
                                        <input type="hidden" name="power_id" value="<%= power.id %>">
                                        <button type="submit" class="btn btn-primary btn-sm">Aprender</button>
                                    </form>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <p style="color: #999; font-style: italic;">Nenhum novo poder disponível no
                                            momento.</p>
                                        <% } %>

                                            <!-- Bloqueados (Opcional) -->
                                            <% if (lockedPowers && lockedPowers.length> 0) { %>
                                                <h4 style="margin-top: 15px; font-size: 14px; color: #999;">Bloqueados
                                                </h4>
                                                <% lockedPowers.slice(0, 3).forEach(power=> { %>
                                                    <div class="power-card locked" style="background: #f9f9f9;">
                                                        <div class="power-icon">🔒</div>
                                                        <div>
                                                            <strong style="display: block; color: #999;">
                                                                <%= power.name %>
                                                            </strong>
                                                            <small style="color: #aaa;">Requer <%= power.discipline.name
                                                                    %> Nível <%= power.required_affinity %></small>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                                        <% if (lockedPowers.length> 3) { %>
                                                            <small style="color: #999;">+ <%= lockedPowers.length - 3 %>
                                                                    outros poderes bloqueados</small>
                                                            <% } %>
                                                                <% } %>
                    </div>
                </div>
            </div>

            <div style="margin-top: 20px;">
                <a href="/characters" class="btn btn-secondary">← Voltar para Lista</a>
            </div>
        </div>
</body>

</html>