<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personagens - Lutaver</title>
    <link rel="stylesheet" href="/css/lutaver.css">
</head>
<body>
    <%- include('../partials/navbar', { user }) %>
    
    <div class="dashboard-container">
        <div class="header">
            <h1>👥 Personagens</h1>
            <p>Gerencie os heróis do Lutaver</p>
        </div>
        
        <div style="margin-bottom: 20px;">
            <a href="/characters/new" class="btn btn-primary">+ Novo Personagem</a>
        </div>
        
        <% if (characters.length === 0) { %>
            <div style="background: white; padding: 60px; border-radius: 10px; text-align: center; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">
                <div style="font-size: 80px; margin-bottom: 20px;">🛡️</div>
                <h3 style="color: #666; margin-bottom: 10px;">Nenhum personagem encontrado</h3>
                <p style="color: #999;">Crie o primeiro herói desta aventura!</p>
            </div>
        <% } else { %>
            <div class="cards-grid">
                <% characters.forEach(char => { %>
                    <div class="card">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                            <div>
                                <h3 style="color: #1E90FF; margin-bottom: 5px;"><%= char.name %></h3>
                                <span class="badge" style="background: #F7D046; color: #1A1A1A;">Nível <%= char.level %></span>
                                <span class="badge" style="background: #34D399;"><%= char.school_year %>º Ano</span>
                            </div>
                            <div style="font-size: 30px;">👤</div>
                        </div>
                        
                        <div style="margin-bottom: 15px; color: #666; font-size: 14px;">
                            <p><strong>Dono:</strong> <%= char.user ? char.user.name : 'Sistema' %></p>
                            <p><strong>Mapa:</strong> <%= char.current_map %></p>
                            <p><strong>XP:</strong> <%= char.total_xp %></p>
                        </div>
                        
                        <div style="display: flex; gap: 5px;">
                            <a href="/characters/<%= char.id %>" class="btn btn-primary btn-sm" style="flex: 1;">📄 Ficha</a>
                            <a href="/characters/<%= char.id %>/edit" class="btn btn-warning btn-sm">✏️</a>
                            <form action="/characters/<%= char.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Excluir personagem?');">
                                <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</body>
</html>
