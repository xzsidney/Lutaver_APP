<!DOCTYPE html>
background: white;
border-radius: 15px;
box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
overflow: hidden;
}

.scene-header {
background: <%=adventure.discipline ? adventure.discipline.color_theme: '#1E90FF' %>;
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    }

    .scene-content {
    padding: 30px;
    }

    .npc-dialog {
    background: #f8f9fa;
    border-left: 5px solid #F7D046;
    padding: 20px;
    margin-bottom: 25px;
    border-radius: 0 10px 10px 0;
    }

    .environment-desc {
    color: #666;
    font-style: italic;
    margin-bottom: 20px;
    line-height: 1.6;
    }

    <%=adventure.title %>
        </h2><span style="font-size: 14px; opacity: 0.9;">Cena <%=scene.order_index %>: <%=scene.title %></span></div>
        <div><a href="/play" class="btn btn-sm" style="background: rgba(255,255,255,0.2); color: white;">Sair</a></div>
        </div>
        <div class="scene-content">
            <% if (scene.environment_description) { %>
                <div class="environment-desc">📍 <%=scene.environment_description %>
                </div>
                <% } %>
                    <% if (scene.npc_name) { %>
                        <div class="npc-dialog"><strong style="display: block; margin-bottom: 5px; color: #333;">
                                <%=scene.npc_name %>diz:
                            </strong> "<%= scene.scene_text %>"
                        </div>
                        <% } else { %>
                            <div style="margin-bottom: 25px; line-height: 1.6;">
                                <%=scene.scene_text %>
                            </div>
                            <% } %>
                                <div class="action-area">
                                    <% if (scene.test_type) { %>
                                        <div style="text-align: center;">
                                            <h3 style="margin-bottom: 15px;">Desafio de <%=scene.test_type %> ! </h3>
                                            <p style="margin-bottom: 20px;">Dificuldade: <%=scene.difficulty %> ⭐</p>
                                            <form action="/play/adventure/<%= adventure.id %>/scene/<%= scene.id %>"
                                                method="POST"> <button type="submit" class="btn btn-primary btn-lg"> 🎲
                                                    Rolar Dados (<%=scene.attribute_used %>) </button> </form>
                                        </div>
                                        <% } else { %>
                                            <div style="text-align: right;">
                                                <form action="/play/adventure/<%= adventure.id %>/scene/<%= scene.id %>"
                                                    method="POST"><button type="submit"
                                                        class="btn btn-primary">Continuar ➡️ </button></form>
                                            </div>
                                            <% } %>
                                </div>
        </div>
        </div>
        </div>
        </body>

        </html>