<div class="player-home-container">
    <div class="section-header">
        <h1 class="home-title">
            <%= adventure.title %>
        </h1>
        <p class="home-subtitle">
            <%= adventure.discipline ? adventure.discipline.name : 'Aventura Educacional' %>
        </p>
    </div>

    <!-- Character Info -->
    <div class="character-info-bar">
        <div class="char-info">
            <span class="char-icon">🧙</span>
            <div>
                <strong>
                    <%= character.name %>
                </strong>
                <small>Nv <%= character.level %> | <%= character.total_xp %> XP | 💰 <%= character.coins %></small>
            </div>
        </div>
    </div>

    <div class="adventure-detail-container">
        <!-- Main Info Card -->
        <div class="detail-card">
            <h2 class="card-title">📖 Sobre a Aventura</h2>

            <div class="detail-meta">
                <div class="meta-row">
                    <span class="meta-label">Ano Escolar:</span>
                    <span class="meta-value">
                        <%= adventure.school_year %>
                    </span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Dificuldade:</span>
                    <span class="meta-value">
                        <% for(let i=0; i < adventure.difficulty; i++) { %>⭐<% } %>
                    </span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Recompensa XP:</span>
                    <span class="meta-value">🎯 <%= adventure.reward_xp %></span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Recompensa Moedas:</span>
                    <span class="meta-value">💰 <%= adventure.reward_item || 50 %></span>
                </div>
            </div>

            <% if (adventure.description) { %>
                <div class="description-box">
                    <h3>Descrição</h3>
                    <p>
                        <%= adventure.description %>
                    </p>
                </div>
                <% } %>

                    <% if (adventure.objectives) { %>
                        <div class="objectives-box">
                            <h3>Objetivos de Aprendizagem</h3>
                            <p>
                                <%= adventure.objectives %>
                            </p>
                        </div>
                        <% } %>
        </div>

        <!-- Status Card -->
        <div class="detail-card">
            <h2 class="card-title">📊 Status</h2>

            <% if (isCompleted) { %>
                <div class="status-completed">
                    <div class="status-icon">✅</div>
                    <h3>Aventura Concluída!</h3>
                    <p>Você já completou esta aventura.</p>

                    <% if (progress) { %>
                        <div class="progress-stats">
                            <div class="stat-item">
                                <span class="stat-label">Acertos:</span>
                                <span class="stat-value">
                                    <%= progress.correct_answers %>/<%= progress.total_questions %>
                                </span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Percentual:</span>
                                <span class="stat-value">
                                    <%= progress.percentage %>%
                                </span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">XP Ganho:</span>
                                <span class="stat-value">
                                    <%= progress.xp_earned %>
                                </span>
                            </div>
                        </div>
                        <% } %>

                            <a href="/player/adventures/<%= adventure.id %>/start" class="btn btn-retry">
                                🔄 Tentar Novamente
                            </a>
                </div>
                <% } else { %>
                    <div class="status-available">
                        <div class="status-icon">🎮</div>
                        <h3>Pronto para Começar!</h3>
                        <p>Esta aventura está disponível. Teste seus conhecimentos!</p>

                        <a href="/player/adventures/<%= adventure.id %>/start" class="btn btn-start">
                            ▶️ Iniciar Aventura
                        </a>
                    </div>
                    <% } %>
        </div>
    </div>

    <div class="back-link">
        <a href="/player/dashboard">← Voltar ao Dashboard</a>
    </div>
</div>

<style>
    .character-info-bar {
        background: linear-gradient(135deg, #1E90FF, #00C853);
        color: #ffffff;
        padding: 15px 20px;
        border-radius: 12px;
        margin-bottom: 30px;
        box-shadow: 0 4px 10px rgba(30, 144, 255, 0.3);
    }

    .char-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .char-icon {
        font-size: 2rem;
    }

    .char-info strong {
        display: block;
        font-size: 1.1rem;
    }

    .char-info small {
        display: block;
        opacity: 0.9;
        margin-top: 4px;
    }

    .adventure-detail-container {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 25px;
        margin-bottom: 30px;
    }

    .detail-card {
        background: #ffffff;
        border-radius: 18px;
        border: 2px solid #e2ecff;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(15, 49, 96, 0.06);
    }

    .card-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #123055;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f0f4f8;
    }

    .detail-meta {
        margin-bottom: 20px;
    }

    .meta-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f0f4f8;
    }

    .meta-label {
        font-weight: 600;
        color: #123055;
    }

    .meta-value {
        color: #4b6688;
        font-weight: 500;
    }

    .description-box,
    .objectives-box {
        margin-top: 20px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 12px;
    }

    .description-box h3,
    .objectives-box h3 {
        color: #123055;
        font-size: 1rem;
        margin-bottom: 10px;
    }

    .description-box p,
    .objectives-box p {
        color: #4b6688;
        line-height: 1.6;
        margin: 0;
    }

    .status-completed,
    .status-available {
        text-align: center;
        padding: 20px;
    }

    .status-icon {
        font-size: 4rem;
        margin-bottom: 15px;
    }

    .status-completed h3,
    .status-available h3 {
        color: #123055;
        margin-bottom: 10px;
    }

    .status-completed p,
    .status-available p {
        color: #4b6688;
        margin-bottom: 20px;
    }

    .progress-stats {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
    }

    .stat-label {
        font-weight: 600;
        color: #123055;
    }

    .stat-value {
        color: #4b6688;
        font-weight: 500;
    }

    .btn {
        display: inline-block;
        padding: 12px 28px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease-in-out;
        border: none;
        cursor: pointer;
        font-size: 1rem;
    }

    .btn-start {
        background: #00C853;
        color: #ffffff;
    }

    .btn-start:hover {
        background: #02a343;
    }

    .btn-retry {
        background: #F7D046;
        color: #123055;
    }

    .btn-retry:hover {
        background: #f5c518;
    }

    .back-link {
        text-align: center;
        margin-top: 20px;
    }

    .back-link a {
        color: #1E90FF;
        text-decoration: none;
        font-weight: 600;
    }

    .back-link a:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .adventure-detail-container {
            grid-template-columns: 1fr;
        }
    }
</style>