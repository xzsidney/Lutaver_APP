<div class="player-home-container">
    <div class="section-header">
        <h1 class="home-title">🏪 Loja de Itens</h1>
        <p class="home-subtitle">Compre itens para melhorar seu personagem</p>
    </div>

    <!-- Character Info Bar -->
    <div class="character-info-bar">
        <div class="char-info">
            <span class="char-icon">🧙</span>
            <div>
                <strong>
                    <%= character.name %>
                </strong>
                <small>Nv <%= character.level %> | 💰 <%= character.coins %> Moedas</small>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    <% if (typeof query !=='undefined' ) { %>
        <% if (query.success==='purchased' ) { %>
            <div class="alert alert-success">
                ✅ Item comprado com sucesso!
            </div>
            <% } else if (query.error==='not_enough_coins' ) { %>
                <div class="alert alert-danger">
                    ⚠️ Você não tem moedas suficientes para comprar este item.
                </div>
                <% } else if (query.error==='already_owned' ) { %>
                    <div class="alert alert-warning">
                        ⚠️ Você já possui este item único.
                    </div>
                    <% } else if (query.error==='purchase_failed' ) { %>
                        <div class="alert alert-danger">
                            ⚠️ Erro ao processar a compra. Tente novamente.
                        </div>
                        <% } %>
                            <% } %>

                                <!-- Filters -->
                                <div class="shop-filters">
                                    <div class="filter-group">
                                        <label for="typeFilter">Tipo:</label>
                                        <select id="typeFilter" onchange="applyFilters()">
                                            <option value="">Todos</option>
                                            <option value="consumable" <%=filters.type==='consumable' ? 'selected' : ''
                                                %>>Consumível</option>
                                            <option value="equipment" <%=filters.type==='equipment' ? 'selected' : '' %>
                                                >Equipamento</option>
                                            <option value="key" <%=filters.type==='key' ? 'selected' : '' %>>Chave
                                            </option>
                                            <option value="cosmetic" <%=filters.type==='cosmetic' ? 'selected' : '' %>
                                                >Cosmético</option>
                                        </select>
                                    </div>

                                    <div class="filter-group">
                                        <label for="sortFilter">Ordenar:</label>
                                        <select id="sortFilter" onchange="applyFilters()">
                                            <option value="" <%=!filters.sort ? 'selected' : '' %>>Padrão</option>
                                            <option value="price_asc" <%=filters.sort==='price_asc' ? 'selected' : '' %>
                                                >Preço (Menor)</option>
                                            <option value="price_desc" <%=filters.sort==='price_desc' ? 'selected' : ''
                                                %>>Preço (Maior)</option>
                                            <option value="name" <%=filters.sort==='name' ? 'selected' : '' %>>Nome
                                            </option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Items Grid -->
                                <% if (items.length===0) { %>
                                    <div class="empty-state">
                                        <div class="empty-icon">📦</div>
                                        <h2>Nenhum item disponível</h2>
                                        <p>A loja está vazia no momento.</p>
                                    </div>
                                    <% } else { %>
                                        <div class="items-grid">
                                            <% items.forEach(item=> { %>
                                                <div class="item-card rarity-<%= item.rarity %>">
                                                    <div class="item-icon">
                                                        <%= item.icon %>
                                                    </div>

                                                    <h3 class="item-name">
                                                        <%= item.name %>
                                                    </h3>

                                                    <div class="item-meta">
                                                        <span class="item-type">
                                                            <%= item.type %>
                                                        </span>
                                                        <span class="item-rarity">
                                                            <%= item.rarity %>
                                                        </span>
                                                    </div>

                                                    <% if (item.description) { %>
                                                        <p class="item-description">
                                                            <%= item.description.substring(0, 80) %>
                                                                <%= item.description.length> 80 ? '...' : '' %>
                                                        </p>
                                                        <% } %>

                                                            <div class="item-price">
                                                                <span class="price-label">Preço:</span>
                                                                <span class="price-value">💰 <%= item.price %></span>
                                                            </div>

                                                            <% const canAfford=character.coins>= item.price;
                                                                const alreadyOwned = item.is_unique &&
                                                                ownedItemIds.includes(item.id);
                                                                const canBuy = canAfford && !alreadyOwned;
                                                                %>

                                                                <% if (alreadyOwned) { %>
                                                                    <button class="btn btn-owned" disabled>✓ Já
                                                                        Possui</button>
                                                                    <% } else if (!canAfford) { %>
                                                                        <button class="btn btn-disabled" disabled>💰 Sem
                                                                            Moedas</button>
                                                                        <% } else { %>
                                                                            <form
                                                                                action="/player/shop/<%= character.id %>/buy/<%= item.id %>"
                                                                                method="POST" style="margin: 0;">
                                                                                <button type="submit"
                                                                                    class="btn btn-buy"
                                                                                    onclick="return confirm('Deseja comprar <%= item.name %> por <%= item.price %> moedas?')">
                                                                                    🛒 Comprar
                                                                                </button>
                                                                            </form>
                                                                            <% } %>
                                                </div>
                                                <% }); %>
                                        </div>
                                        <% } %>

                                            <div class="back-link">
                                                <a href="/player/dashboard">← Voltar ao Dashboard</a>
                                            </div>
</div>

<script>
    function applyFilters() {
        const type = document.getElementById('typeFilter').value;
        const sort = document.getElementById('sortFilter').value;
        const characterId = '<%= character.id %>';

        let url = `/player/shop/${characterId}?`;
        if (type) url += `type=${type}&`;
        if (sort) url += `sort=${sort}`;

        window.location.href = url;
    }
</script>

