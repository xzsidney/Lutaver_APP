<div class="player-dashboard">
    <div class="account-layout">

        <!-- Título da página -->
        <header class="account-header">
            <h1 class="account-title">Minha Conta</h1>
        </header>

        <!-- CARD DA CONTA -->
        <section class="account-card">
            <div class="account-avatar">
                <!-- Se tiver avatar real, coloca a imagem aqui -->
                <div class="account-avatar-circle">
                    <span>
                        <%= user.name ? user.name.charAt(0).toUpperCase() : 'J' %>
                    </span>
                </div>
            </div>

            <div class="account-info">
                <h2 class="account-name">
                    <%= user.name %>
                </h2>
                <p class="account-email">
                    <%= user.email %>
                </p>

                <a href="/player/account/edit" class="btn-account-edit">
                    Editar Conta
                </a>
            </div>
        </section>

        <!-- SESSÃO: MEUS PERSONAGENS -->
        <section class="characters-section-new">
            <div class="characters-header-new">
                <div class="characters-ribbon">Meus Personagens</div>
            </div>

            <% if (!characters || characters.length===0) { %>
                <div class="characters-empty">
                    <p>Você ainda não criou nenhum personagem.</p>
                    <a href="/player/characters/new" class="btn-create-character-main">
                        ➕ Criar Primeiro Personagem
                    </a>
                </div>
                <% } else { %>
                    <div class="characters-row">
                        <% characters.forEach(function(character) { %>
                            <article class="character-card-new">
                                <div class="character-avatar-wrapper">
                                    <div class="character-avatar-circle-new">
                                        <img src="/img/player/<%= character.id %>.jpg"
                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                            class="character-img-new">
                                        <span class="character-avatar-fallback">🧙</span>
                                    </div>
                                </div>

                                <h3 class="character-name-new">
                                    <%= character.name %>
                                </h3>
                                <p class="character-meta-new">
                                    Nível <%= character.level || 1 %> •
                                        <%= character.school_year %>ª Série
                                </p>

                                <a href="/player/characters/<%= character.id %>" class="btn-character-details">
                                    Ver Personagem
                                </a>
                            </article>
                            <% }) %>

                                <!-- Card extra para criar novo -->
                                <article class="character-card-new character-card-add">
                                    <div class="character-avatar-wrapper">
                                        <div class="character-avatar-circle-new add-circle">
                                            <span class="character-avatar-fallback">➕</span>
                                        </div>
                                    </div>
                                    <h3 class="character-name-new">Novo</h3>
                                    <p class="character-meta-new">Criar personagem</p>
                                    <a href="/player/characters/new" class="btn-character-details">
                                        Criar Personagem
                                    </a>
                                </article>
                    </div>

                    <div class="characters-bottom">
                        <a href="/player/characters/new" class="btn-create-character-main">
                            Criar Personagem
                        </a>
                    </div>
                    <% } %>

        </section>
    </div>
</div>