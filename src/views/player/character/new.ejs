<div class="player-home-container">
    <div class="section-header">
        <h1 class="home-title">Criar Novo Personagem</h1>
        <p class="home-subtitle">Personalize seu herói e prepare-se para a aventura!</p>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="alert alert-danger">
            <%= error %>
        </div>
        <% } %>

            <form action="/player/characters" method="POST" enctype="multipart/form-data" class="edit-container"
                id="createCharacterForm">
                <!-- Left Column: Basic Info -->
                <div class="form-card">
                    <h2 class="form-title">📝 Dados Básicos</h2>

                    <div class="form-group">
                        <label for="name">Nome do Personagem</label>
                        <input type="text" id="name" name="name" required placeholder="Ex: Guerreiro da Luz"
                            class="form-control">
                    </div>

                    <div class="form-group">
                        <label for="school_year">Ano Escolar</label>
                        <input type="text" class="form-control" value="1º Ano" disabled
                            style="background-color: #f8f9fa;">
                        <input type="hidden" name="school_year" value="1">
                        <small style="color: #666;">Todos os novos personagens iniciam no 1º Ano.</small>
                    </div>

                    <div class="form-group">
                        <label for="avatar">Avatar (Opcional)</label>
                        <input type="file" id="avatar" name="avatar" accept="image/*" class="form-control">
                        <small style="color: #666; font-size: 0.85rem;">Escolha uma imagem para representar seu
                            personagem</small>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" id="submit-btn" disabled>Criar Personagem</button>
                        <a href="/player/dashboard" class="btn btn-secondary">Cancelar</a>
                    </div>
                </div>

                <!-- Right Column: Attribute Allocation -->
                <div class="form-card">
                    <h2 class="form-title">⚔️ Distribuir Atributos</h2>
                    <p style="color: #666; margin-bottom: 15px; font-size: 0.9rem;">
                        Você tem <strong>10 pontos</strong> para distribuir. Ajuste os valores conforme desejar.
                    </p>

                    <div class="evolution-points-display">
                        <span class="points-label">Pontos Disponíveis:</span>
                        <span class="points-value" id="remaining-points">10</span>
                    </div>

                    <div class="alert alert-info" id="points-alert">
                        💡 Distribua todos os pontos para habilitar a criação.
                    </div>

                    <div class="attributes-compact">
                        <!-- Força -->
                        <div class="attr-row">
                            <span class="attr-icon">💪</span>
                            <span class="attr-label">Força</span>
                            <button type="button" class="btn-allocate-small minus"
                                onclick="updateAttribute('strength', -1)">-</button>
                            <span class="attr-current" id="val-strength">1</span>
                            <button type="button" class="btn-allocate-small plus"
                                onclick="updateAttribute('strength', 1)">+</button>
                            <input type="hidden" name="strength" id="input-strength" value="1">
                        </div>

                        <!-- Destreza -->
                        <div class="attr-row">
                            <span class="attr-icon">🎯</span>
                            <span class="attr-label">Destreza</span>
                            <button type="button" class="btn-allocate-small minus"
                                onclick="updateAttribute('dexterity', -1)">-</button>
                            <span class="attr-current" id="val-dexterity">1</span>
                            <button type="button" class="btn-allocate-small plus"
                                onclick="updateAttribute('dexterity', 1)">+</button>
                            <input type="hidden" name="dexterity" id="input-dexterity" value="1">
                        </div>

                        <!-- Constituição -->
                        <div class="attr-row">
                            <span class="attr-icon">🛡️</span>
                            <span class="attr-label">Constituição</span>
                            <button type="button" class="btn-allocate-small minus"
                                onclick="updateAttribute('constitution', -1)">-</button>
                            <span class="attr-current" id="val-constitution">1</span>
                            <button type="button" class="btn-allocate-small plus"
                                onclick="updateAttribute('constitution', 1)">+</button>
                            <input type="hidden" name="constitution" id="input-constitution" value="1">
                        </div>

                        <!-- Inteligência -->
                        <div class="attr-row">
                            <span class="attr-icon">🧠</span>
                            <span class="attr-label">Inteligência</span>
                            <button type="button" class="btn-allocate-small minus"
                                onclick="updateAttribute('intelligence', -1)">-</button>
                            <span class="attr-current" id="val-intelligence">1</span>
                            <button type="button" class="btn-allocate-small plus"
                                onclick="updateAttribute('intelligence', 1)">+</button>
                            <input type="hidden" name="intelligence" id="input-intelligence" value="1">
                        </div>

                        <!-- Raciocínio -->
                        <div class="attr-row">
                            <span class="attr-icon">🤔</span>
                            <span class="attr-label">Raciocínio</span>
                            <button type="button" class="btn-allocate-small minus"
                                onclick="updateAttribute('reasoning', -1)">-</button>
                            <span class="attr-current" id="val-reasoning">1</span>
                            <button type="button" class="btn-allocate-small plus"
                                onclick="updateAttribute('reasoning', 1)">+</button>
                            <input type="hidden" name="reasoning" id="input-reasoning" value="1">
                        </div>

                        <!-- Sorte -->
                        <div class="attr-row">
                            <span class="attr-icon">🍀</span>
                            <span class="attr-label">Sorte</span>
                            <button type="button" class="btn-allocate-small minus"
                                onclick="updateAttribute('luck', -1)">-</button>
                            <span class="attr-current" id="val-luck">1</span>
                            <button type="button" class="btn-allocate-small plus"
                                onclick="updateAttribute('luck', 1)">+</button>
                            <input type="hidden" name="luck" id="input-luck" value="1">
                        </div>
                    </div>
                </div>
            </form>
</div>

<script>
    let remainingPoints = 10;

    function updateAttribute(attr, change) {
        const input = document.getElementById(`input-${attr}`);
        const display = document.getElementById(`val-${attr}`);
        let currentValue = parseInt(input.value);

        // Regras de validação
        if (change > 0) {
            // Adicionando ponto
            if (remainingPoints <= 0) return; // Sem pontos
            remainingPoints--;
            currentValue++;
        } else {
            // Removendo ponto
            if (currentValue <= 1) return; // Mínimo é 1
            remainingPoints++;
            currentValue--;
        }

        // Atualizar UI
        input.value = currentValue;
        display.textContent = currentValue;
        document.getElementById('remaining-points').textContent = remainingPoints;

        validateSubmit();
    }

    function validateSubmit() {
        const btn = document.getElementById('submit-btn');
        const alertBox = document.getElementById('points-alert');

        if (remainingPoints === 0) {
            btn.disabled = false;
            btn.innerHTML = '✨ Criar Personagem';

            alertBox.classList.remove('alert-info', 'alert-warning');
            alertBox.classList.add('alert-success');
            alertBox.innerHTML = '<strong>✅ Tudo pronto!</strong> Pode criar seu personagem.';
        } else {
            btn.disabled = true;
            btn.innerHTML = `Distribua os pontos (${remainingPoints})`;

            alertBox.classList.remove('alert-success');
            alertBox.classList.add('alert-info');
            alertBox.innerHTML = `💡 Você ainda tem <strong>${remainingPoints}</strong> pontos para distribuir.`;
        }
    }

    // Inicialização
    validateSubmit();
</script>

<style>
    .edit-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        max-width: 1000px;
        margin: 0 auto 30px;
    }

    .form-card {
        background: #ffffff;
        border-radius: 18px;
        border: 2px solid #e2ecff;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(15, 49, 96, 0.06);
    }

    .form-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #123055;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f0f4f8;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 0.9rem;
    }

    .alert-danger {
        background: #ffe6e6;
        color: #c92a2a;
        border: 1px solid #ffc9c9;
    }

    .alert-info {
        background: #e7f2ff;
        color: #0a2a4f;
        border: 2px solid #1E90FF;
    }

    .alert-success {
        background: #d3f9d8;
        color: #2b8a3e;
        border: 2px solid #00C853;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        color: #123055;
        margin-bottom: 8px;
        font-size: 1rem;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #e2ecff;
        border-radius: 8px;
        font-size: 1rem;
        transition: 0.2s ease-in-out;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: #1E90FF;
        box-shadow: 0 0 0 3px rgba(30, 144, 255, 0.1);
    }

    .evolution-points-display {
        background: linear-gradient(135deg, #fff9e6, #fffbf0);
        border: 2px solid #F7D046;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .points-label {
        font-weight: 600;
        color: #123055;
        font-size: 1rem;
    }

    .points-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #123055;
    }

    .attributes-compact {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .attr-row {
        display: grid;
        grid-template-columns: 35px 1fr 35px 40px 35px;
        /* Icon Label - Val + */
        align-items: center;
        gap: 8px;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 10px;
        transition: 0.2s ease-in-out;
    }

    .attr-row:hover {
        background: #e7f2ff;
    }

    .attr-icon {
        font-size: 1.3rem;
        text-align: center;
    }

    .attr-label {
        font-weight: 600;
        color: #123055;
    }

    .attr-current {
        font-weight: 700;
        color: #1E90FF;
        text-align: center;
        font-size: 1.1rem;
    }

    .btn-allocate-small {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        font-size: 1.2rem;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease-in-out;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
    }

    .btn-allocate-small.plus {
        background: #1E90FF;
        color: #ffffff;
    }

    .btn-allocate-small.plus:hover {
        background: #0f6fd1;
        transform: scale(1.1);
    }

    .btn-allocate-small.minus {
        background: #e9ecef;
        color: #495057;
    }

    .btn-allocate-small.minus:hover {
        background: #dee2e6;
        transform: scale(1.1);
    }

    .btn-allocate-small:active {
        transform: scale(0.95);
    }

    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-start;
        margin-top: 25px;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease-in-out;
        border: none;
        cursor: pointer;
        font-size: 1rem;
    }

    .btn-primary {
        background: #1E90FF;
        color: #ffffff;
    }

    .btn-primary:hover {
        background: #0f6fd1;
    }

    .btn-primary:disabled {
        background: #a0cfee;
        cursor: not-allowed;
    }

    .btn-secondary {
        background: #6c757d;
        color: #ffffff;
    }

    .btn-secondary:hover {
        background: #5a6268;
    }

    @media (max-width: 768px) {
        .edit-container {
            grid-template-columns: 1fr;
        }
    }
</style>