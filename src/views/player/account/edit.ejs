<div class="player-home-container">
    <div class="section-header">
        <h1 class="home-title">Editar Conta</h1>
        <p class="home-subtitle">Atualize suas informações pessoais</p>
    </div>

    <% if (error) { %>
        <div class="alert alert-danger">
            ⚠️ <%= error %>
        </div>
        <% } %>

            <% if (success) { %>
                <div class="alert alert-success">
                    ✅ <%= success %>
                </div>
                <% } %>

                    <div class="edit-container">
                        <!-- Update Profile Form -->
                        <div class="form-card">
                            <h2 class="form-title">Informações Pessoais</h2>
                            <form action="/player/account/update" method="POST">
                                <div class="form-group">
                                    <label for="name">Nome:</label>
                                    <input type="text" id="name" name="name" value="<%= user.name %>" required>
                                </div>

                                <div class="form-group">
                                    <label for="email">Email:</label>
                                    <input type="email" id="email" name="email" value="<%= user.email %>" required>
                                </div>

                                <button type="submit" class="btn btn-primary">💾 Salvar Alterações</button>
                            </form>
                        </div>

                        <!-- Change Password Form -->
                        <div class="form-card">
                            <h2 class="form-title">Alterar Senha</h2>
                            <form action="/player/account/change-password" method="POST">
                                <div class="form-group">
                                    <label for="currentPassword">Senha Atual:</label>
                                    <input type="password" id="currentPassword" name="currentPassword" required>
                                </div>

                                <div class="form-group">
                                    <label for="newPassword">Nova Senha:</label>
                                    <input type="password" id="newPassword" name="newPassword" required minlength="6">
                                </div>

                                <div class="form-group">
                                    <label for="confirmPassword">Confirmar Nova Senha:</label>
                                    <input type="password" id="confirmPassword" name="confirmPassword" required
                                        minlength="6">
                                </div>

                                <button type="submit" class="btn btn-warning">🔒 Alterar Senha</button>
                            </form>
                        </div>
                    </div>

                    <div class="back-link">
                        <a href="/player/dashboard">← Voltar ao Dashboard</a>
                    </div>
</div>

<style>
    .alert {
        padding: 15px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
        font-weight: 500;
    }

    .alert-danger {
        background: #ffe6e6;
        color: #c92a2a;
        border: 1px solid #ffc9c9;
    }

    .alert-success {
        background: #d3f9d8;
        color: #2b8a3e;
        border: 1px solid #8ce99a;
    }

    .edit-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        max-width: 900px;
        margin: 0 auto 30px;
    }

    .form-card {
        background: #ffffff;
        border-radius: 18px;
        border: 2px solid #e2ecff;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(15, 49, 96, 0.06);
    }

    .form-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #123055;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f0f4f8;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        color: #123055;
        margin-bottom: 6px;
    }

    .form-group input {
        width: 100%;
        padding: 10px 14px;
        border: 2px solid #e2ecff;
        border-radius: 8px;
        font-size: 1rem;
        transition: 0.2s ease-in-out;
    }

    .form-group input:focus {
        outline: none;
        border-color: #1E90FF;
        box-shadow: 0 0 0 3px rgba(30, 144, 255, 0.1);
    }

    .btn {
        padding: 12px 24px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease-in-out;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        width: 100%;
    }

    .btn-primary {
        background: #1E90FF;
        color: #ffffff;
    }

    .btn-primary:hover {
        background: #0f6fd1;
    }

    .btn-warning {
        background: #F7D046;
        color: #123055;
    }

    .btn-warning:hover {
        background: #f5c518;
    }

    .back-link {
        text-align: center;
        margin-top: 20px;
    }

    .back-link a {
        color: #1E90FF;
        text-decoration: none;
        font-weight: 600;
    }

    .back-link a:hover {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .edit-container {
            grid-template-columns: 1fr;
        }
    }
</style>