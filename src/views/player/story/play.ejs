<%- include('../../partials/player/header') %>

    <main class="game-screen story-mode">
        <div class="player-home-container story-container">

            <!-- ================================= -->
            <!--  BANNER PRINCIPAL DA AVENTURA     -->
            <!-- ================================= -->
            <header class="story-banner" style="background-image: url('/img/bandeira2.png');
                    background-size: cover;
                    background-position: center;">

                <h1 class="story-banner-title">
                    <%= story?.title || "Continue sua jornada narrativa" %>
                </h1>
                <p class="story-banner-subtitle"></p>
            </header>


            <!-- ================================= -->
            <!--  GRID PRINCIPAL: CENA + LATERAL   -->
            <!-- ================================= -->
            <div class="story-grid">

                <!-- =========================== -->
                <!--      COLUNA ESQUERDA        -->
                <!-- =========================== -->
                <section class="story-column-left">

                    <!-- CENA / HISTÓRIA -->
                    <article class="scene-card">

                        <!-- Imagem de fundo opcional da cena -->
                        <% if (scene && scene.background_image) { %>
                            <div class="scene-image">
                                <img src="/img/story/scene/<%= scene.background_image %>" alt="<%= scene.title %>">
                            </div>
                            <% } %>

                                <!-- Cabeçalho da cena -->
                                <div class="scene-header">
                                    <div class="scene-header-left">
                                        <span class="scene-icon">▌▌</span>
                                        <h2 class="scene-title">
                                            <%= scene?.title || "Cena" %>
                                        </h2>
                                    </div>
                                </div>

                                <!-- Texto principal da cena -->
                                <p class="scene-text">
                                    <%= scene?.text || "Carregando cena..." %>
                                </p>

                                <!-- Dica para o jogador -->
                                <% if (scene?.hint_text) { %>
                                    <div class="hint-box">
                                        <div class="hint-icon">⚠️</div>
                                        <div class="hint-content">
                                            <strong>Dica:</strong>
                                            <%= scene.hint_text %>
                                        </div>
                                    </div>
                                    <% } %>

                                        <!-- BLOCO DE NPC -->
                                        <% if (npc) { %>
                                            <div class="npc-dialog">
                                                <div class="npc-avatar">
                                                    <% if (npc.avatar) { %>
                                                        <img src="<%= npc.avatar %>" alt="<%= npc.name %>"
                                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                        <div class="npc-avatar-placeholder" style="display:none;">👤
                                                        </div>
                                                        <% } else { %>
                                                            <div class="npc-avatar-placeholder">👤</div>
                                                            <% } %>
                                                </div>
                                                <div class="npc-text">
                                                    <h4>
                                                        <%= npc.name %> <small>(<%= npc.type %>)</small>
                                                    </h4>
                                                    <p>
                                                        "<%= npc.dialogue_greeting || 'Olá, aventureiro!' %>"
                                                    </p>
                                                </div>
                                            </div>
                                            <% } %>

                                                <!-- BLOCO DE QUIZ (SE HOUVER) -->
                                                <% if (typeof question !=='undefined' && question) { %>
                                                    <div class="quiz-block">
                                                        <h4>❓ Pergunta</h4>
                                                        <p>
                                                            <%= question.question_text %>
                                                        </p>

                                                        <div class="quiz-options">
                                                            <button class="btn-quiz-option">
                                                                <%= question.option_a %>
                                                            </button>
                                                            <button class="btn-quiz-option">
                                                                <%= question.option_b %>
                                                            </button>
                                                            <button class="btn-quiz-option">
                                                                <%= question.option_c %>
                                                            </button>
                                                            <button class="btn-quiz-option">
                                                                <%= question.option_d %>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <% } %>

                    </article>

                    <!-- RESULTADO DE TESTE (SUCESSO / FALHA) -->
                    <% if (typeof testResult !=='undefined' && testResult) { %>
                        <div class="test-result-card <%= testResult.success ? 'success' : 'fail' %>">
                            <% if (testResult.success) { %>
                                <h3>🎉 Sucesso no Teste!</h3>
                                <% } else { %>
                                    <h3>❌ Falha no Teste</h3>
                                    <% } %>
                                        <p>
                                            <%= testResult.message %>
                                        </p>
                        </div>
                        <% } %>

                            <!-- AÇÕES / ESCOLHAS -->
                            <section class="choices-card">
                                <h3 class="choices-title">⚡ Suas Ações</h3>

                                <% if (choices && choices.length> 0) { %>
                                    <% choices.forEach(choice=> { %>
                                        <form method="POST"
                                            action="/player/stories/<%= story.id %>/choice/<%= choice.id %>"
                                            class="choice-form">
                                            <button type="submit" class="btn-choice">
                                                <span class="choice-label">
                                                    <%= choice.label %>
                                                </span>
                                                <% if (choice.requires_test) { %>
                                                    <span class="choice-test">
                                                        🎲 Teste: <%= choice.test_attribute %>
                                                            (Dif: <%= choice.test_difficulty %>)
                                                    </span>
                                                    <% } %>
                                            </button>
                                        </form>
                                        <% }) %>
                                            <% } else if (scene && scene.is_ending) { %>
                                                <div class="ending-message">
                                                    <p>🎊 Esta história chegou ao fim!</p>
                                                    <a href="/player/stories/<%= story.id %>/finish" class="btn-finish">
                                                        ✨ Ver Recompensas
                                                    </a>
                                                </div>
                                                <% } else { %>
                                                    <p class="no-choices">Nenhuma escolha disponível nesta cena.</p>
                                                    <% } %>
                            </section>

                            <!-- BOTÃO VOLTAR -->
                            <div class="back-section">
                                <a href="/player/stories" class="btn-back">⬅️ Voltar às Histórias</a>
                            </div>

                </section>

                <!-- =========================== -->
                <!--      COLUNA DIREITA         -->
                <!-- =========================== -->
                <aside class="story-column-right">

                    <!-- PAINEL DO PERSONAGEM -->
                    <div class="character-panel">
                        <div class="character-panel-header">
                            <h3>Personagem</h3>
                        </div>

                        <div class="character-status-bars">
                            <div class="status-row">
                                <span class="status-label">💚 Vida</span>

                                <div class="status-bar">
                                    <div class="status-bar-fill status-life"
                                        style="width:<%= character && character.max_life ? (character.life / character.max_life) * 100 : 0 %>%;">
                                    </div>
                                </div>

                                <span class="status-value">
                                    <%= character?.life %> / <%= character?.max_life %>
                                </span>
                            </div>
                        </div>

                        <div class="character-main">

                            <div class="character-avatar">
                                <div class="character-avatar-circle">

                                    <img src="/img/character/<%= character?.id %>.png" alt="Avatar do personagem"
                                        class="character-avatar-img" onerror="this.src='/img/character/default.png';">

                                </div>
                            </div>

                            <div class="character-info-block">
                                <h4 class="character-name">
                                    <%= character?.id || "Desconhecido" %>
                                </h4>

                                <p class="character-meta">
                                    Nível: <span>
                                        <%= character?.level || 1 %>
                                    </span><br>
                                    Série: <span>
                                        <%= character?.school_year %>º ano
                                    </span>
                                </p>
                            </div>

                        </div>


                        <div class="character-attributes">
                            <div class="attr-row">
                                <span>💪 FOR:</span> <strong>
                                    <%= character?.strength || 1 %>
                                </strong>
                                <span>🎯 DES:</span> <strong>
                                    <%= character?.dexterity || 1 %>
                                </strong>
                            </div>
                            <div class="attr-row">
                                <span>❤️ CON:</span> <strong>
                                    <%= character?.constitution || 1 %>
                                </strong>
                                <span>🧠 INT:</span> <strong>
                                    <%= character?.intelligence || 1 %>
                                </strong>
                            </div>
                            <div class="attr-row">
                                <span>🔍 RAC:</span> <strong>
                                    <%= character?.reasoning || 1 %>
                                </strong>
                                <span>🍀 SOR:</span> <strong>
                                    <%= character?.luck || 1 %>
                                </strong>
                            </div>
                        </div>
                    </div>

                    <!-- TEMPO RESTANTE (ABAIXO DO PERSONAGEM) -->
                    <% if (typeof timeRemaining !=='undefined' && timeRemaining) { %>
                        <div class="timer-panel <%= timeStatus %>">
                            <div class="timer-top">
                                <span class="timer-icon">⏳</span>
                                <span class="timer-title">Tempo Restante</span>
                            </div>
                            <div class="timer-value-row">
                                <span class="timer-value">
                                    <%= timeRemaining %>
                                </span>
                            </div>
                        </div>
                        <% } %>

                </aside>

            </div><!-- story-grid -->

        </div><!-- story-container -->
    </main>
    <style>
        /* ============================================================
   STORY MODE - LAYOUT ESTILO TELA ESCURA RPG
   ============================================================ */

        .game-screen.story-mode {
            background: radial-gradient(circle at top, #101b3b 0%, #050915 45%, #020812 100%);
            min-height: 100vh;
            color: #f5f7ff;
        }

        .story-container {
            max-width: 1180px;
            margin: 0 auto;
            padding: 40px 24px 60px;
        }

        /* =================== BANNER SUPERIOR =================== */

        .story-banner {
            background: #6722b7;
            background: linear-gradient(135deg, #7a2ed0 0%, #5b1c9f 100%);
            border-radius: 18px;
            padding: 22px 40px;
            text-align: center;
            color: #ffffff;
            margin-bottom: 26px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
        }

        .story-banner-title {
            font-size: 2.1rem;
            font-weight: 800;
            margin: 0 0 6px;
        }

        .story-banner-subtitle {
            margin: 0;
            font-size: 1rem;
            opacity: .9;
        }

        /* =================== GRID PRINCIPAL =================== */

        .story-grid {
            display: grid;
            grid-template-columns: minmax(0, 2.1fr) minmax(280px, 1.1fr);
            gap: 22px;
        }

        /* =================== COLUNA ESQUERDA =================== */

        .scene-card {
            background: rgba(5, 13, 30, 0.95);
            border-radius: 18px;
            padding: 0;
            border: 1px solid rgba(120, 144, 255, 0.25);
            box-shadow: 0 16px 32px rgba(0, 0, 0, 0.5);
            overflow: hidden;
        }

        /* imagem do cenário */
        .scene-image img {
            display: block;
            width: 100%;
            max-height: 260px;
            object-fit: cover;
        }

        /* cabeçalho da cena */
        .scene-header {
            padding: 18px 26px 4px;
        }

        .scene-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .scene-icon {
            font-size: 1.3rem;
            color: #40c4ff;
        }

        .scene-title {
            font-size: 1.35rem;
            margin: 0;
            color: #ffffff;
            font-weight: 700;
        }

        /* texto da cena */
        .scene-text {
            padding: 0 26px 18px;
            font-size: 1rem;
            line-height: 1.8;
            color: #dde5ff;
        }

        /* dica */
        .hint-box {
            margin: 0 22px 18px;
            padding: 12px 14px;
            background: rgba(255, 213, 79, 0.1);
            border-radius: 10px;
            border: 1px solid rgba(255, 214, 79, 0.6);
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .hint-icon {
            font-size: 1.4rem;
        }

        .hint-content {
            font-size: .9rem;
            color: #ffe082;
        }

        /* NPC */
        .npc-dialog {
            margin: 0 22px 22px;
            padding: 14px 14px;
            border-radius: 12px;
            background: radial-gradient(circle at top left, rgba(255, 160, 0, 0.15), rgba(2, 8, 25, 0.95));
            display: flex;
            gap: 14px;
            align-items: center;
            border: 1px solid rgba(255, 171, 64, 0.4);
        }

        .npc-avatar img,
        .npc-avatar-placeholder {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            object-fit: cover;
            background: linear-gradient(135deg, #ffb74d, #f57c00);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
        }

        .npc-text h4 {
            margin: 0 0 4px;
            color: #ffe0b2;
            font-size: 1rem;
        }

        .npc-text h4 small {
            color: #b0bec5;
        }

        .npc-text p {
            margin: 0;
            font-size: 0.9rem;
            color: #eceff1;
            font-style: italic;
        }

        /* QUIZ */
        .quiz-block {
            margin: 0 22px 22px;
            padding: 16px 16px 18px;
            border-radius: 12px;
            background: rgba(26, 35, 126, 0.9);
            border: 1px solid rgba(159, 168, 218, 0.4);
        }

        .quiz-block h4 {
            margin: 0 0 10px;
            color: #e8eaf6;
            font-size: 1rem;
        }

        .quiz-block p {
            margin: 0 0 12px;
            color: #c5cae9;
            font-size: 0.95rem;
        }

        .quiz-options {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .btn-quiz-option {
            border-radius: 8px;
            border: 1px solid rgba(187, 222, 251, 0.6);
            background: rgba(13, 71, 161, 0.9);
            color: #e3f2fd;
            padding: 10px 12px;
            text-align: left;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.18s;
        }

        .btn-quiz-option:hover {
            background: #42a5f5;
            border-color: #90caf9;
            transform: translateX(4px);
        }

        /* resultado de teste (embaixo da cena) */
        .test-result-card {
            margin-top: 16px;
            padding: 14px 18px;
            border-radius: 14px;
            text-align: left;
            font-size: 0.95rem;
        }

        .test-result-card h3 {
            margin: 0 0 6px;
            font-size: 1.1rem;
        }

        .test-result-card.success {
            background: rgba(46, 125, 50, 0.2);
            border-left: 4px solid #66bb6a;
            color: #c8e6c9;
        }

        .test-result-card.fail {
            background: rgba(183, 28, 28, 0.25);
            border-left: 4px solid #e57373;
            color: #ffcdd2;
        }

        /* =================== AÇÕES / ESCOLHAS =================== */

        .choices-card {
            margin-top: 18px;
            background: rgba(5, 13, 30, 0.96);
            border-radius: 18px;
            padding: 18px 22px 20px;
            border: 1px solid rgba(120, 144, 255, 0.25);
            box-shadow: 0 12px 26px rgba(0, 0, 0, 0.55);
        }

        .choices-title {
            margin: 0 0 12px;
            font-size: 1.1rem;
            color: #ffca28;
        }

        .choice-form {
            margin-bottom: 10px;
        }

        .btn-choice {
            width: 100%;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #1565c0 0%, #0d47a1 100%);
            color: #e3f2fd;
            padding: 12px 14px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            box-shadow: 0 4px 12px rgba(21, 101, 192, 0.6);
            transition: all 0.18s;
        }

        .btn-choice:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(21, 101, 192, 0.75);
        }

        .choice-test {
            font-size: 0.8rem;
            padding: 2px 8px;
            border-radius: 999px;
            background: rgba(13, 71, 161, 0.7);
        }

        /* fim / sem escolhas */
        .ending-message {
            text-align: center;
            padding: 16px 8px;
        }

        .ending-message p {
            margin: 0 0 10px;
            color: #80cbc4;
            font-size: 1rem;
        }

        .btn-finish {
            display: inline-block;
            padding: 10px 22px;
            border-radius: 999px;
            text-decoration: none;
            background: linear-gradient(135deg, #43a047, #1b5e20);
            color: #e8f5e9;
            font-weight: 700;
            box-shadow: 0 6px 18px rgba(56, 142, 60, 0.6);
        }

        .no-choices {
            text-align: center;
            font-size: 0.9rem;
            color: #90a4ae;
        }

        /* botão voltar */
        .back-section {
            text-align: center;
            margin-top: 16px;
        }

        .btn-back {
            display: inline-block;
            padding: 10px 22px;
            border-radius: 999px;
            background: rgba(69, 90, 100, 0.9);
            color: #eceff1;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.15s;
        }

        .btn-back:hover {
            background: rgba(84, 110, 122, 1);
            transform: translateY(-1px);
        }

        /* =================== COLUNA DIREITA =================== */

        .story-column-right {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* painel personagem */
        .character-panel {
            background: rgba(5, 13, 30, 0.97);
            border-radius: 18px;
            padding: 18px 18px 16px;
            border: 1px solid rgba(120, 144, 255, 0.25);
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.6);
        }

        .character-panel-header h3 {
            margin: 0 0 10px;
            color: #ffca28;
            font-size: 1.05rem;
        }

        .character-status-bars {
            margin-bottom: 14px;
        }

        .status-row {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }

        .status-label {
            font-size: 0.82rem;
            color: #c5cae9;
        }

        .status-bar {
            width: 100%;
            height: 6px;
            border-radius: 999px;
            background: rgba(30, 43, 80, 0.9);
            overflow: hidden;
        }

        .status-bar-fill {
            height: 100%;
            border-radius: 999px;
        }

        .status-life {
            background: #00e676;
        }

        .status-energy {
            background: #ffca28;
        }

        .status-focus {
            background: #42a5f5;
        }

        .status-value {
            font-size: 0.8rem;
            color: #e3f2fd;
        }

        /* bloco com avatar + info básica */
        .character-main {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

        .character-avatar-circle {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 20%, #ffcc80 0%, #fb8c00 60%, #e65100 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.4rem;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.6);
        }

        .character-name {
            margin: 0 0 4px;
            font-size: 1.1rem;
            color: #ffffff;
        }

        .character-meta {
            margin: 0;
            font-size: 0.85rem;
            color: #cfd8dc;
        }

        .character-meta span {
            font-weight: 600;
            color: #ffeb3b;
        }

        /* atributos */
        .character-attributes {
            border-top: 1px solid rgba(55, 71, 79, 0.9);
            padding-top: 8px;
            margin-top: 4px;
        }

        .attr-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.82rem;
            color: #cfd8dc;
            margin-bottom: 4px;
        }

        .attr-row span:first-child {
            color: #90caf9;
        }

        /* painel de tempo */
        .timer-panel {
            background: rgba(5, 13, 30, 0.97);
            border-radius: 18px;
            padding: 14px 16px;
            border: 1px solid rgba(255, 214, 79, 0.6);
            box-shadow: 0 12px 26px rgba(0, 0, 0, 0.6);
        }

        .timer-top {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .timer-icon {
            font-size: 1.4rem;
        }

        .timer-title {
            font-size: 0.95rem;
            color: #ffeb3b;
            font-weight: 600;
        }

        .timer-value-row {
            margin-top: 4px;
        }

        .timer-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: #ffffff;
        }

        /* Se quiser manter as variações de estado */
        .timer-panel.Warning .timer-title {
            color: #ffb300;
        }

        .timer-panel.Critical .timer-title {
            color: #ff5252;
        }

        /* =================== RESPONSIVO =================== */

        @media (max-width: 900px) {
            .story-grid {
                grid-template-columns: 1fr;
            }

            .story-column-right {
                order: -1;
            }

            .story-banner-title {
                font-size: 1.7rem;
            }
        }
    </style>

    <!-- Test Result Modal -->
    <% if (typeof testResult !=='undefined' && testResult) { %>
        <div class="test-modal-overlay" id="testModal">
            <div class="test-modal-container">

                <!-- Dice Animation -->
                <div class="test-dice-animation">
                    <div class="test-dice" id="testDice">🎲</div>
                </div>

                <!-- Test Info (Hidden initially) -->
                <div class="test-modal-info" id="testModalInfo" style="display: none;">

                    <!-- Warning Icon -->
                    <div class="test-icon-warning">⚠️</div>

                    <!-- Title -->
                    <h2 class="test-modal-title">Teste de <%= testResult.attributeNamePT %>
                    </h2>

                    <!-- Results Grid -->
                    <div class="test-results-grid">
                        <div class="test-result-item">
                            <span class="test-label">Dado (1d10):</span>
                            <span class="test-value dice-roll">🎲 <%= testResult.roll %></span>
                        </div>
                        <div class="test-result-item">
                            <span class="test-label">
                                <%= testResult.attributeNamePT %>:
                            </span>
                            <span class="test-value">+ <%= testResult.attributeValue %></span>
                        </div>
                        <div class="test-result-divider"></div>
                        <div class="test-result-item total">
                            <span class="test-label">Total:</span>
                            <span class="test-value">
                                <%= testResult.total %>
                            </span>
                        </div>
                        <div class="test-result-item">
                            <span class="test-label">Dificuldade:</span>
                            <span class="test-value">
                                <%= testResult.difficulty %>
                            </span>
                        </div>
                    </div>

                    <!-- Final Result Box -->
                    <div class="test-final-result <%= testResult.success ? 'success' : 'failure' %>">
                        <div class="test-result-icon">
                            <%= testResult.success ? '✅' : '❌' %>
                        </div>
                        <p class="test-result-text">
                            <%= testResult.success ? 'SUCESSO!' : 'FALHA!' %>
                        </p>
                        <p class="test-result-desc">
                            <%= testResult.success ? `Você conseguiu! (${testResult.total}>= ${testResult.difficulty})`
                                :
                                `Você não conseguiu. (${testResult.total} < ${testResult.difficulty})` %>
                        </p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="test-modal-actions">
                        <button class="test-btn test-btn-continue" onclick="window.location.reload()">
                            Continuar
                        </button>
                    </div>

                </div>

                <!-- Confetti (only for success) -->
                <% if (testResult.success) { %>
                    <div class="test-confetti-container" id="testConfetti"></div>
                    <% } %>

            </div>
        </div>

        <style>
            /* Test Modal Overlay */
            .test-modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0, 0, 0, 0.85);
                z-index: 99999;
                display: flex;
                align-items: center;
                justify-content: center;
                animation: testFadeIn 0.3s ease;
            }

            @keyframes testFadeIn {
                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }

            /* Modal Container */
            .test-modal-container {
                background: #FFFFFF;
                border-radius: 20px;
                padding: 40px 35px;
                max-width: 480px;
                width: 90%;
                text-align: center;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
                position: relative;
                overflow: hidden;
                animation: testSlideUp 0.4s ease;
            }

            @keyframes testSlideUp {
                from {
                    transform: translateY(50px);
                    opacity: 0;
                }

                to {
                    transform: translateY(0);
                    opacity: 1;
                }
            }

            /* Dice Animation */
            .test-dice-animation {
                margin-bottom: 20px;
            }

            .test-dice {
                font-size: 5rem;
                display: inline-block;
                animation: testRollDice 2s ease-in-out;
            }

            @keyframes testRollDice {

                0%,
                100% {
                    transform: rotate(0deg) scale(1);
                }

                10% {
                    transform: rotate(72deg) scale(1.1);
                }

                20% {
                    transform: rotate(144deg) scale(1);
                }

                30% {
                    transform: rotate(216deg) scale(1.1);
                }

                40% {
                    transform: rotate(288deg) scale(1);
                }

                50% {
                    transform: rotate(360deg) scale(1.1);
                }

                60% {
                    transform: rotate(432deg) scale(1);
                }

                70% {
                    transform: rotate(504deg) scale(1.1);
                }

                80% {
                    transform: rotate(576deg) scale(1);
                }

                90% {
                    transform: rotate(648deg) scale(1.1);
                }
            }

            /* Warning Icon */
            .test-icon-warning {
                font-size: 3.5rem;
                margin-bottom: 10px;
                animation: testPulse 1.5s ease infinite;
            }

            @keyframes testPulse {

                0%,
                100% {
                    transform: scale(1);
                }

                50% {
                    transform: scale(1.1);
                }
            }

            /* Modal Title */
            .test-modal-title {
                font-size: 1.6rem;
                font-weight: 700;
                color: #D32F2F;
                margin: 0 0 20px 0;
            }

            /* Results Grid */
            .test-results-grid {
                background: #F5F5F5;
                border-radius: 12px;
                padding: 15px;
                margin-bottom: 20px;
            }

            .test-result-item {
                display: flex;
                justify-content: space-between;
                padding: 8px 0;
            }

            .test-result-item.total {
                background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
                border-radius: 8px;
                padding: 10px 12px;
                margin: 8px 0;
            }

            .test-label {
                font-weight: 600;
                color: #616161;
                font-size: 0.95rem;
            }

            .test-value {
                font-weight: 700;
                color: #212121;
                font-size: 1rem;
            }

            .test-value.dice-roll {
                color: #1976D2;
                font-size: 1.2rem;
            }

            .test-result-item.total .test-value {
                color: #1976D2;
                font-size: 1.3rem;
            }

            .test-result-divider {
                height: 2px;
                background: linear-gradient(90deg, transparent, #BDBDBD, transparent);
                margin: 8px 0;
            }

            /* Final Result */
            .test-final-result {
                padding: 20px;
                border-radius: 12px;
                margin-bottom: 20px;
                animation: testPopIn 0.5s ease 0.3s backwards;
            }

            @keyframes testPopIn {
                from {
                    transform: scale(0.8);
                    opacity: 0;
                }

                to {
                    transform: scale(1);
                    opacity: 1;
                }
            }

            .test-final-result.success {
                background: linear-gradient(135deg, #C8E6C9, #A5D6A7);
                border: 3px solid #4CAF50;
            }

            .test-final-result.failure {
                background: linear-gradient(135deg, #FFCDD2, #EF9A9A);
                border: 3px solid #F44336;
                animation: testShake 0.5s ease 0.3s backwards;
            }

            @keyframes testShake {

                0%,
                100% {
                    transform: translateX(0);
                }

                10%,
                30%,
                50%,
                70%,
                90% {
                    transform: translateX(-5px);
                }

                20%,
                40%,
                60%,
                80% {
                    transform: translateX(5px);
                }
            }

            .test-result-icon {
                font-size: 3rem;
                margin-bottom: 8px;
                animation: testBounce 0.6s ease 0.5s backwards;
            }

            @keyframes testBounce {

                0%,
                100% {
                    transform: scale(1);
                }

                50% {
                    transform: scale(1.2);
                }
            }

            .test-result-text {
                font-size: 1.6rem;
                font-weight: 800;
                margin: 0 0 5px 0;
            }

            .test-final-result.success .test-result-text {
                color: #2E7D32;
            }

            .test-final-result.failure .test-result-text {
                color: #C62828;
            }

            .test-result-desc {
                font-size: 0.9rem;
                color: #424242;
                margin: 0;
            }

            /* Action Buttons */
            .test-modal-actions {
                display: flex;
                gap: 12px;
                justify-content: center;
            }

            .test-btn {
                flex: 1;
                padding: 14px 24px;
                border-radius: 10px;
                font-weight: 600;
                font-size: 1rem;
                cursor: pointer;
                border: none;
                transition: all 0.2s ease;
                animation: testFadeIn 0.5s ease 0.8s backwards;
            }

            .test-btn-continue {
                background: linear-gradient(135deg, #EF5350, #D32F2F);
                color: #FFFFFF;
                box-shadow: 0 4px 12px rgba(211, 47, 47, 0.3);
            }

            .test-btn-continue:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(211, 47, 47, 0.4);
            }

            /* Confetti */
            .test-confetti-container {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                pointer-events: none;
                overflow: hidden;
            }

            @keyframes testConfetti {
                0% {
                    transform: translateY(-20px) rotate(0deg);
                    opacity: 1;
                }

                100% {
                    transform: translateY(100vh) rotate(720deg);
                    opacity: 0;
                }
            }

            /* Responsive */
            @media (max-width: 480px) {
                .test-modal-container {
                    padding: 30px 20px;
                }

                .test-dice {
                    font-size: 4rem;
                }

                .test-modal-title {
                    font-size: 1.4rem;
                }
            }
        </style>

        <script>
            // Show modal info after dice animation
            setTimeout(() => {
                document.getElementById('testModalInfo').style.display = 'block';

                // Show confetti if success
                const testSuccess = <%= testResult.success ? 'true' : 'false' %>;
                if (testSuccess) {
                    createTestConfetti();
                }
            }, 2000);

            // Create confetti animation
            function createTestConfetti() {
                const container = document.getElementById('testConfetti');
                if (!container) return;

                const colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#FFA07A', '#98D8C8', '#F7DC6F'];

                for (let i = 0; i < 50; i++) {
                    setTimeout(() => {
                        const confetti = document.createElement('div');
                        confetti.style.position = 'absolute';
                        confetti.style.width = '10px';
                        confetti.style.height = '10px';
                        confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                        confetti.style.left = Math.random() * 100 + '%';
                        confetti.style.top = '-20px';
                        confetti.style.borderRadius = '50%';
                        confetti.style.animation = `testConfetti ${2 + Math.random() * 2}s linear forwards`;

                        container.appendChild(confetti);

                        setTimeout(() => confetti.remove(), 4000);
                    }, i * 30);
                }
            }
        </script>
        <% } %>