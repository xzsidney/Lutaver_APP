<!DOCTYPE html>
<% } else { %>
    <div class="cards-grid">
        <% characters.forEach(char=> { %>
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                    <div>
                        <h3 style="color: #1E90FF; margin-bottom: 5px;">
                            <%= char.name %>
                        </h3>
                        <span class="badge" style="background: #F7D046; color: #1A1A1A;">Nível <%= char.level %>
                        </span>
                        <span class="badge" style="background: #34D399;">
                            <%= char.school_year %>º Ano
                        </span>
                    </div>
                    <div style="font-size: 30px;">👤</div>
                </div>

                <div style="margin-bottom: 15px; color: #666; font-size: 14px;">
                    <p><strong>Mapa:</strong>
                        <%= char.current_map %>
                    </p>
                    <p><strong>XP:</strong>
                        <%= char.total_xp %>
                    </p>
                </div>

                <div style="display: flex; gap: 5px;">
                    <a href="/my/characters/<%= char.id %>" class="btn btn-primary btn-sm" style="flex: 1;">📄
                        Ficha</a>
                    <a href="/my/characters/<%= char.id %>/edit" class="btn btn-warning btn-sm">✏️</a>
                    <form action="/my/characters/<%= char.id %>/delete" method="POST" style="display: inline;"
                        onsubmit="return confirm('Excluir personagem?');">
                        <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                    </form>
                </div>
            </div>
            <% }); %>
    </div>
    <% } %>
        </div>
        </body>

        </html>