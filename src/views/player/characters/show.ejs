<%- include('../../partials/header') %>
    <%- include('../../partials/navbar') %>

        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="display-6 fw-bold text-primary">Ficha do Personagem</h1>
                <a href="/my/characters" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>

            <div class="row">
                <!-- Character Info -->
                <div class="col-md-4 mb-4">
                    <div class="card card-custom h-100">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <div
                                    style="width: 120px; height: 120px; background-color: #eee; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">
                                    👤
                                </div>
                            </div>
                            <h3 class="card-title fw-bold text-primary">
                                <%= character.name %>
                            </h3>
                            <p class="text-muted">
                                <%= character.school_year %>º Ano
                            </p>

                            <div class="d-flex justify-content-center gap-2 mb-3">
                                <span class="badge bg-warning text-dark p-2 fs-6">Nível <%= character.level %></span>
                                <span class="badge bg-info text-dark p-2 fs-6">
                                    <%= character.experience %> XP
                                </span>
                            </div>

                            <div class="alert alert-light border">
                                <small class="text-muted d-block mb-1">Pontos de Evolução</small>
                                <strong class="fs-4 text-success">
                                    <%= character.evolution_points %>
                                </strong>
                            </div>

                            <hr>

                            <div class="text-start">
                                <h6 class="fw-bold mb-3">Atributos</h6>
                                <ul class="list-group list-group-flush">
                                    <% const attributes=[ { key: 'strength' , label: 'Força' , icon: '💪' }, {
                                        key: 'dexterity' , label: 'Destreza' , icon: '🏃' }, { key: 'constitution' ,
                                        label: 'Constituição' , icon: '🛡️' }, { key: 'intelligence' ,
                                        label: 'Inteligência' , icon: '🧠' }, { key: 'reasoning' , label: 'Raciocínio' ,
                                        icon: '💡' }, { key: 'luck' , label: 'Sorte' , icon: '🍀' } ]; %>

                                        <% attributes.forEach(attr=> { %>
                                            <li
                                                class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                <span>
                                                    <%= attr.icon %>
                                                        <%= attr.label %>
                                                </span>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-secondary rounded-pill fs-6">
                                                        <%= character[attr.key] %>
                                                    </span>
                                                    <% if (character.evolution_points> 0) { %>
                                                        <form action="/my/characters/<%= character.id %>/upgrade"
                                                            method="POST" class="d-inline">
                                                            <input type="hidden" name="attribute"
                                                                value="<%= attr.key %>">
                                                            <button type="submit"
                                                                class="btn btn-sm btn-outline-success rounded-circle p-0 d-flex align-items-center justify-content-center"
                                                                style="width: 24px; height: 24px;"
                                                                title="Evoluir Atributo">
                                                                <i class="bi bi-plus"></i>
                                                            </button>
                                                        </form>
                                                        <% } %>
                                                </div>
                                            </li>
                                            <% }); %>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Affinities & Powers -->
                <div class="col-md-8">
                    <!-- Affinities -->
                    <div class="card card-custom mb-4">
                        <div class="card-header bg-white fw-bold">
                            <i class="bi bi-book me-2 text-primary"></i> Afinidades com Disciplinas
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <% if (character.affinities && character.affinities.length> 0) { %>
                                    <% character.affinities.forEach(aff=> { %>
                                        <div class="col-md-6 mb-3">
                                            <div class="d-flex align-items-center mb-1">
                                                <span class="me-2 fs-5">
                                                    <%= aff.discipline.icon || '📚' %>
                                                </span>
                                                <span class="fw-bold flex-grow-1">
                                                    <%= aff.discipline.name %>
                                                </span>
                                                <span class="badge bg-primary">
                                                    <%= aff.affinity_level %>%
                                                </span>
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar" role="progressbar"
                                                    style="width: <%= aff.affinity_level %>%; background-color: <%= aff.discipline.color_theme %>;"
                                                    aria-valuenow="<%= aff.affinity_level %>" aria-valuemin="0"
                                                    aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <p class="text-muted">Nenhuma afinidade registrada.</p>
                                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Learned Powers -->
                    <div class="card card-custom mb-4">
                        <div class="card-header bg-white fw-bold">
                            <i class="bi bi-lightning-charge me-2 text-warning"></i> Poderes Adquiridos
                        </div>
                        <div class="card-body">
                            <% if (character.powers && character.powers.length> 0) { %>
                                <div class="row">
                                    <% character.powers.forEach(power=> { %>
                                        <div class="col-md-6 mb-3">
                                            <div class="card h-100 border-0 shadow-sm"
                                                style="background-color: #f8f9fa;">
                                                <div class="card-body p-3">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="card-title fw-bold mb-0">
                                                            <%= power.name %>
                                                        </h6>
                                                        <% if (power.discipline) { %>
                                                            <span class="badge"
                                                                style="background-color: <%= power.discipline.color_theme %>">
                                                                <%= power.discipline.name %>
                                                            </span>
                                                            <% } %>
                                                    </div>
                                                    <p class="card-text small text-muted mb-0">
                                                        <%= power.description %>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                                <% } else { %>
                                    <p class="text-muted text-center py-3">Você ainda não aprendeu nenhum poder
                                        especial.</p>
                                    <% } %>
                        </div>
                    </div>

                    <!-- Available Powers -->
                    <div class="card card-custom">
                        <div class="card-header bg-white fw-bold">
                            <i class="bi bi-unlock me-2 text-success"></i> Poderes Disponíveis para Aprender
                        </div>
                        <div class="card-body">
                            <% if (availablePowers && availablePowers.length> 0) { %>
                                <div class="row">
                                    <% availablePowers.forEach(power=> { %>
                                        <div class="col-md-6 mb-3">
                                            <div class="card h-100 border-success shadow-sm">
                                                <div class="card-body p-3">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="card-title fw-bold mb-0 text-success">
                                                            <%= power.name %>
                                                        </h6>
                                                        <% if (power.discipline) { %>
                                                            <span class="badge"
                                                                style="background-color: <%= power.discipline.color_theme %>">
                                                                <%= power.discipline.name %>
                                                            </span>
                                                            <% } %>
                                                    </div>
                                                    <p class="card-text small text-muted mb-3">
                                                        <%= power.description %>
                                                    </p>
                                                    <form action="/my/characters/<%= character.id %>/learn-power"
                                                        method="POST">
                                                        <input type="hidden" name="power_id" value="<%= power.id %>">
                                                        <button type="submit"
                                                            class="btn btn-sm btn-outline-success w-100">
                                                            Aprender (Req: <%= power.required_affinity %>%)
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                                <% } else { %>
                                    <p class="text-muted text-center py-3">Não há novos poderes disponíveis para
                                        aprender no momento. Aumente suas afinidades!</p>
                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../../partials/footer') %>