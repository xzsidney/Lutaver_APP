<%- include('../../partials/teacher/header') %>
    <%- include('../../partials/teacher/navbar') %>

        <main class="container mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="fw-bold text-primary">Análise de Questões</h1>
                <div class="btn-group">
                    <a href="/teacher/reports/students" class="btn btn-outline-primary">Por Aluno</a>
                    <a href="/teacher/reports/adventures" class="btn btn-outline-primary">Por Aventura</a>
                    <a href="/teacher/reports/questions" class="btn btn-primary active">Por Questão</a>
                </div>
            </div>

            <div class="alert alert-info border-0 shadow-sm d-flex align-items-center">
                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                <div>
                    <strong>Dica:</strong> Use este relatório para identificar questões que podem estar mal formuladas
                    (muitos erros) ou muito fáceis.
                </div>
            </div>

            <div class="card card-custom">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Questão (Resumo)</th>
                                    <th>Disciplina / Aventura</th>
                                    <th class="text-center">Tentativas</th>
                                    <th class="text-center">% Acertos</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end pe-4">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof questionStats !=='undefined' && questionStats.length> 0) { %>
                                    <% questionStats.forEach(stat=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="text-truncate" style="max-width: 300px;"
                                                    title="<%= stat.question_text %>">
                                                    <%= stat.question_text %>
                                                </div>
                                                <small class="text-muted">ID: #<%= stat.id %></small>
                                            </td>
                                            <td>
                                                <div class="fw-bold">
                                                    <%= stat.discipline_name %>
                                                </div>
                                                <small class="text-muted">
                                                    <%= stat.adventure_title || 'Avulsa' %>
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <%= stat.attempts %>
                                            </td>
                                            <td class="text-center fw-bold">
                                                <%= stat.accuracy_rate %>%
                                            </td>
                                            <td class="text-center">
                                                <% if (stat.accuracy_rate < 30) { %>
                                                    <span class="badge bg-danger" title="Muito Difícil / Revisar">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>Difícil
                                                    </span>
                                                    <% } else if (stat.accuracy_rate> 90) { %>
                                                        <span class="badge bg-success" title="Bem calibrada / Fácil">
                                                            <i class="bi bi-check-lg me-1"></i>Fácil
                                                        </span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning text-dark">Equilibrada</span>
                                                            <% } %>
                                            </td>
                                            <td class="text-end pe-4">
                                                <a href="/teacher/questions/<%= stat.id %>/edit"
                                                    class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-5">
                                                        <p class="text-muted mb-0">Nenhum dado estatístico disponível.
                                                        </p>
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/teacher/footer') %>