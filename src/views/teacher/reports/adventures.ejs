<%- include('../../partials/teacher/header') %>
    <%- include('../../partials/teacher/navbar') %>

        <main class="container mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="fw-bold text-primary">Desempenho por Aventura</h1>
                <div class="btn-group">
                    <a href="/teacher/reports/students" class="btn btn-outline-primary">Por Aluno</a>
                    <a href="/teacher/reports/adventures" class="btn btn-primary active">Por Aventura</a>
                    <a href="/teacher/reports/questions" class="btn btn-outline-primary">Por Questão</a>
                </div>
            </div>

            <div class="card card-custom">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Aventura</th>
                                    <th>Disciplina</th>
                                    <th class="text-center">Jogadores</th>
                                    <th class="text-center">Taxa Média de Acerto</th>
                                    <th class="text-center">Dificuldade Percebida</th>
                                    <th class="text-end pe-4">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof adventureStats !=='undefined' && adventureStats.length> 0) { %>
                                    <% adventureStats.forEach(stat=> { %>
                                        <tr>
                                            <td class="ps-4 fw-bold">
                                                <%= stat.title %>
                                            </td>
                                            <td>
                                                <span class="badge"
                                                    style="background-color: <%= stat.color_theme || '#6c757d' %>">
                                                    <%= stat.discipline_name %>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <%= stat.players_count %>
                                            </td>
                                            <td class="text-center">
                                                <span
                                                    class="fw-bold <%= stat.avg_accuracy >= 70 ? 'text-success' : (stat.avg_accuracy >= 50 ? 'text-warning' : 'text-danger') %>">
                                                    <%= stat.avg_accuracy %>%
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <% if (stat.avg_accuracy>= 80) { %>
                                                    <span class="badge bg-success">Fácil</span>
                                                    <% } else if (stat.avg_accuracy>= 50) { %>
                                                        <span class="badge bg-warning text-dark">Normal</span>
                                                        <% } else { %>
                                                            <span class="badge bg-danger">Difícil</span>
                                                            <% } %>
                                            </td>
                                            <td class="text-end pe-4">
                                                <a href="/teacher/adventures/<%= stat.id %>/details"
                                                    class="btn btn-sm btn-outline-primary">
                                                    Ver Detalhes
                                                </a>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-5">
                                                        <p class="text-muted mb-0">Nenhum dado de aventura disponível.
                                                        </p>
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/teacher/footer') %>