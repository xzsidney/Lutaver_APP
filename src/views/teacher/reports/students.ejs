<%- include('../../partials/teacher/header') %>
    <%- include('../../partials/teacher/navbar') %>

        <main class="container mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="fw-bold text-primary">Desempenho dos Alunos</h1>
                <div class="btn-group">
                    <a href="/teacher/reports/students" class="btn btn-primary active">Por Aluno</a>
                    <a href="/teacher/reports/adventures" class="btn btn-outline-primary">Por Aventura</a>
                    <a href="/teacher/reports/questions" class="btn btn-outline-primary">Por Questão</a>
                </div>
            </div>

            <!-- Filters -->
            <div class="card card-custom mb-4">
                <div class="card-body py-3">
                    <form class="row g-3 align-items-center">
                        <div class="col-auto">
                            <label for="yearFilter" class="col-form-label fw-bold">Filtrar por Ano:</label>
                        </div>
                        <div class="col-auto">
                            <select class="form-select" id="yearFilter">
                                <option value="">Todos</option>
                                <option value="6">6º Ano</option>
                                <option value="7">7º Ano</option>
                                <option value="8">8º Ano</option>
                                <option value="9">9º Ano</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Aplicar</button>
                        </div>
                        <div class="col-auto ms-auto">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                onclick="alert('Funcionalidade futura: Exportar CSV')">
                                <i class="bi bi-download me-1"></i> Exportar
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Students Table -->
            <div class="card card-custom">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Aluno</th>
                                    <th>Ano/Série</th>
                                    <th class="text-center">Quizzes</th>
                                    <th class="text-center">Taxa de Acerto</th>
                                    <th>Melhor Disciplina</th>
                                    <th>Maior Dificuldade</th>
                                    <th class="text-end pe-4">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof students !=='undefined' && students.length> 0) { %>
                                    <% students.forEach(student=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded-circle p-2 me-2 text-primary">
                                                        <i class="bi bi-person"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">
                                                            <%= student.name %>
                                                        </div>
                                                        <small class="text-muted">
                                                            <%= student.email %>
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <%= student.school_year %>º Ano
                                            </td>
                                            <td class="text-center">
                                                <%= student.quizzes_count || 0 %>
                                            </td>
                                            <td class="text-center">
                                                <% let rate=student.accuracy_rate || 0; let color='bg-danger' ; if
                                                    (rate>= 70) color = 'bg-success';
                                                    else if (rate >= 50) color = 'bg-warning text-dark';
                                                    %>
                                                    <div class="progress"
                                                        style="height: 6px; width: 80px; margin: 0 auto;">
                                                        <div class="progress-bar <%= color %>" role="progressbar"
                                                            style="width: <%= rate %>%;" aria-valuenow="<%= rate %>"
                                                            aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <small class="fw-bold mt-1 d-block">
                                                        <%= rate %>%
                                                    </small>
                                            </td>
                                            <td>
                                                <% if (student.best_discipline) { %>
                                                    <span
                                                        class="badge bg-success bg-opacity-10 text-success border border-success">
                                                        <%= student.best_discipline %>
                                                    </span>
                                                    <% } else { %>
                                                        <span class="text-muted small">-</span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <% if (student.worst_discipline) { %>
                                                    <span
                                                        class="badge bg-danger bg-opacity-10 text-danger border border-danger">
                                                        <%= student.worst_discipline %>
                                                    </span>
                                                    <% } else { %>
                                                        <span class="text-muted small">-</span>
                                                        <% } %>
                                            </td>
                                            <td class="text-end pe-4">
                                                <a href="#" class="btn btn-sm btn-outline-primary" title="Ver Detalhes">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7" class="text-center py-5">
                                                        <p class="text-muted mb-0">Nenhum dado de aluno disponível
                                                            ainda.</p>
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/teacher/footer') %>