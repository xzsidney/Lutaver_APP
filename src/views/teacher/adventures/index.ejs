<%- include('../../partials/teacher/header') %>
    <%- include('../../partials/teacher/navbar') %>

        <main class="container mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold text-primary">Minhas Aventuras</h1>
                    <p class="text-muted">Gerencie as jornadas de aprendizado dos seus alunos.</p>
                </div>
                <a href="/teacher/adventures/new" class="btn btn-magic">
                    <i class="bi bi-plus-lg me-2"></i>Criar Nova Aventura
                </a>
            </div>

            <!-- Filters (Optional) -->
            <div class="card card-custom mb-4">
                <div class="card-body">
                    <form action="/teacher/adventures" method="GET" class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label for="discipline" class="form-label fw-bold small text-muted">Disciplina</label>
                            <select class="form-select" id="discipline" name="discipline_id">
                                <option value="">Todas</option>
                                <% if (typeof disciplines !=='undefined' ) { %>
                                    <% disciplines.forEach(d=> { %>
                                        <option value="<%= d.id %>">
                                            <%= d.name %>
                                        </option>
                                        <% }); %>
                                            <% } %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="year" class="form-label fw-bold small text-muted">Ano Escolar</label>
                            <select class="form-select" id="year" name="school_year">
                                <option value="">Todos</option>
                                <% for(let i=1; i<=9; i++) { %>
                                    <option value="<%= i %>">
                                        <%= i %>º Ano
                                    </option>
                                    <% } %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="status" class="form-label fw-bold small text-muted">Status</label>
                            <select class="form-select" id="status" name="is_active">
                                <option value="">Todos</option>
                                <option value="1">Ativa</option>
                                <option value="0">Inativa</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Adventures List -->
            <div class="card card-custom">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Título da Aventura</th>
                                    <th>Disciplina</th>
                                    <th>Ano</th>
                                    <th>Dificuldade</th>
                                    <th>Recompensa</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (adventures && adventures.length> 0) { %>
                                    <% adventures.forEach(adv=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">
                                                    <%= adv.title %>
                                                </div>
                                                <small class="text-muted">
                                                    <%= adv.description ? adv.description.substring(0, 50) + '...' : ''
                                                        %>
                                                </small>
                                            </td>
                                            <td>
                                                <% if (adv.discipline) { %>
                                                    <span class="badge"
                                                        style="background-color: <%= adv.discipline.color_theme || '#6c757d' %>">
                                                        <%= adv.discipline.name %>
                                                    </span>
                                                    <% } else { %>
                                                        <span class="text-muted">-</span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <%= adv.school_year %>º
                                            </td>
                                            <td>
                                                <% let diffLabel='Médio' ; let diffClass='bg-warning text-dark' ; if
                                                    (adv.difficulty===1) { diffLabel='Muito Fácil' ;
                                                    diffClass='bg-success' ; } else if (adv.difficulty===2) {
                                                    diffLabel='Fácil' ; diffClass='bg-info text-dark' ; } else if
                                                    (adv.difficulty===4) { diffLabel='Difícil' ; diffClass='bg-danger' ;
                                                    } else if (adv.difficulty===5) { diffLabel='Muito Difícil' ;
                                                    diffClass='bg-dark' ; } %>
                                                    <span class="badge <%= diffClass %>">
                                                        <%= diffLabel %>
                                                    </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                                    <span>
                                                        <%= adv.xp_reward %> XP
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <% if (adv.is_active) { %>
                                                    <span
                                                        class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 rounded-pill">
                                                        <i class="bi bi-check-circle me-1"></i>Ativa
                                                    </span>
                                                    <% } else { %>
                                                        <span
                                                            class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-2 py-1 rounded-pill">
                                                            Inativa
                                                        </span>
                                                        <% } %>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-light rounded-circle" type="button"
                                                        data-bs-toggle="dropdown">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                                        <li><a class="dropdown-item"
                                                                href="/teacher/adventures/<%= adv.id %>/edit"><i
                                                                    class="bi bi-pencil me-2 text-primary"></i>Editar</a>
                                                        </li>
                                                        <li><a class="dropdown-item"
                                                                href="/teacher/adventures/<%= adv.id %>/questions"><i
                                                                    class="bi bi-list-check me-2 text-info"></i>Ver
                                                                Questões</a></li>
                                                        <li><a class="dropdown-item"
                                                                href="/teacher/reports/adventures?id=<%= adv.id %>"><i
                                                                    class="bi bi-bar-chart me-2 text-success"></i>Desempenho</a>
                                                        </li>
                                                        <li>
                                                            <hr class="dropdown-divider">
                                                        </li>
                                                        <li>
                                                            <form action="/teacher/adventures/<%= adv.id %>/delete"
                                                                method="POST" onsubmit="return confirm('Tem certeza?');"
                                                                class="d-inline">
                                                                <button type="submit"
                                                                    class="dropdown-item text-danger"><i
                                                                        class="bi bi-trash me-2"></i>Excluir</button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7" class="text-center py-5">
                                                        <div class="text-muted mb-3">
                                                            <i class="bi bi-journal-x fs-1 opacity-50"></i>
                                                        </div>
                                                        <h5>Nenhuma aventura encontrada</h5>
                                                        <p class="text-muted">Comece criando sua primeira aventura para
                                                            seus alunos.</p>
                                                        <a href="/teacher/adventures/new"
                                                            class="btn btn-sm btn-magic mt-2">Criar Aventura</a>
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/teacher/footer') %>