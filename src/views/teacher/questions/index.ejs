<%- include('../../partials/teacher/header') %>
    <%- include('../../partials/teacher/navbar') %>

        <main class="container mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold text-primary">Minhas Questões</h1>
                    <p class="text-muted">Banco de questões para suas aventuras.</p>
                </div>
                <a href="/teacher/questions/new" class="btn btn-magic">
                    <i class="bi bi-plus-lg me-2"></i>Nova Questão
                </a>
            </div>

            <!-- Filters -->
            <div class="card card-custom mb-4">
                <div class="card-body">
                    <form action="/teacher/questions" method="GET" class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label for="discipline" class="form-label fw-bold small text-muted">Disciplina</label>
                            <select class="form-select form-select-sm" id="discipline" name="discipline_id">
                                <option value="">Todas</option>
                                <% if (typeof disciplines !=='undefined' ) { %>
                                    <% disciplines.forEach(d=> { %>
                                        <option value="<%= d.id %>">
                                            <%= d.name %>
                                        </option>
                                        <% }); %>
                                            <% } %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="adventure" class="form-label fw-bold small text-muted">Aventura</label>
                            <select class="form-select form-select-sm" id="adventure" name="adventure_id">
                                <option value="">Todas</option>
                                <% if (typeof adventures !=='undefined' ) { %>
                                    <% adventures.forEach(adv=> { %>
                                        <option value="<%= adv.id %>">
                                            <%= adv.title %>
                                        </option>
                                        <% }); %>
                                            <% } %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="year" class="form-label fw-bold small text-muted">Ano</label>
                            <select class="form-select form-select-sm" id="year" name="school_year">
                                <option value="">Todos</option>
                                <% for(let i=1; i<=9; i++) { %>
                                    <option value="<%= i %>">
                                        <%= i %>º Ano
                                    </option>
                                    <% } %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="difficulty" class="form-label fw-bold small text-muted">Dificuldade</label>
                            <select class="form-select form-select-sm" id="difficulty" name="difficulty">
                                <option value="">Todas</option>
                                <option value="1">Muito Fácil</option>
                                <option value="2">Fácil</option>
                                <option value="3">Médio</option>
                                <option value="4">Difícil</option>
                                <option value="5">Muito Difícil</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100">Filtrar</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Questions List -->
            <div class="card card-custom">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4" style="width: 40%;">Enunciado</th>
                                    <th>Disciplina</th>
                                    <th>Aventura</th>
                                    <th>Ano</th>
                                    <th>Dificuldade</th>
                                    <th class="text-end pe-4">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (questions && questions.length> 0) { %>
                                    <% questions.forEach(q=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="text-truncate" style="max-width: 350px;"
                                                    title="<%= q.question_text %>">
                                                    <%= q.question_text %>
                                                </div>
                                            </td>
                                            <td>
                                                <% if (q.discipline) { %>
                                                    <span class="badge"
                                                        style="background-color: <%= q.discipline.color_theme || '#6c757d' %>">
                                                        <%= q.discipline.name %>
                                                    </span>
                                                    <% } else { %>
                                                        -
                                                        <% } %>
                                            </td>
                                            <td>
                                                <% if (q.adventure) { %>
                                                    <small class="text-muted"><i class="bi bi-map me-1"></i>
                                                        <%= q.adventure.title %>
                                                    </small>
                                                    <% } else { %>
                                                        <span class="text-muted small">Avulsa</span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <%= q.school_year %>º
                                            </td>
                                            <td>
                                                <% let diffClass='bg-secondary' ; if (q.difficulty===1)
                                                    diffClass='bg-success' ; else if (q.difficulty===2)
                                                    diffClass='bg-info text-dark' ; else if (q.difficulty===3)
                                                    diffClass='bg-warning text-dark' ; else if (q.difficulty===4)
                                                    diffClass='bg-danger' ; else diffClass='bg-dark' ; %>
                                                    <span class="badge <%= diffClass %>">
                                                        <%= q.difficulty %>
                                                    </span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/teacher/questions/<%= q.id %>/edit"
                                                        class="btn btn-outline-primary" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <a href="/teacher/questions/<%= q.id %>/duplicate"
                                                        class="btn btn-outline-secondary" title="Duplicar">
                                                        <i class="bi bi-files"></i>
                                                    </a>
                                                    <form action="/teacher/questions/<%= q.id %>/delete" method="POST"
                                                        onsubmit="return confirm('Tem certeza?');" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-danger"
                                                            title="Excluir">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-5">
                                                        <div class="text-muted mb-3">
                                                            <i class="bi bi-question-circle fs-1 opacity-50"></i>
                                                        </div>
                                                        <h5>Nenhuma questão encontrada</h5>
                                                        <p class="text-muted">Crie questões para desafiar seus alunos.
                                                        </p>
                                                        <a href="/teacher/questions/new"
                                                            class="btn btn-sm btn-magic mt-2">Criar Questão</a>
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/teacher/footer') %>