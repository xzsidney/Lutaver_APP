<%- include('../../partials/teacher/header') %>
    <%- include('../../partials/teacher/navbar') %>

        <main class="container mb-5">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="fw-bold text-primary">
                            <%= (typeof question !=='undefined' && question) ? 'Editar Questão' : 'Nova Questão' %>
                        </h1>
                        <a href="/teacher/questions" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Voltar
                        </a>
                    </div>

                    <div class="card card-custom">
                        <div class="card-body p-4">
                            <form
                                action="<%= (typeof question !== 'undefined' && question) ? '/teacher/questions/' + question.id : '/teacher/questions' %>"
                                method="POST">

                                <!-- Context -->
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label for="discipline_id" class="form-label fw-bold">Disciplina</label>
                                        <select class="form-select" id="discipline_id" name="discipline_id" required>
                                            <option value="">Selecione...</option>
                                            <% if (typeof disciplines !=='undefined' ) { %>
                                                <% disciplines.forEach(d=> { %>
                                                    <option value="<%= d.id %>" <%=(typeof question !=='undefined' &&
                                                        question && question.discipline_id===d.id) ? 'selected' : '' %>>
                                                        <%= d.name %>
                                                    </option>
                                                    <% }); %>
                                                        <% } %>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="adventure_id" class="form-label fw-bold">Aventura (Opcional)</label>
                                        <select class="form-select" id="adventure_id" name="adventure_id">
                                            <option value="">Nenhuma (Questão Avulsa)</option>
                                            <% if (typeof adventures !=='undefined' ) { %>
                                                <% adventures.forEach(adv=> { %>
                                                    <option value="<%= adv.id %>" <%=(typeof question !=='undefined' &&
                                                        question && question.adventure_id===adv.id) ? 'selected' : '' %>
                                                        ><%= adv.title %>
                                                    </option>
                                                    <% }); %>
                                                        <% } %>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="school_year" class="form-label fw-bold">Ano</label>
                                        <select class="form-select" id="school_year" name="school_year" required>
                                            <% for(let i=1; i<=9; i++) { %>
                                                <option value="<%= i %>" <%=(typeof question !=='undefined' && question
                                                    && question.school_year===i) ? 'selected' : '' %>><%= i %>º</option>
                                                <% } %>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label for="difficulty" class="form-label fw-bold">Dificuldade</label>
                                        <select class="form-select" id="difficulty" name="difficulty" required>
                                            <option value="1" <%=(typeof question !=='undefined' && question &&
                                                question.difficulty===1) ? 'selected' : '' %>>1 - Muito Fácil</option>
                                            <option value="2" <%=(typeof question !=='undefined' && question &&
                                                question.difficulty===2) ? 'selected' : '' %>>2 - Fácil</option>
                                            <option value="3" <%=(typeof question !=='undefined' && question &&
                                                question.difficulty===3) ? 'selected' : '' %>>3 - Médio</option>
                                            <option value="4" <%=(typeof question !=='undefined' && question &&
                                                question.difficulty===4) ? 'selected' : '' %>>4 - Difícil</option>
                                            <option value="5" <%=(typeof question !=='undefined' && question &&
                                                question.difficulty===5) ? 'selected' : '' %>>5 - Muito Difícil</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Question Content -->
                                <div class="mb-4">
                                    <label for="question_text" class="form-label fw-bold">Enunciado da Questão</label>
                                    <textarea class="form-control" id="question_text" name="question_text" rows="3"
                                        required
                                        placeholder="Digite o enunciado da questão aqui..."><%= (typeof question !== 'undefined' && question) ? question.question_text : '' %></textarea>
                                </div>

                                <!-- Options -->
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">Alternativas</h5>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <span class="input-group-text bg-light fw-bold">A</span>
                                            <input type="text" class="form-control" name="option_a"
                                                value="<%= (typeof question !== 'undefined' && question) ? question.option_a : '' %>"
                                                required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <span class="input-group-text bg-light fw-bold">B</span>
                                            <input type="text" class="form-control" name="option_b"
                                                value="<%= (typeof question !== 'undefined' && question) ? question.option_b : '' %>"
                                                required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <span class="input-group-text bg-light fw-bold">C</span>
                                            <input type="text" class="form-control" name="option_c"
                                                value="<%= (typeof question !== 'undefined' && question) ? question.option_c : '' %>"
                                                required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <span class="input-group-text bg-light fw-bold">D</span>
                                            <input type="text" class="form-control" name="option_d"
                                                value="<%= (typeof question !== 'undefined' && question) ? question.option_d : '' %>"
                                                required>
                                        </div>
                                    </div>
                                </div>

                                <!-- Solution -->
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label for="correct_option" class="form-label fw-bold text-success">Resposta
                                            Correta</label>
                                        <select class="form-select border-success" id="correct_option"
                                            name="correct_option" required>
                                            <option value="">Selecione...</option>
                                            <option value="a" <%=(typeof question !=='undefined' && question &&
                                                question.correct_option==='a' ) ? 'selected' : '' %>>Alternativa A
                                            </option>
                                            <option value="b" <%=(typeof question !=='undefined' && question &&
                                                question.correct_option==='b' ) ? 'selected' : '' %>>Alternativa B
                                            </option>
                                            <option value="c" <%=(typeof question !=='undefined' && question &&
                                                question.correct_option==='c' ) ? 'selected' : '' %>>Alternativa C
                                            </option>
                                            <option value="d" <%=(typeof question !=='undefined' && question &&
                                                question.correct_option==='d' ) ? 'selected' : '' %>>Alternativa D
                                            </option>
                                        </select>
                                    </div>
                                    <div class="col-md-8">
                                        <label for="explanation" class="form-label fw-bold">Explicação
                                            (Feedback)</label>
                                        <textarea class="form-control" id="explanation" name="explanation" rows="2"
                                            placeholder="Explique por que a resposta está correta (aparece após o aluno responder)..."><%= (typeof question !== 'undefined' && question) ? question.explanation : '' %></textarea>
                                    </div>
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                    <a href="/teacher/questions" class="btn btn-light border me-md-2">Cancelar</a>
                                    <button type="submit" class="btn btn-magic px-5">Salvar Questão</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/teacher/footer') %>