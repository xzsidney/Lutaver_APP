<%- include('../partials/header') %>
    <%- include('../partials/navbar') %>

        <main class="auth-page">
            <section class="auth-hero">
                <div class="container auth-container">
                    <div class="auth-info">
                        <h1 class="auth-title">Bem-vindo de volta!</h1>
                        <p class="auth-subtitle">
                            Acesse sua conta para continuar sua jornada na Torre do Saber,
                            evoluir seu personagem e enfrentar novas aventuras educacionais.
                        </p>

                        <ul class="auth-benefits">
                            <li>✅ Continue de onde parou</li>
                            <li>✅ Acompanhe seu progresso e XP</li>
                            <li>✅ Desbloqueie novos andares e desafios</li>
                        </ul>
                    </div>

                    <div class="auth-card">
                        <h2>Entrar</h2>

                        <!-- Ajuste action e names conforme seu backend -->
                        <form action="/login" method="POST" class="auth-form">
                            <div class="form-group">
                                <label for="email">E-mail</label>
                                <input type="email" id="email" name="email" required placeholder="seuemail@exemplo.com">
                            </div>

                            <div class="form-group">
                                <label for="password">Senha</label>
                                <input type="password" id="password" name="password" required
                                    placeholder="Digite sua senha">
                            </div>

                            <!-- Se você passar mensagens de erro via EJS -->
                            <% if (typeof error !=='undefined' && error) { %>
                                <div class="auth-error">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <button type="submit" class="btn btn-primary btn-large auth-btn">
                                        Entrar
                                    </button>

                                    <p class="auth-register-text">
                                        Ainda não tem conta?
                                        <a href="/register">Criar conta</a>
                                    </p>
                        </form>
                    </div>
                </div>
            </section>
        </main>

        <%- include('../partials/footer') %>