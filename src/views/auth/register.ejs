<%- include('../partials/header') %>
    <%- include('../partials/navbar') %>

        <main class="auth-page">
            <section class="auth-hero">
                <div class="container auth-container">
                    <div class="auth-info">
                        <h1 class="auth-title">Crie sua conta</h1>
                        <p class="auth-subtitle">
                            Junte-se à Torre do Saber e comece sua jornada de aprendizado e aventura!
                        </p>

                        <ul class="auth-benefits">
                            <li>✅ Crie seu personagem único</li>
                            <li>✅ Desafie seus conhecimentos</li>
                            <li>✅ Compete com amigos</li>
                        </ul>
                    </div>

                    <div class="auth-card">
                        <h2>Cadastrar</h2>

                        <form action="/register" method="POST" class="auth-form">
                            <div class="form-group">
                                <label for="name">Nome Completo</label>
                                <input type="text" id="name" name="name" required placeholder="Seu nome" <% if (typeof
                                    name !=='undefined' ) { %> value="<%= name %>" <% } %>>
                            </div>

                            <div class="form-group">
                                <label for="email">E-mail</label>
                                <input type="email" id="email" name="email" required placeholder="seuemail@exemplo.com"
                                    <% if (typeof email !=='undefined' ) { %> value="<%= email %>" <% } %>>
                            </div>

                            <div class="form-group">
                                <label for="password">Senha</label>
                                <input type="password" id="password" name="password" required
                                    placeholder="Crie uma senha segura">
                            </div>

                            <div class="form-group">
                                <label for="confirm_password">Confirmar Senha</label>
                                <input type="password" id="confirm_password" name="confirm_password" required
                                    placeholder="Repita sua senha">
                            </div>

                            <% if (typeof error !=='undefined' && error) { %>
                                <div class="auth-error">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <button type="submit" class="btn btn-primary btn-large auth-btn">
                                        Criar Conta
                                    </button>

                                    <p class="auth-register-text">
                                        Já tem uma conta?
                                        <a href="/login">Fazer login</a>
                                    </p>
                        </form>
                    </div>
                </div>
            </section>
        </main>

        <%- include('../partials/footer') %>