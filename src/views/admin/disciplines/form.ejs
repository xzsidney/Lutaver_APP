<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/navbar', { page: 'disciplines' }) %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2 text-primary fw-bold">
                    <%= discipline ? 'Editar Disciplina' : 'Nova Disciplina' %>
                </h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="/admin/disciplines" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card card-custom">
                        <div class="card-body p-4">
                            <% if (error) { %>
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <%= error %>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"
                                            aria-label="Close"></button>
                                </div>
                                <% } %>

                                    <form
                                        action="<%= discipline ? '/admin/disciplines/' + discipline.id : '/admin/disciplines' %>"
                                        method="POST">
                                        <div class="row mb-3">
                                            <div class="col-md-8">
                                                <label for="name" class="form-label fw-bold">Nome da Disciplina</label>
                                                <input type="text" class="form-control" id="name" name="name"
                                                    value="<%= discipline ? discipline.name : '' %>" required>
                                            </div>
                                            <div class="col-md-4">
                                                <label for="code" class="form-label fw-bold">Código (ex: MAT_F1)</label>
                                                <input type="text" class="form-control" id="code" name="code"
                                                    value="<%= discipline ? discipline.code : '' %>" required>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="description" class="form-label fw-bold">Descrição</label>
                                            <textarea class="form-control" id="description" name="description"
                                                rows="3"><%= discipline ? discipline.description : '' %></textarea>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <label for="school_level" class="form-label fw-bold">Nível
                                                    Escolar</label>
                                                <select class="form-select" id="school_level" name="school_level">
                                                    <option value="fundamental_1" <%=(discipline &&
                                                        discipline.school_level==='fundamental_1' ) ? 'selected' : '' %>
                                                        >Fundamental I</option>
                                                    <option value="fundamental_2" <%=(discipline &&
                                                        discipline.school_level==='fundamental_2' ) ? 'selected' : '' %>
                                                        >Fundamental II</option>
                                                    <option value="medio" <%=(discipline &&
                                                        discipline.school_level==='medio' ) ? 'selected' : '' %>>Ensino
                                                        Médio</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label for="color_theme" class="form-label fw-bold">Cor Tema</label>
                                                <input type="color" class="form-control form-control-color w-100"
                                                    id="color_theme" name="color_theme"
                                                    value="<%= discipline ? discipline.color_theme : '#1E90FF' %>"
                                                    title="Escolha a cor">
                                            </div>
                                            <div class="col-md-4">
                                                <label for="icon" class="form-label fw-bold">Ícone (Emoji)</label>
                                                <input type="text" class="form-control" id="icon" name="icon"
                                                    value="<%= discipline ? discipline.icon : '📚' %>">
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="is_active"
                                                    name="is_active" <%=(!discipline || discipline.is_active)
                                                    ? 'checked' : '' %>>
                                                <label class="form-check-label" for="is_active">
                                                    Disciplina Ativa
                                                </label>
                                            </div>
                                        </div>

                                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                            <button type="submit" class="btn btn-magic px-4">
                                                <i class="bi bi-save"></i> Salvar
                                            </button>
                                        </div>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/footer') %>