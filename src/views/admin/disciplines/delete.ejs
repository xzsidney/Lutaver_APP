<h1 class="admin-page-title">Disciplinas</h1>

<p class="admin-page-subtitle">
    Confirmação de exclusão
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Excluir Disciplina</h2>

        <a href="/admin/disciplines" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <div class="admin-alert admin-alert-error" style="margin-bottom: 1.5rem;">
        <strong>⚠️ Atenção!</strong><br>
        Tem certeza que deseja excluir esta disciplina?<br>
        <b>Esta ação é permanente e poderá impactar aventuras e questões ligadas a ela.</b>
    </div>

    <div class="admin-table-card" style="margin-bottom: 1.5rem;">
        <h3 style="margin-top: 0; font-size: 1.1rem;">Dados da Disciplina</h3>

        <div style="line-height: 1.8; margin-top: .5rem;">
            <p><strong>Nome:</strong>
                <%= discipline.name %>
            </p>

            <% if (discipline.school_stage) { %>
                <p><strong>Faixa de Ano Escolar:</strong>
                    <%= discipline.school_stage %>
                </p>
                <% } %>

                    <% if (discipline.description) { %>
                        <p><strong>Descrição:</strong>
                            <%= discipline.description %>
                        </p>
                        <% } %>

                            <p>
                                <strong>Status:</strong>
                                <%= discipline.is_active ? 'Ativa' : 'Inativa' %>
                            </p>
        </div>
    </div>

    <form action="/admin/disciplines/<%= discipline.id %>/delete" method="POST">
        <div class="admin-form-actions">
            <a href="/admin/disciplines" class="admin-btn admin-btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="admin-btn admin-btn-danger">
                🗑️ Confirmar Exclusão
            </button>
        </div>
    </form>
</section>