<h1 class="admin-page-title">Disciplinas</h1>

<p class="admin-page-subtitle">
    Gerencie as disciplinas utilizadas nas aventuras, questões e afinidades dos personagens.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de disciplinas</h2>
        <a href="/admin/disciplines/new" class="admin-card-link">+ Nova disciplina</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Código / Sigla</th>
                <th>Ativa?</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (disciplines && disciplines.length> 0) { %>
                <% disciplines.forEach(d=> { %>
                    <tr>
                        <td>
                            <%= d.id %>
                        </td>
                        <td>
                            <%= d.name %>
                        </td>

                        <!-- Campo opcional, caso exista ex: d.code ou d.short_name -->
                        <td>
                            <% if (typeof d.code !=='undefined' && d.code) { %>
                                <%= d.code %>
                                    <% } else if (typeof d.short_name !=='undefined' && d.short_name) { %>
                                        <%= d.short_name %>
                                            <% } else { %>
                                                -
                                                <% } %>
                        </td>

                        <!-- Campo opcional is_active -->
                        <td>
                            <% if (typeof d.is_active !=='undefined' ) { %>
                                <%= d.is_active ? 'Sim' : 'Não' %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <a href="/admin/disciplines/<%= d.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/disciplines/<%= d.id %>/delete"
                                class="admin-table-action admin-table-action-danger">
                                Remover
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="admin-table-empty">
                                    Nenhuma disciplina cadastrada.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>