<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/navbar', { page: 'questions' }) %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2 text-primary fw-bold">
                    <%= question ? 'Editar Questão' : 'Nova Questão' %>
                </h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="/admin/questions" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card card-custom">
                        <div class="card-body p-4">
                            <% if (error) { %>
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <%= error %>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"
                                            aria-label="Close"></button>
                                </div>
                                <% } %>

                                    <form
                                        action="<%= question ? '/admin/questions/' + question.id : '/admin/questions' %>"
                                        method="POST">
                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <label for="discipline_id" class="form-label fw-bold">Disciplina</label>
                                                <select class="form-select" id="discipline_id" name="discipline_id"
                                                    required>
                                                    <option value="">Selecione...</option>
                                                    <% disciplines.forEach(d=> { %>
                                                        <option value="<%= d.id %>" <%=(question &&
                                                            question.discipline_id===d.id) ? 'selected' : '' %>>
                                                            <%= d.name %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label for="adventure_id" class="form-label fw-bold">Aventura
                                                    (Opcional)</label>
                                                <select class="form-select" id="adventure_id" name="adventure_id">
                                                    <option value="">Nenhuma (Questão Avulsa)</option>
                                                    <% adventures.forEach(adv=> { %>
                                                        <option value="<%= adv.id %>" <%=(question &&
                                                            question.adventure_id===adv.id) ? 'selected' : '' %>>
                                                            <%= adv.title %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label for="school_year" class="form-label fw-bold">Ano Escolar</label>
                                                <select class="form-select" id="school_year" name="school_year"
                                                    required>
                                                    <% for(let i=1; i<=9; i++) { %>
                                                        <option value="<%= i %>" <%=(question &&
                                                            question.school_year===i) ? 'selected' : '' %>><%= i %>º
                                                        </option>
                                                        <% } %>
                                                            <option value="10" <%=(question &&
                                                                question.school_year===10) ? 'selected' : '' %>>1º Médio
                                                            </option>
                                                            <option value="11" <%=(question &&
                                                                question.school_year===11) ? 'selected' : '' %>>2º Médio
                                                            </option>
                                                            <option value="12" <%=(question &&
                                                                question.school_year===12) ? 'selected' : '' %>>3º Médio
                                                            </option>
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label for="difficulty" class="form-label fw-bold">Dificuldade</label>
                                                <select class="form-select" id="difficulty" name="difficulty" required>
                                                    <option value="1" <%=(question && question.difficulty===1)
                                                        ? 'selected' : '' %>>1 - Muito Fácil</option>
                                                    <option value="2" <%=(question && question.difficulty===2)
                                                        ? 'selected' : '' %>>2 - Fácil</option>
                                                    <option value="3" <%=(question && question.difficulty===3)
                                                        ? 'selected' : '' %>>3 - Médio</option>
                                                    <option value="4" <%=(question && question.difficulty===4)
                                                        ? 'selected' : '' %>>4 - Difícil</option>
                                                    <option value="5" <%=(question && question.difficulty===5)
                                                        ? 'selected' : '' %>>5 - Muito Difícil</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="question_text" class="form-label fw-bold">Enunciado da
                                                Questão</label>
                                            <textarea class="form-control" id="question_text" name="question_text"
                                                rows="3"
                                                required><%= question ? question.question_text : '' %></textarea>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="option_a" class="form-label fw-bold">Alternativa A</label>
                                                <div class="input-group">
                                                    <div class="input-group-text bg-light fw-bold">A</div>
                                                    <input type="text" class="form-control" id="option_a"
                                                        name="option_a" value="<%= question ? question.option_a : '' %>"
                                                        required>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="option_b" class="form-label fw-bold">Alternativa B</label>
                                                <div class="input-group">
                                                    <div class="input-group-text bg-light fw-bold">B</div>
                                                    <input type="text" class="form-control" id="option_b"
                                                        name="option_b" value="<%= question ? question.option_b : '' %>"
                                                        required>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="option_c" class="form-label fw-bold">Alternativa C</label>
                                                <div class="input-group">
                                                    <div class="input-group-text bg-light fw-bold">C</div>
                                                    <input type="text" class="form-control" id="option_c"
                                                        name="option_c" value="<%= question ? question.option_c : '' %>"
                                                        required>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="option_d" class="form-label fw-bold">Alternativa D</label>
                                                <div class="input-group">
                                                    <div class="input-group-text bg-light fw-bold">D</div>
                                                    <input type="text" class="form-control" id="option_d"
                                                        name="option_d" value="<%= question ? question.option_d : '' %>"
                                                        required>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <label for="correct_option"
                                                    class="form-label fw-bold text-success">Resposta Correta</label>
                                                <select class="form-select border-success" id="correct_option"
                                                    name="correct_option" required>
                                                    <option value="a" <%=(question && question.correct_option==='a' )
                                                        ? 'selected' : '' %>>Alternativa A</option>
                                                    <option value="b" <%=(question && question.correct_option==='b' )
                                                        ? 'selected' : '' %>>Alternativa B</option>
                                                    <option value="c" <%=(question && question.correct_option==='c' )
                                                        ? 'selected' : '' %>>Alternativa C</option>
                                                    <option value="d" <%=(question && question.correct_option==='d' )
                                                        ? 'selected' : '' %>>Alternativa D</option>
                                                </select>
                                            </div>
                                            <div class="col-md-8">
                                                <label for="explanation" class="form-label fw-bold">Explicação
                                                    (Feedback)</label>
                                                <textarea class="form-control" id="explanation" name="explanation"
                                                    rows="2"
                                                    placeholder="Explique por que a resposta está correta..."><%= question ? question.explanation : '' %></textarea>
                                            </div>
                                        </div>

                                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                            <button type="submit" class="btn btn-magic px-4">
                                                <i class="bi bi-save"></i> Salvar
                                            </button>
                                        </div>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/footer') %>