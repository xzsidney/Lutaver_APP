<h1 class="admin-page-title">Questões</h1>

<p class="admin-page-subtitle">
    Gerencie o banco de questões usadas nos quizzes e aventuras da Torre do Saber.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de questões</h2>
        <a href="/admin/questions/new" class="admin-card-link">+ Nova questão</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Enunciado</th>
                <th>Disciplina</th>
                <th>Aventura</th>
                <th>Dificuldade</th>
                <th>Resposta correta</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (questions && questions.length> 0) { %>
                <% questions.forEach(q=> { %>
                    <tr>
                        <td>
                            <%= q.id %>
                        </td>

                        <!-- Enunciado (corta para não ficar gigante) -->
                        <td>
                            <% const text=q.question_text || q.text || q.enunciation || '' ; const short=text.length> 80
                                ? text.substring(0, 80) + '...' : text;
                                %>
                                <%= short %>
                        </td>

                        <!-- Disciplina -->
                        <td>
                            <%= q.discipline ? q.discipline.name : '-' %>
                        </td>

                        <!-- Aventura -->
                        <td>
                            <%= q.adventure ? q.adventure.name : '-' %>
                        </td>

                        <!-- Dificuldade (opcional: 1–10 ou nível) -->
                        <td>
                            <% if (typeof q.difficulty !=='undefined' && q.difficulty !==null) { %>
                                <%= q.difficulty %>
                                    <% } else if (typeof q.level !=='undefined' && q.level !==null) { %>
                                        Nível <%= q.level %>
                                            <% } else { %>
                                                -
                                                <% } %>
                        </td>

                        <!-- Resposta correta (campo flexível) -->
                        <td>
                            <% if (typeof q.correct_answer !=='undefined' && q.correct_answer) { %>
                                <%= q.correct_answer %>
                                    <% } else if (typeof q.correct_option !=='undefined' && q.correct_option) { %>
                                        <%= q.correct_option %>
                                            <% } else { %>
                                                -
                                                <% } %>
                        </td>

                        <td>
                            <a href="/admin/questions/<%= q.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/questions/<%= q.id %>/delete"
                                class="admin-table-action admin-table-action-danger">
                                Remover
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="admin-table-empty">
                                    Nenhuma questão cadastrada.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>