<h1 class="admin-page-title">Efeitos</h1>
<p class="admin-page-subtitle">
    Edição de efeito
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Editar Efeito</h2>
        <a href="/admin/effects" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="admin-alert admin-alert-error">
            <%= error %>
        </div>
        <% } %>

            <form action="/admin/effects/<%= effect.id %>" method="POST" class="admin-form">
                <div class="admin-form-grid">
                    <!-- Nome -->
                    <div class="admin-form-group">
                        <label for="name">Nome do Efeito</label>
                        <input type="text" id="name" name="name" class="admin-input" value="<%= effect.name %>"
                            required>
                    </div>

                    <!-- Tipo -->
                    <div class="admin-form-group">
                        <label for="type">Tipo</label>
                        <select id="type" name="type" class="admin-input" required>
                            <option value="buff" <%=effect.type==='buff' ? 'selected' : '' %>>✨ Buff (Positivo)</option>
                            <option value="debuff" <%=effect.type==='debuff' ? 'selected' : '' %>>💀 Debuff (Negativo)
                            </option>
                            <option value="neutral" <%=effect.type==='neutral' ? 'selected' : '' %>>⚪ Neutro</option>
                        </select>
                    </div>

                    <!-- Potência -->
                    <div class="admin-form-group">
                        <label for="potency">Potência</label>
                        <input type="number" id="potency" name="potency" class="admin-input"
                            value="<%= effect.potency || 0 %>">
                    </div>

                    <!-- Duração em Turnos -->
                    <div class="admin-form-group">
                        <label for="duration_turns">Duração (Turnos)</label>
                        <input type="number" id="duration_turns" name="duration_turns" class="admin-input" min="0"
                            value="<%= effect.duration_turns || 3 %>">
                    </div>

                    <!-- Descrição -->
                    <div class="admin-form-group admin-form-group-inline">
                        <label for="description">Descrição</label>
                        <textarea id="description" name="description" class="admin-input"
                            rows="3"><%= effect.description || '' %></textarea>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a href="/admin/effects" class="admin-btn admin-btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="admin-btn admin-btn-primary">
                        Salvar
                    </button>
                </div>
            </form>
</section>