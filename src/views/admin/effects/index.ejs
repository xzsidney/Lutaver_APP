<h1 class="admin-page-title">Efeitos</h1>

<p class="admin-page-subtitle">
    Gerencie os efeitos que podem ser aplicados por poderes, itens ou eventos nas aventuras.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de efeitos</h2>
        <a href="/admin/effects/new" class="admin-card-link">+ Novo efeito</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Valor</th>
                <th>Duração</th>
                <th>Ativo?</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (effects && effects.length> 0) { %>
                <% effects.forEach(e=> { %>
                    <tr>
                        <td>
                            <%= e.id %>
                        </td>

                        <td>
                            <%= e.name %>
                        </td>

                        <td>
                            <% if (typeof e.effect_type !=='undefined' && e.effect_type) { %>
                                <%= e.effect_type %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (typeof e.value !=='undefined' && e.value !==null) { %>
                                <%= e.value %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (typeof e.duration !=='undefined' && e.duration !==null) { %>
                                <%= e.duration %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (typeof e.is_active !=='undefined' ) { %>
                                <%= e.is_active ? 'Sim' : 'Não' %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <a href="/admin/effects/<%= e.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/effects/<%= e.id %>/delete"
                                class="admin-table-action admin-table-action-danger">
                                Remover
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="admin-table-empty">
                                    Nenhum efeito cadastrado.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>