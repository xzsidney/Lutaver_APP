<h1 class="admin-page-title">Efeitos</h1>
<p class="admin-page-subtitle">
    Cadastro de novo efeito
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Novo Efeito</h2>
        <a href="/admin/effects" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="admin-alert admin-alert-error">
            <%= error %>
        </div>
        <% } %>

            <form action="/admin/effects" method="POST" class="admin-form">
                <div class="admin-form-grid">
                    <!-- Nome -->
                    <div class="admin-form-group">
                        <label for="name">Nome do Efeito</label>
                        <input type="text" id="name" name="name" class="admin-input" placeholder="Ex: Força Aumentada"
                            required>
                    </div>

                    <!-- Tipo -->
                    <div class="admin-form-group">
                        <label for="type">Tipo</label>
                        <select id="type" name="type" class="admin-input" required>
                            <option value="buff">✨ Buff (Positivo)</option>
                            <option value="debuff">💀 Debuff (Negativo)</option>
                            <option value="neutral">⚪ Neutro</option>
                        </select>
                    </div>

                    <!-- Potência -->
                    <div class="admin-form-group">
                        <label for="potency">Potência</label>
                        <input type="number" id="potency" name="potency" class="admin-input" placeholder="0" value="0">
                        <span class="admin-field-hint">
                            Valor do modificador (positivo ou negativo)
                        </span>
                    </div>

                    <!-- Duração em Turnos -->
                    <div class="admin-form-group">
                        <label for="duration_turns">Duração (Turnos)</label>
                        <input type="number" id="duration_turns" name="duration_turns" class="admin-input" min="0"
                            placeholder="3" value="3">
                        <span class="admin-field-hint">
                            0 = permanente
                        </span>
                    </div>

                    <!-- Descrição -->
                    <div class="admin-form-group admin-form-group-inline">
                        <label for="description">Descrição</label>
                        <textarea id="description" name="description" class="admin-input" rows="3"
                            placeholder="Descreva o que este efeito faz no jogo..."></textarea>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a href="/admin/effects" class="admin-btn admin-btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="admin-btn admin-btn-primary">
                        Salvar
                    </button>
                </div>
            </form>
</section>