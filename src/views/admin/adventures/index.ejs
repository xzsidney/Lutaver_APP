<h1 class="admin-page-title">Aventuras</h1>

<p class="admin-page-subtitle">
    Gerencie as aventuras que os alunos irão jogar na Torre do Saber.
    Cada aventura pode estar ligada a uma disciplina e ter nível de dificuldade.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de aventuras</h2>
        <a href="/admin/adventures/new" class="admin-card-link">+ Nova aventura</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Disciplina</th>
                <th>Dificuldade</th>
                <th>Nível</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (adventures && adventures.length> 0) { %>
                <% adventures.forEach(a=> { %>
                    <tr>
                        <td>
                            <%= a.id %>
                        </td>
                        <td>
                            <%= a.name %>
                        </td>
                        <td>
                            <%= a.discipline ? a.discipline.name : '-' %>
                        </td>
                        <td>
                            <% if (typeof a.difficulty !=='undefined' && a.difficulty !==null) { %>
                                <%= a.difficulty %>/10
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>
                        <td>
                            <% if (typeof a.level !=='undefined' && a.level !==null) { %>
                                <%= a.level %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>
                        <td>
                            <a href="/admin/adventures/<%= a.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/adventures/<%= a.id %>/delete"
                                class="admin-table-action admin-table-action-danger">Remover</a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="admin-table-empty">
                                    Nenhuma aventura cadastrada.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>