<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= npc.name %> - Lutaver
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <style>
        .npc-avatar-lg {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border: 4px solid #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .stat-box {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 10px;
            text-align: center;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: bold;
            color: #0d6efd;
        }

        .stat-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            color: #6c757d;
        }
    </style>
</head>

<body class="bg-light">
    <%- include('../../partials/navbar') %>

        <div class="container mt-4 mb-5">

            <!-- Header -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="me-4">
                            <% if (npc.avatar) { %>
                                <img src="<%= npc.avatar %>" alt="<%= npc.name %>" class="rounded-circle npc-avatar-lg">
                                <% } else { %>
                                    <div
                                        class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center npc-avatar-lg">
                                        <i class="bi bi-person display-1"></i>
                                    </div>
                                    <% } %>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h1 class="mb-1">
                                        <%= npc.name %>
                                    </h1>
                                    <div class="mb-2">
                                        <% if (npc.type==='teacher' ) { %>
                                            <span class="badge bg-primary">Professor</span>
                                            <% } else if (npc.type==='boss' ) { %>
                                                <span class="badge bg-danger">Boss</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">
                                                        <%= npc.type %>
                                                    </span>
                                                    <% } %>
                                                        <span class="badge bg-light text-dark border"><i
                                                                class="bi bi-geo-alt"></i>
                                                            <%= npc.location %>
                                                        </span>
                                    </div>
                                    <p class="lead mb-0 text-muted">
                                        <%= npc.short_description %>
                                    </p>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="/admin/npcs/<%= npc.id %>/edit" class="btn btn-warning">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a href="/admin/npcs" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-left"></i> Voltar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">

                <!-- Coluna Esquerda -->
                <div class="col-md-4">
                    <!-- Bio -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white fw-bold">Sobre</div>
                        <div class="card-body">
                            <p class="card-text">
                                <%= npc.long_description || 'Sem descrição detalhada.' %>
                            </p>
                            <hr>
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2"><strong>Personalidade:</strong>
                                    <%= npc.personality || '-' %>
                                </li>
                                <li class="mb-2"><strong>Disciplina:</strong>
                                    <%= npc.subject || '-' %>
                                </li>
                                <li class="mb-2"><strong>Série:</strong>
                                    <%= npc.grade_level || '-' %>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Funções -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white fw-bold">Funções no Jogo</div>
                        <div class="card-body">
                            <% if (npc.role_flags) { %>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <% npc.role_flags.split(',').forEach(role=> { %>
                                        <span class="badge bg-info text-dark">
                                            <%= role.trim() %>
                                        </span>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <p class="text-muted">Nenhuma função específica.</p>
                                    <% } %>
                                        <ul class="list-group list-group-flush small">
                                            <li class="list-group-item d-flex justify-content-between">
                                                <span>Zona Mapa:</span>
                                                <strong>
                                                    <%= npc.map_zone %>
                                                </strong>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between">
                                                <span>Loja ID:</span>
                                                <strong>
                                                    <%= npc.shop_id || '-' %>
                                                </strong>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between">
                                                <span>Aventuras:</span>
                                                <strong>
                                                    <%= npc.starts_adventure_ids || '-' %>
                                                </strong>
                                            </li>
                                        </ul>
                        </div>
                    </div>
                </div>

                <!-- Coluna Direita -->
                <div class="col-md-8">

                    <!-- Atributos -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white fw-bold d-flex justify-content-between">
                            <span>Características de Combate</span>
                            <span class="badge bg-dark">
                                <%= npc.difficulty %>
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-4 col-md-2">
                                    <div class="stat-box">
                                        <div class="stat-value">
                                            <%= npc.stat_strength %>
                                        </div>
                                        <div class="stat-label">FOR</div>
                                    </div>
                                </div>
                                <div class="col-4 col-md-2">
                                    <div class="stat-box">
                                        <div class="stat-value">
                                            <%= npc.stat_dexterity %>
                                        </div>
                                        <div class="stat-label">DES</div>
                                    </div>
                                </div>
                                <div class="col-4 col-md-2">
                                    <div class="stat-box">
                                        <div class="stat-value">
                                            <%= npc.stat_constitution %>
                                        </div>
                                        <div class="stat-label">CON</div>
                                    </div>
                                </div>
                                <div class="col-4 col-md-2">
                                    <div class="stat-box">
                                        <div class="stat-value">
                                            <%= npc.stat_intelligence %>
                                        </div>
                                        <div class="stat-label">INT</div>
                                    </div>
                                </div>
                                <div class="col-4 col-md-2">
                                    <div class="stat-box">
                                        <div class="stat-value">
                                            <%= npc.stat_reasoning %>
                                        </div>
                                        <div class="stat-label">RAC</div>
                                    </div>
                                </div>
                                <div class="col-4 col-md-2">
                                    <div class="stat-box">
                                        <div class="stat-value">
                                            <%= npc.stat_luck %>
                                        </div>
                                        <div class="stat-label">SOR</div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <strong>Participa de Batalha:</strong>
                                <%= npc.participates_in_battle ? 'Sim ✅' : 'Não ❌' %>
                                    <span class="ms-3"><strong>Afinidade Matemática:</strong>
                                        <%= npc.math_affinity %>
                                    </span>
                            </div>
                        </div>
                    </div>

                    <!-- Diálogos -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white fw-bold">Diálogos</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="text-muted small">Apresentação</label>
                                <div class="p-2 bg-light rounded fst-italic">"<%= npc.dialogue_greeting || '...' %>"
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="text-muted small">Despedida</label>
                                <div class="p-2 bg-light rounded fst-italic">"<%= npc.dialogue_farewell || '...' %>"
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="text-muted small">Sucesso</label>
                                    <div class="p-2 bg-success bg-opacity-10 rounded fst-italic">"<%=
                                            npc.dialogue_success || '...' %>"</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small">Falha</label>
                                    <div class="p-2 bg-danger bg-opacity-10 rounded fst-italic">"<%=
                                            npc.dialogue_failure || '...' %>"</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Integrações -->
                    <div class="card shadow-sm">
                        <div class="card-header bg-white fw-bold">Integrações Futuras</div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item"><strong>Linked Shop Key:</strong>
                                    <%= npc.linked_shop_key || '-' %>
                                </li>
                                <li class="list-group-item"><strong>Linked Adventure Keys:</strong>
                                    <%= npc.linked_adventure_keys || '-' %>
                                </li>
                                <li class="list-group-item"><strong>Linked Quiz Discipline:</strong>
                                    <%= npc.linked_quiz_discipline || '-' %>
                                </li>
                                <li class="list-group-item"><strong>Special Reward Info:</strong>
                                    <%= npc.special_reward_info || '-' %>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>