<h1 class="admin-page-title">NPCs</h1>

<p class="admin-page-subtitle">
    Gerencie os personagens não jogáveis (NPCs) que aparecem nas cenas e histórias do Lutaver.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de NPCs</h2>
        <a href="/admin/npcs/new" class="admin-card-link">+ Novo NPC</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Função</th>
                <th>Humor</th>
                <th>Local</th>
                <th>Ativo?</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (npcs && npcs.length> 0) { %>
                <% npcs.forEach(n=> { %>
                    <tr>
                        <td>
                            <%= n.id %>
                        </td>
                        <td>
                            <%= n.name || n.npcName %>
                        </td>

                        <td>
                            <%= n.npc_type || n.npcType || '-' %>
                        </td>

                        <td>
                            <%= n.role || '-' %>
                        </td>

                        <td>
                            <%= n.mood || n.npcMood || '-' %>
                        </td>

                        <td>
                            <%= n.location || '-' %>
                        </td>

                        <td>
                            <% if (typeof n.is_active !=='undefined' ) { %>
                                <%= n.is_active ? 'Sim' : 'Não' %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <a href="/admin/npcs/<%= n.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/npcs/<%= n.id %>/delete"
                                class="admin-table-action admin-table-action-danger">
                                Remover
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="admin-table-empty">
                                    Nenhum NPC cadastrado.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>