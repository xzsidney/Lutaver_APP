<h1 class="admin-page-title">NPCs</h1>
<p class="admin-page-subtitle">
    Cadastro de novo NPC
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Novo NPC</h2>
        <a href="/admin/npcs" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="admin-alert admin-alert-error">
            <%= error %>
        </div>
        <% } %>

            <form action="/admin/npcs" method="POST" class="admin-form">
                <div class="admin-form-grid">
                    <!-- Nome -->
                    <div class="admin-form-group">
                        <label for="name">Nome do NPC</label>
                        <input type="text" id="name" name="name" class="admin-input" placeholder="Ex: Professor Silva"
                            required>
                    </div>

                    <!-- Papel -->
                    <div class="admin-form-group">
                        <label for="role">Papel</label>
                        <select id="role" name="role" class="admin-input" required>
                            <option value="professor">👨‍🏫 Professor</option>
                            <option value="aluno">👦 Aluno</option>
                            <option value="funcionario">👷 Funcionário</option>
                            <option value="comerciante">🛒 Comerciante</option>
                            <option value="outro">🧑 Outro</option>
                        </select>
                    </div>

                    <!-- Humor -->
                    <div class="admin-form-group">
                        <label for="mood">Humor</label>
                        <select id="mood" name="mood" class="admin-input">
                            <option value="amigavel">😊 Amigável</option>
                            <option value="neutro">😐 Neutro</option>
                            <option value="severo">😠 Severo</option>
                            <option value="misterioso">🤔 Misterioso</option>
                        </select>
                    </div>

                    <!-- Avatar/Emoji -->
                    <div class="admin-form-group">
                        <label for="avatar">Avatar/Emoji</label>
                        <input type="text" id="avatar" name="avatar" class="admin-input" placeholder="👨‍🏫"
                            maxlength="10">
                        <span class="admin-field-hint">
                            Emoji ou código do avatar
                        </span>
                    </div>

                    <!-- Descrição -->
                    <div class="admin-form-group admin-form-group-inline">
                        <label for="description">Descrição</label>
                        <textarea id="description" name="description" class="admin-input" rows="3"
                            placeholder="Descreva a personalidade e função deste NPC..."></textarea>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a href="/admin/npcs" class="admin-btn admin-btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="admin-btn admin-btn-primary">
                        Salvar
                    </button>
                </div>
            </form>
</section>