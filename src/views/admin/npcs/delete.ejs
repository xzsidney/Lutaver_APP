<h1 class="admin-page-title">NPCs</h1>
<p class="admin-page-subtitle">
    Confirmação de exclusão
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Excluir NPC</h2>
        <a href="/admin/npcs" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <div class="admin-alert admin-alert-error" style="margin-bottom: 1.5rem;">
        <strong>⚠️ Atenção!</strong><br>
        Tem certeza que deseja excluir este NPC?<br>
        <b>Esta ação é permanente e poderá impactar cenas e histórias que usam este personagem.</b>
    </div>

    <div class="admin-table-card" style="margin-bottom: 1.5rem;">
        <h3 style="margin-top: 0; font-size: 1.1rem;">Dados do NPC</h3>
        <div style="line-height: 1.8; margin-top: .5rem;">
            <p><strong>Nome:</strong>
                <%= npc.name %>
            </p>
            <% if (npc.avatar) { %>
                <p><strong>Avatar:</strong>
                    <%= npc.avatar %>
                </p>
                <% } %>
                    <p><strong>Papel:</strong>
                        <%= npc.role %>
                    </p>
                    <p><strong>Humor:</strong>
                        <%= npc.mood || 'Neutro' %>
                    </p>
                    <% if (npc.description) { %>
                        <p><strong>Descrição:</strong>
                            <%= npc.description %>
                        </p>
                        <% } %>
        </div>
    </div>

    <form action="/admin/npcs/<%= npc.id %>/delete" method="POST">
        <div class="admin-form-actions">
            <a href="/admin/npcs" class="admin-btn admin-btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="admin-btn admin-btn-danger">
                🗑️ Confirmar Exclusão
            </button>
        </div>
    </form>
</section>