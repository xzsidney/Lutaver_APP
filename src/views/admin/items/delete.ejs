<h1 class="admin-page-title">Itens</h1>
<p class="admin-page-subtitle">
    Confirmação de exclusão
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Excluir Item</h2>
        <a href="/admin/items" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <div class="admin-alert admin-alert-error" style="margin-bottom: 1.5rem;">
        <strong>⚠️ Atenção!</strong><br>
        Tem certeza que deseja excluir este item?<br>
        <b>Esta ação é permanente e removerá o item dos inventários de todos os personagens.</b>
    </div>

    <div class="admin-table-card" style="margin-bottom: 1.5rem;">
        <h3 style="margin-top: 0; font-size: 1.1rem;">Dados do Item</h3>
        <div style="line-height: 1.8; margin-top: .5rem;">
            <p><strong>Nome:</strong>
                <%= item.name %>
            </p>
            <% if (item.description) { %>
                <p><strong>Descrição:</strong>
                    <%= item.description %>
                </p>
                <% } %>
                    <p><strong>Tipo:</strong>
                        <%= item.type %>
                    </p>
                    <p><strong>Preço:</strong>
                        <%= item.price || 0 %> moedas
                    </p>
                    <p><strong>Consumível:</strong>
                        <%= item.is_consumable ? 'Sim' : 'Não' %>
                    </p>
        </div>
    </div>

    <form action="/admin/items/<%= item.id %>/delete" method="POST">
        <div class="admin-form-actions">
            <a href="/admin/items" class="admin-btn admin-btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="admin-btn admin-btn-danger">
                🗑️ Confirmar Exclusão
            </button>
        </div>
    </form>
</section>