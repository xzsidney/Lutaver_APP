<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/navbar', { page: 'items' }) %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2 text-primary fw-bold">
                    <i class="bi bi-box-seam"></i> Gerenciar Itens
                </h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="/admin/items/new" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-lg"></i> Novo Item
                    </a>
                </div>
            </div>

            <!-- Filters -->
            <div class="card card-custom border-0 shadow-sm mb-3">
                <div class="card-body p-3">
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/admin/items"
                            class="btn btn-sm <%= !filters.type ? 'btn-primary' : 'btn-outline-secondary' %>">
                            Todos
                        </a>
                        <a href="/admin/items?type=consumable"
                            class="btn btn-sm <%= filters.type === 'consumable' ? 'btn-primary' : 'btn-outline-secondary' %>">
                            🧪 Consumíveis
                        </a>
                        <a href="/admin/items?type=equipment"
                            class="btn btn-sm <%= filters.type === 'equipment' ? 'btn-primary' : 'btn-outline-secondary' %>">
                            🛡️ Equipamentos
                        </a>
                        <a href="/admin/items?type=key"
                            class="btn btn-sm <%= filters.type === 'key' ? 'btn-primary' : 'btn-outline-secondary' %>">
                            🔑 Chaves
                        </a>
                        <a href="/admin/items?type=cosmetic"
                            class="btn btn-sm <%= filters.type === 'cosmetic' ? 'btn-primary' : 'btn-outline-secondary' %>">
                            ✨ Cosméticos
                        </a>
                    </div>
                </div>
            </div>

            <div class="card card-custom border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th scope="col" class="ps-4">Ícone</th>
                                    <th scope="col">Nome</th>
                                    <th scope="col">Tipo</th>
                                    <th scope="col">Raridade</th>
                                    <th scope="col">Preço</th>
                                    <th scope="col">Slot</th>
                                    <th scope="col" class="text-end pe-4">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (items.length===0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-5 text-muted">
                                            <i class="bi bi-box-seam display-4 d-block mb-3 opacity-50"></i>
                                            Nenhum item cadastrado ainda.
                                        </td>
                                    </tr>
                                    <% } else { %>
                                        <% items.forEach(item=> { %>
                                            <tr>
                                                <td class="ps-4">
                                                    <span class="fs-3">
                                                        <%= item.icon %>
                                                    </span>
                                                </td>
                                                <td class="fw-bold text-dark">
                                                    <%= item.name %>
                                                        <% if (item.is_unique) { %>
                                                            <span class="badge bg-warning text-dark ms-1">Único</span>
                                                            <% } %>
                                                                <% if (item.stackable) { %>
                                                                    <span class="badge bg-info text-dark ms-1">x<%=
                                                                            item.max_stack %></span>
                                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% let typeIcon='📦' ; let typeName=item.type; if
                                                        (item.type==='consumable' ) { typeIcon='🧪' ;
                                                        typeName='Consumível' ; } if (item.type==='equipment' ) {
                                                        typeIcon='🛡️' ; typeName='Equipamento' ; } if
                                                        (item.type==='key' ) { typeIcon='🔑' ; typeName='Chave' ; } if
                                                        (item.type==='cosmetic' ) { typeIcon='✨' ; typeName='Cosmético'
                                                        ; } %>
                                                        <span>
                                                            <%= typeIcon %>
                                                                <%= typeName %>
                                                        </span>
                                                </td>
                                                <td>
                                                    <% let rarityClass='secondary' ; if (item.rarity==='raro' )
                                                        rarityClass='primary' ; if (item.rarity==='épico' )
                                                        rarityClass='purple' ; if (item.rarity==='lendário' )
                                                        rarityClass='warning' ; %>
                                                        <span class="badge bg-<%= rarityClass %> rounded-pill"
                                                            style="<%= item.rarity === 'épico' ? 'background-color: #6f42c1 !important;' : '' %>">
                                                            <%= item.rarity %>
                                                        </span>
                                                </td>
                                                <td>
                                                    <span class="text-warning fw-bold">🪙 <%= item.price %></span>
                                                </td>
                                                <td>
                                                    <% if (item.slot) { %>
                                                        <span class="badge bg-light text-dark border">
                                                            <%= item.slot %>
                                                        </span>
                                                        <% } else { %>
                                                            <span class="text-muted">-</span>
                                                            <% } %>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <a href="/admin/items/<%= item.id %>/edit"
                                                        class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form action="/admin/items/<%= item.id %>/delete" method="POST"
                                                        class="d-inline"
                                                        onsubmit="return confirm('Tem certeza que deseja excluir este item?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            title="Excluir">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/footer') %>