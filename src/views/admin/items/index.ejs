<h1 class="admin-page-title">Itens</h1>

<p class="admin-page-subtitle">
    Gerencie os itens que podem ser comprados, encontrados ou recebidos como recompensa nas aventuras.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de itens</h2>
        <a href="/admin/items/new" class="admin-card-link">+ Novo item</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Preço</th>
                <th>Raridade</th>
                <th>Efeito</th>
                <th>Consumível?</th>
                <th>Ativo?</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (items && items.length> 0) { %>
                <% items.forEach(i=> { %>
                    <tr>
                        <td>
                            <%= i.id %>
                        </td>
                        <td>
                            <%= i.name %>
                        </td>

                        <td>
                            <% if (typeof i.price !=='undefined' && i.price !==null) { %>
                                <%= i.price %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (typeof i.rarity !=='undefined' && i.rarity) { %>
                                <%= i.rarity %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (i.effect) { %>
                                <%= i.effect.name %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (typeof i.is_consumable !=='undefined' ) { %>
                                <%= i.is_consumable ? 'Sim' : 'Não' %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (typeof i.is_active !=='undefined' ) { %>
                                <%= i.is_active ? 'Sim' : 'Não' %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <a href="/admin/items/<%= i.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/items/<%= i.id %>/delete"
                                class="admin-table-action admin-table-action-danger">
                                Remover
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="admin-table-empty">
                                    Nenhum item cadastrado.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>