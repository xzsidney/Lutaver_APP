<h1 class="admin-page-title">Usuários</h1>
<p class="admin-page-subtitle">
    Cadastro de novo usuário
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Novo Usuário</h2>
        <a href="/admin/users" class="admin-card-link">← Voltar para a lista</a>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="admin-alert admin-alert-error">
            <%= error %>
        </div>
        <% } %>

            <form action="/admin/users" method="POST" class="admin-form">
                <div class="admin-form-grid">
                    <!-- Nome -->
                    <div class="admin-form-group">
                        <label for="name">Nome Completo</label>
                        <input type="text" id="name" name="name" required placeholder="Ex: Ana Souza"
                            class="admin-input">
                    </div>

                    <!-- E-mail -->
                    <div class="admin-form-group">
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" required placeholder="exemplo@escola.com"
                            class="admin-input">
                    </div>

                    <!-- Senha -->
                    <div class="admin-form-group">
                        <label for="password">Senha</label>
                        <input type="password" id="password" name="password" required
                            placeholder="Defina uma senha segura" class="admin-input">
                        <small class="admin-field-hint">
                            A senha poderá ser alterada depois pelo próprio usuário.
                        </small>
                    </div>

                    <!-- Função -->
                    <div class="admin-form-group">
                        <label for="role">Função</label>
                        <select id="role" name="role" class="admin-input">
                            <option value="player">Aluno</option>
                            <option value="teacher">Professor</option>
                            <option value="admin">Administrador</option>
                        </select>
                    </div>

                    <!-- Usuário ativo -->
                    <div class="admin-form-group admin-form-group-inline">
                        <label class="admin-checkbox-label">
                            <input type="checkbox" name="is_active" checked>
                            Usuário Ativo
                        </label>
                        <small class="admin-field-hint">
                            Desmarque se quiser criar o usuário, mas ainda não liberar o acesso.
                        </small>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a href="/admin/users" class="admin-btn admin-btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="admin-btn admin-btn-primary">
                        Salvar
                    </button>
                </div>
            </form>
</section>