<h1 class="admin-page-title">Usuários</h1>

<p class="admin-page-subtitle">
    Edição de usuário
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Editar Usuário</h2>

        <a href="/admin/users" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <% if (error) { %>
        <div class="admin-alert admin-alert-error">
            <%= error %>
        </div>
        <% } %>

            <form action="/admin/users/<%= user.id %>" method="POST" class="admin-form">
                <div class="admin-form-grid">
                    <!-- Nome -->
                    <div class="admin-form-group">
                        <label for="name">Nome Completo</label>
                        <input type="text" id="name" name="name" class="admin-input" value="<%= user.name %>" required>
                    </div>

                    <!-- E-mail -->
                    <div class="admin-form-group">
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" class="admin-input" value="<%= user.email %>"
                            required>
                    </div>

                    <!-- Nova senha -->
                    <div class="admin-form-group">
                        <label for="password">Nova Senha</label>
                        <input type="password" id="password" name="password" class="admin-input" minlength="6">
                        <span class="admin-field-hint">
                            Deixe em branco para não alterar a senha.
                        </span>
                    </div>

                    <!-- Função -->
                    <div class="admin-form-group">
                        <label for="role">Função</label>
                        <select id="role" name="role" class="admin-input" required>
                            <option value="player" <%=user.role==='player' ? 'selected' : '' %>>Aluno</option>
                            <option value="teacher" <%=user.role==='teacher' ? 'selected' : '' %>>Professor</option>
                            <option value="admin" <%=user.role==='admin' ? 'selected' : '' %>>Administrador</option>
                        </select>
                    </div>

                    <!-- Usuário ativo -->
                    <div class="admin-form-group admin-form-group-inline">
                        <label class="admin-checkbox-label">
                            <input type="checkbox" id="is_active" name="is_active" <%=user.is_active ? 'checked' : '' %>
                            >
                            Usuário Ativo
                        </label>
                        <span class="admin-field-hint">
                            Desmarque se quiser manter o cadastro, mas bloquear o acesso ao sistema.
                        </span>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a href="/admin/users" class="admin-btn admin-btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="admin-btn admin-btn-primary">
                        Salvar
                    </button>
                </div>
            </form>
</section>