<h1 class="admin-page-title">Usuários</h1>

<p class="admin-page-subtitle">
    Gerencie as contas de alunos, professores e administradores do sistema Lutaver.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de usuários</h2>
        <a href="/admin/users/new" class="admin-card-link">+ Novo usuário</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Papel</th>
                <th>Ativo?</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (users && users.length> 0) { %>
                <% users.forEach(u=> { %>
                    <tr>
                        <td>
                            <%= u.id %>
                        </td>
                        <td>
                            <%= u.name %>
                        </td>
                        <td>
                            <%= u.email %>
                        </td>
                        <td>
                            <%= u.role %>
                        </td>
                        <td>
                            <%= u.is_active ? 'Sim' : 'Não' %>
                        </td>
                        <td>
                            <a href="/admin/users/<%= u.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/users/<%= u.id %>/delete"
                                class="admin-table-action admin-table-action-danger">Remover</a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="admin-table-empty">
                                    Nenhum usuário cadastrado.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>