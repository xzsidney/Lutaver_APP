<h1 class="admin-page-title">Histórias</h1>
<p class="admin-page-subtitle">
    Confirmação de exclusão
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Excluir História</h2>
        <a href="/admin/stories" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <div class="admin-alert admin-alert-error" style="margin-bottom: 1.5rem;">
        <strong>⚠️ Atenção!</strong><br>
        Tem certeza que deseja excluir esta história?<br>
        <b>Esta ação é permanente e removerá todas as cenas e escolhas relacionadas.</b>
    </div>

    <div class="admin-table-card" style="margin-bottom: 1.5rem;">
        <h3 style="margin-top: 0; font-size: 1.1rem;">Dados da História</h3>
        <div style="line-height: 1.8; margin-top: .5rem;">
            <p><strong>Título:</strong>
                <%= story.title %>
            </p>
            <% if (story.synopsis) { %>
                <p><strong>Sinopse:</strong>
                    <%= story.synopsis.substring(0, 200) %>
                        <%= story.synopsis.length> 200 ? '...' : '' %>
                </p>
                <% } %>
                    <p><strong>Nível Recomendado:</strong>
                        <%= story.recommended_level || 1 %>
                    </p>
                    <p><strong>Recompensa XP:</strong>
                        <%= story.reward_xp || 0 %>
                    </p>
                    <p><strong>Recompensa Moedas:</strong>
                        <%= story.reward_coins || 0 %>
                    </p>
                    <p><strong>Status:</strong>
                        <%= story.is_active ? 'Ativa' : 'Inativa' %>
                    </p>
        </div>
    </div>

    <form action="/admin/stories/<%= story.id %>/delete" method="POST">
        <div class="admin-form-actions">
            <a href="/admin/stories" class="admin-btn admin-btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="admin-btn admin-btn-danger">
                🗑️ Confirmar Exclusão
            </button>
        </div>
    </form>
</section>