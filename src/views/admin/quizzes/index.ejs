<h1 class="admin-page-title">Quizzes</h1>

<p class="admin-page-subtitle">
    Gerencie os quizzes que os alunos irão responder na Torre do Saber.
    Cada quiz pode estar ligado a uma disciplina e ter nível de dificuldade.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de quizzes</h2>
        <a href="/admin/quizzes/new" class="admin-card-link">+ Novo quiz</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Disciplina</th>
                <th>Dificuldade</th>
                <th>Ano</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (quizzes && quizzes.length> 0) { %>
                <% quizzes.forEach(q=> { %>
                    <tr>
                        <td>
                            <%= q.id %>
                        </td>
                        <td>
                            <%= q.title %>
                        </td>
                        <td>
                            <%= q.discipline ? q.discipline.name : '-' %>
                        </td>
                        <td>
                            <% if (typeof q.difficulty !=='undefined' && q.difficulty !==null) { %>
                                <%= q.difficulty %>/5
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>
                        <td>
                            <% if (q.school_year) { %>
                                <%= q.school_year %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>
                        <td>
                            <a href="/admin/quizzes/<%= q.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/quizzes/<%= q.id %>/delete"
                                class="admin-table-action admin-table-action-danger">Remover</a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="admin-table-empty">
                                    Nenhum quiz cadastrado.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>