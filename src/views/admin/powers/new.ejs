<h1 class="admin-page-title">Poderes</h1>
<p class="admin-page-subtitle">
    Cadastro de novo poder
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Novo Poder</h2>
        <a href="/admin/powers" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="admin-alert admin-alert-error">
            <%= error %>
        </div>
        <% } %>

            <form action="/admin/powers" method="POST" class="admin-form">
                <div class="admin-form-grid">
                    <!-- Nome -->
                    <div class="admin-form-group">
                        <label for="name">Nome do Poder</label>
                        <input type="text" id="name" name="name" class="admin-input"
                            placeholder="Ex: Raio de Conhecimento" required>
                    </div>

                    <!-- Tipo de Poder -->
                    <div class="admin-form-group">
                        <label for="power_type">Tipo de Poder</label>
                        <select id="power_type" name="power_type" class="admin-input" required>
                            <option value="ataque">⚔️ Ataque</option>
                            <option value="defesa">🛡️ Defesa</option>
                            <option value="suporte">✨ Suporte</option>
                            <option value="cura">💚 Cura</option>
                        </select>
                    </div>

                    <!-- Disciplina -->
                    <div class="admin-form-group">
                        <label for="discipline_id">ID da Disciplina</label>
                        <input type="number" id="discipline_id" name="discipline_id" class="admin-input"
                            placeholder="ID da disciplina" required>
                    </div>

                    <!-- Custo de Mana -->
                    <div class="admin-form-group">
                        <label for="cost_mana">Custo de Mana</label>
                        <input type="number" id="cost_mana" name="cost_mana" class="admin-input" min="0"
                            placeholder="10" value="10">
                    </div>

                    <!-- Cooldown -->
                    <div class="admin-form-group">
                        <label for="cooldown_turns">Cooldown (Turnos)</label>
                        <input type="number" id="cooldown_turns" name="cooldown_turns" class="admin-input" min="0"
                            placeholder="2" value="0">
                        <span class="admin-field-hint">
                            Turnos de espera para usar novamente
                        </span>
                    </div>

                    <!-- Potência -->
                    <div class="admin-form-group">
                        <label for="potency">Potência</label>
                        <input type="number" id="potency" name="potency" class="admin-input" placeholder="50"
                            value="50">
                    </div>

                    <!-- Descrição -->
                    <div class="admin-form-group admin-form-group-inline">
                        <label for="description">Descrição</label>
                        <textarea id="description" name="description" class="admin-input" rows="3"
                            placeholder="Descreva o efeito deste poder..."></textarea>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a href="/admin/powers" class="admin-btn admin-btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="admin-btn admin-btn-primary">
                        Salvar
                    </button>
                </div>
            </form>
</section>