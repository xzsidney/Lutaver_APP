<h1 class="admin-page-title">Poderes</h1>
<p class="admin-page-subtitle">
    Confirmação de exclusão
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Excluir Poder</h2>
        <a href="/admin/powers" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <div class="admin-alert admin-alert-error" style="margin-bottom: 1.5rem;">
        <strong>⚠️ Atenção!</strong><br>
        Tem certeza que deseja excluir este poder?<br>
        <b>Esta ação é permanente e removerá o poder de todos os personagens que o possuem.</b>
    </div>

    <div class="admin-table-card" style="margin-bottom: 1.5rem;">
        <h3 style="margin-top: 0; font-size: 1.1rem;">Dados do Poder</h3>
        <div style="line-height: 1.8; margin-top: .5rem;">
            <p><strong>Nome:</strong>
                <%= power.name %>
            </p>
            <% if (power.description) { %>
                <p><strong>Descrição:</strong>
                    <%= power.description %>
                </p>
                <% } %>
                    <p><strong>Tipo:</strong>
                        <%= power.power_type %>
                    </p>
                    <p><strong>Custo de Mana:</strong>
                        <%= power.cost_mana || 0 %>
                    </p>
                    <p><strong>Cooldown:</strong>
                        <%= power.cooldown_turns || 0 %> turnos
                    </p>
                    <p><strong>Potência:</strong>
                        <%= power.potency || 0 %>
                    </p>
        </div>
    </div>

    <form action="/admin/powers/<%= power.id %>/delete" method="POST">
        <div class="admin-form-actions">
            <a href="/admin/powers" class="admin-btn admin-btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="admin-btn admin-btn-danger">
                🗑️ Confirmar Exclusão
            </button>
        </div>
    </form>
</section>