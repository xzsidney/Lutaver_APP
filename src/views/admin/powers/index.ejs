<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/navbar', { page: 'powers' }) %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2 text-primary fw-bold">Gerenciar Poderes</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="/admin/powers/new" class="btn btn-sm btn-magic">
                        <i class="bi bi-plus-circle"></i> Novo Poder
                    </a>
                </div>
            </div>

            <div class="card card-custom">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 5%">Ícone</th>
                                    <th style="width: 25%">Nome</th>
                                    <th style="width: 15%">Disciplina</th>
                                    <th style="width: 15%">Afinidade Mín.</th>
                                    <th style="width: 30%">Efeito</th>
                                    <th style="width: 10%">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (powers.length===0) { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            Nenhum poder cadastrado ainda.
                                        </td>
                                    </tr>
                                    <% } else { %>
                                        <% powers.forEach(power=> { %>
                                            <tr>
                                                <td>
                                                    <span class="fs-4">
                                                        <%= power.icon %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-primary">
                                                        <%= power.name %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <% if (power.discipline) { %>
                                                        <span class="badge"
                                                            style="background-color: <%= power.discipline.color_theme %>; color: white;">
                                                            <%= power.discipline.name %>
                                                        </span>
                                                        <% } else { %>
                                                            <span class="badge bg-secondary">Geral</span>
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">
                                                        <%= power.required_affinity %>%
                                                    </span>
                                                </td>
                                                <td>
                                                    <small class="text-muted">
                                                        <%= power.effect %>
                                                    </small>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <a href="/admin/powers/<%= power.id %>/edit"
                                                            class="btn btn-outline-primary" title="Editar">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <form action="/admin/powers/<%= power.id %>/delete" method="POST"
                                                            class="d-inline"
                                                            onsubmit="return confirm('Tem certeza que deseja excluir este poder?');">
                                                            <button type="submit" class="btn btn-outline-danger"
                                                                title="Excluir">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/footer') %>