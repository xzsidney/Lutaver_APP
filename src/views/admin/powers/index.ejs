<h1 class="admin-page-title">Poderes</h1>

<p class="admin-page-subtitle">
    Gerencie os poderes que os personagens podem aprender nas disciplinas da Torre do Saber.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de poderes</h2>
        <a href="/admin/powers/new" class="admin-card-link">+ Novo poder</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Disciplina</th>
                <th>Tipo</th>
                <th>Custo (Mana)</th>
                <th>Cooldown</th>
                <th>Ativo?</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (powers && powers.length> 0) { %>
                <% powers.forEach(p=> { %>
                    <tr>
                        <td>
                            <%= p.id %>
                        </td>

                        <td>
                            <%= p.name %>
                        </td>

                        <td>
                            <%= p.discipline ? p.discipline.name : '-' %>
                        </td>

                        <td>
                            <% if (typeof p.power_type !=='undefined' && p.power_type) { %>
                                <%= p.power_type %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (typeof p.mana_cost !=='undefined' && p.mana_cost !==null) { %>
                                <%= p.mana_cost %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (typeof p.cooldown !=='undefined' && p.cooldown !==null) { %>
                                <%= p.cooldown %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <% if (typeof p.is_active !=='undefined' ) { %>
                                <%= p.is_active ? 'Sim' : 'Não' %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <td>
                            <a href="/admin/powers/<%= p.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/powers/<%= p.id %>/delete"
                                class="admin-table-action admin-table-action-danger">
                                Remover
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="admin-table-empty">
                                    Nenhum poder cadastrado.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>