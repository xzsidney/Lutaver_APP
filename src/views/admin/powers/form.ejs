<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/navbar', { page: 'powers' }) %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2 text-primary fw-bold">
                    <i class="bi bi-lightning-charge"></i>
                    <%= title %>
                </h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="/admin/powers" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card card-custom border-0 shadow-sm">
                        <div class="card-body p-4">
                            <form action="<%= action %>" method="POST" id="powerForm">
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <label for="name" class="form-label fw-bold">Nome do Poder</label>
                                        <input type="text" class="form-control" id="name" name="name"
                                            value="<%= power.name || '' %>" required placeholder="Ex: Bola de Fogo">
                                    </div>
                                    <div class="col-md-4">
                                        <label for="icon" class="form-label fw-bold">Ícone (Emoji)</label>
                                        <input type="text" class="form-control text-center" id="icon" name="icon"
                                            value="<%= power.icon || '⚡' %>" placeholder="⚡">
                                    </div>

                                    <div class="col-md-6">
                                        <label for="discipline_id" class="form-label fw-bold">Disciplina</label>
                                        <select class="form-select" id="discipline_id" name="discipline_id" required>
                                            <option value="" disabled <%=!power.discipline_id ? 'selected' : '' %>
                                                >Selecione...</option>
                                            <% disciplines.forEach(discipline=> { %>
                                                <option value="<%= discipline.id %>"
                                                    <%=power.discipline_id===discipline.id ? 'selected' : '' %>>
                                                    <%= discipline.name %>
                                                </option>
                                                <% }); %>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="required_affinity" class="form-label fw-bold">Afinidade Mínima
                                            (%)</label>
                                        <input type="number" class="form-control" id="required_affinity"
                                            name="required_affinity" value="<%= power.required_affinity || 0 %>" min="0"
                                            max="100" required>
                                    </div>

                                    <div class="col-12">
                                        <label for="description" class="form-label fw-bold">Descrição</label>
                                        <textarea class="form-control" id="description" name="description" rows="3"
                                            required
                                            placeholder="Descrição geral do poder..."><%= power.description || '' %></textarea>
                                    </div>

                                    <div class="col-12">
                                        <label for="effect" class="form-label fw-bold">Efeito (Texto Descritivo)</label>
                                        <textarea class="form-control" id="effect" name="effect" rows="2" required
                                            placeholder="Descrição temática do efeito (flavor text)..."><%= power.effect || '' %></textarea>
                                        <div class="form-text">Este texto é apenas descritivo. A mecânica real é
                                            configurada abaixo.</div>
                                    </div>

                                    <!-- Effects Section -->
                                    <div class="col-12 mt-4">
                                        <h5 class="fw-bold border-bottom pb-2 mb-3">
                                            <i class="bi bi-stars"></i> Efeitos Mecânicos
                                        </h5>

                                        <div class="bg-light p-3 rounded mb-3">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">Efeito</label>
                                                    <select class="form-select form-select-sm" id="new_effect_id">
                                                        <option value="">Selecione um efeito...</option>
                                                        <% effects.forEach(eff=> { %>
                                                            <option value="<%= eff.id %>" data-name="<%= eff.name %>"
                                                                data-icon="<%= eff.icon %>">
                                                                <%= eff.icon %>
                                                                    <%= eff.name %> (<%= eff.effect_type %>)
                                                            </option>
                                                            <% }); %>
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label small fw-bold">Chance (%)</label>
                                                    <input type="number" class="form-control form-control-sm"
                                                        id="new_effect_chance" value="100" min="0" max="100">
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label small fw-bold">Override</label>
                                                    <input type="number" class="form-control form-control-sm"
                                                        id="new_effect_override" placeholder="Opcional">
                                                </div>
                                                <div class="col-md-2">
                                                    <button type="button" class="btn btn-sm btn-success w-100"
                                                        onclick="addEffect()">
                                                        <i class="bi bi-plus-lg"></i> Adicionar
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Efeito</th>
                                                        <th style="width: 100px;">Chance</th>
                                                        <th style="width: 100px;">Override</th>
                                                        <th style="width: 50px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="effectsTableBody">
                                                    <!-- Effects will be added here -->
                                                </tbody>
                                            </table>
                                        </div>
                                        <div id="emptyEffectsMsg" class="text-center text-muted small py-2">
                                            Nenhum efeito vinculado.
                                        </div>
                                    </div>

                                    <!-- Hidden input to store effects JSON -->
                                    <input type="hidden" id="power_effects" name="power_effects" value="">

                                    <div class="col-12 mt-4 text-end">
                                        <button type="submit" class="btn btn-primary px-4">
                                            <i class="bi bi-save"></i> Salvar Poder
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script>
            let currentEffects = [];

    // Initialize with existing effects if editing
    <% if (power.effects && power.effects.length > 0) { %>
                currentEffects = <% - JSON.stringify(power.effects.map(e => ({
                    effect_id: e.id,
                    name: e.name,
                    icon: e.icon,
                    chance: e.PowerEffect.chance,
                    override_value: e.PowerEffect.override_value
                }))) %>;
    <% } %>

                function renderEffects() {
                    const tbody = document.getElementById('effectsTableBody');
                    const emptyMsg = document.getElementById('emptyEffectsMsg');
                    const hiddenInput = document.getElementById('power_effects');

                    tbody.innerHTML = '';

                    if (currentEffects.length === 0) {
                        emptyMsg.style.display = 'block';
                    } else {
                        emptyMsg.style.display = 'none';
                        currentEffects.forEach((eff, index) => {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                    <td class="align-middle">
                        <span class="me-2">${eff.icon}</span> ${eff.name}
                    </td>
                    <td class="align-middle text-center">${eff.chance}%</td>
                    <td class="align-middle text-center">${eff.override_value || '-'}</td>
                    <td class="align-middle text-center">
                        <button type="button" class="btn btn-xs btn-outline-danger" onclick="removeEffect(${index})">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </td>
                `;
                            tbody.appendChild(tr);
                        });
                    }

                    // Update hidden input
                    hiddenInput.value = JSON.stringify(currentEffects);
                }

            function addEffect() {
                const select = document.getElementById('new_effect_id');
                const chanceInput = document.getElementById('new_effect_chance');
                const overrideInput = document.getElementById('new_effect_override');

                const effectId = select.value;
                if (!effectId) return;

                const option = select.options[select.selectedIndex];
                const name = option.getAttribute('data-name');
                const icon = option.getAttribute('data-icon');
                const chance = parseInt(chanceInput.value) || 100;
                const overrideValue = overrideInput.value ? parseInt(overrideInput.value) : null;

                // Check if already exists
                if (currentEffects.some(e => e.effect_id == effectId)) {
                    alert('Este efeito já foi adicionado.');
                    return;
                }

                currentEffects.push({
                    effect_id: effectId,
                    name: name,
                    icon: icon,
                    chance: chance,
                    override_value: overrideValue
                });

                renderEffects();

                // Reset inputs
                select.value = '';
                chanceInput.value = '100';
                overrideInput.value = '';
            }

            function removeEffect(index) {
                currentEffects.splice(index, 1);
                renderEffects();
            }

            // Initial render
            renderEffects();

            // Form submit handler to ensure JSON is up to date
            document.getElementById('powerForm').addEventListener('submit', function () {
                document.getElementById('power_effects').value = JSON.stringify(currentEffects);
            });
        </script>

        <%- include('../../partials/admin/footer') %>