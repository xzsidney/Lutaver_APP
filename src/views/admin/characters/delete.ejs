<h1 class="admin-page-title">Personagens</h1>
<p class="admin-page-subtitle">
    Confirmação de exclusão
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Excluir Personagem</h2>
        <a href="/admin/characters" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <div class="admin-alert admin-alert-error" style="margin-bottom: 1.5rem;">
        <strong>⚠️ Atenção!</strong><br>
        Tem certeza que deseja excluir este personagem?<br>
        <b>Esta ação é permanente e removerá todo o progresso, itens e conquistas do personagem.</b>
    </div>

    <div class="admin-table-card" style="margin-bottom: 1.5rem;">
        <h3 style="margin-top: 0; font-size: 1.1rem;">Dados do Personagem</h3>
        <div style="line-height: 1.8; margin-top: .5rem;">
            <p><strong>Nome:</strong>
                <%= character.name %>
            </p>
            <p><strong>Ano Escolar:</strong>
                <%= character.school_year %>º ano
            </p>
            <p><strong>Nível:</strong>
                <%= character.level || 1 %>
            </p>
            <p><strong>XP Total:</strong>
                <%= character.total_xp || 0 %>
            </p>
            <p><strong>Moedas:</strong>
                <%= character.coins || 0 %>
            </p>
        </div>
    </div>

    <form action="/admin/characters/<%= character.id %>/delete" method="POST">
        <div class="admin-form-actions">
            <a href="/admin/characters" class="admin-btn admin-btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="admin-btn admin-btn-danger">
                🗑️ Confirmar Exclusão
            </button>
        </div>
    </form>
</section>