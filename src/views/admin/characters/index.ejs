<h1 class="admin-page-title">Personagens</h1>

<p class="admin-page-subtitle">
    Lista de todos os personagens criados pelos jogadores no Lutaver.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de personagens</h2>
        <!-- Se quiser permitir criação manual pelo admin, deixa o botão abaixo -->
        <!-- <a href="/admin/characters/new" class="admin-card-link">+ Novo personagem</a> -->
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Jogador</th>
                <th>Série/Ano</th>
                <th>Nível</th>
                <th>XP Total</th>
                <th>Moedas</th>
                <th>Afinidades</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (characters && characters.length> 0) { %>
                <% characters.forEach(c=> { %>
                    <tr>
                        <td>
                            <%= c.id %>
                        </td>

                        <td>
                            <%= c.name %>
                        </td>

                        <!-- Jogador dono do personagem -->
                        <td>
                            <% if (c.user) { %>
                                <%= c.user.name %> (<%= c.user.email %>)
                                        <% } else { %>
                                            -
                                            <% } %>
                        </td>

                        <!-- Série / Ano escolar -->
                        <td>
                            <% if (typeof c.school_year !=='undefined' && c.school_year !==null) { %>
                                <%= c.school_year %>º ano
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <!-- Nível -->
                        <td>
                            <% if (typeof c.level !=='undefined' && c.level !==null) { %>
                                <%= c.level %>
                                    <% } else { %>
                                        1
                                        <% } %>
                        </td>

                        <!-- XP Total -->
                        <td>
                            <% if (typeof c.total_xp !=='undefined' && c.total_xp !==null) { %>
                                <%= c.total_xp %>
                                    <% } else { %>
                                        0
                                        <% } %>
                        </td>

                        <!-- Moedas -->
                        <td>
                            <% if (typeof c.coins !=='undefined' && c.coins !==null) { %>
                                <%= c.coins %>
                                    <% } else { %>
                                        0
                                        <% } %>
                        </td>

                        <!-- Afinidades principais -->
                        <td>
                            <% if (c.affinities && c.affinities.length> 0) { %>
                                <% c.affinities.slice(0, 2).forEach((a, idx)=> { %>
                                    <%= a.discipline ? a.discipline.name : 'Disciplina #' + a.discipline_id %>
                                        <% if (idx < c.affinities.slice(0, 2).length - 1) { %>, <% } %>
                                                <% }) %>
                                                    <% if (c.affinities.length> 2) { %>
                                                        (+<%= c.affinities.length - 2 %> outras)
                                                            <% } %>
                                                                <% } else { %>
                                                                    -
                                                                    <% } %>
                        </td>

                        <td>
                            <a href="/admin/characters/<%= c.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/characters/<%= c.id %>/delete"
                                class="admin-table-action admin-table-action-danger">
                                Remover
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" class="admin-table-empty">
                                    Nenhum personagem cadastrado.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>