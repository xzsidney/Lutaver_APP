<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/navbar', { page: 'characters' }) %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2 text-primary fw-bold">Detalhes do Personagem</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="/admin/characters" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                </div>
            </div>

            <div class="row">
                <!-- Character Info -->
                <div class="col-md-4 mb-4">
                    <div class="card card-custom h-100">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <div
                                    style="width: 100px; height: 100px; background-color: #eee; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 2rem;">
                                    👤
                                </div>
                            </div>
                            <h3 class="card-title fw-bold text-primary">
                                <%= character.name %>
                            </h3>
                            <p class="text-muted mb-1">Jogador: <%= character.user ? character.user.name
                                    : 'Desconhecido' %>
                            </p>
                            <p class="text-muted">
                                <%= character.school_year %>º Ano
                            </p>

                            <div class="d-flex justify-content-center gap-2 mb-3">
                                <span class="badge bg-warning text-dark p-2">Nível <%= character.level %></span>
                                <span class="badge bg-info text-dark p-2">
                                    <%= character.experience %> XP
                                </span>
                            </div>

                            <hr>

                            <div class="text-start">
                                <h6 class="fw-bold mb-3">Atributos</h6>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>💪 Força</span>
                                        <span class="badge bg-secondary rounded-pill">
                                            <%= character.strength %>
                                        </span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>🏃 Destreza</span>
                                        <span class="badge bg-secondary rounded-pill">
                                            <%= character.dexterity %>
                                        </span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>🛡️ Constituição</span>
                                        <span class="badge bg-secondary rounded-pill">
                                            <%= character.constitution %>
                                        </span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>🧠 Inteligência</span>
                                        <span class="badge bg-secondary rounded-pill">
                                            <%= character.intelligence %>
                                        </span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>💡 Raciocínio</span>
                                        <span class="badge bg-secondary rounded-pill">
                                            <%= character.reasoning %>
                                        </span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>🍀 Sorte</span>
                                        <span class="badge bg-secondary rounded-pill">
                                            <%= character.luck %>
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Affinities & Powers -->
                <div class="col-md-8">
                    <div class="card card-custom mb-4">
                        <div class="card-header bg-white fw-bold">Afinidades com Disciplinas</div>
                        <div class="card-body">
                            <div class="row">
                                <% if (character.affinities && character.affinities.length> 0) { %>
                                    <% character.affinities.forEach(aff=> { %>
                                        <div class="col-md-6 mb-3">
                                            <div class="d-flex align-items-center mb-1">
                                                <span class="me-2">
                                                    <%= aff.discipline.icon || '📚' %>
                                                </span>
                                                <span class="fw-bold flex-grow-1">
                                                    <%= aff.discipline.name %>
                                                </span>
                                                <span class="badge bg-primary">
                                                    <%= aff.affinity_level %>%
                                                </span>
                                            </div>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar" role="progressbar"
                                                    style="width: <%= aff.affinity_level %>%; background-color: <%= aff.discipline.color_theme %>;"
                                                    aria-valuenow="<%= aff.affinity_level %>" aria-valuemin="0"
                                                    aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <p class="text-muted">Nenhuma afinidade registrada.</p>
                                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="card card-custom">
                        <div class="card-header bg-white fw-bold">Poderes Adquiridos</div>
                        <div class="card-body">
                            <% if (character.powers && character.powers.length> 0) { %>
                                <div class="row">
                                    <% character.powers.forEach(power=> { %>
                                        <div class="col-md-6 mb-3">
                                            <div class="card h-100 border-0 shadow-sm"
                                                style="background-color: #f8f9fa;">
                                                <div class="card-body p-3">
                                                    <h6 class="card-title fw-bold mb-1">
                                                        <%= power.name %>
                                                    </h6>
                                                    <p class="card-text small text-muted mb-0">
                                                        <%= power.description %>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                                <% } else { %>
                                    <p class="text-muted text-center py-3">Este personagem ainda não aprendeu nenhum
                                        poder.</p>
                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/footer') %>