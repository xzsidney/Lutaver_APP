<%- include('../../partials/admin/header') %>
    <%- include('../../partials/admin/navbar', { page: 'scenes' }) %>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2 text-primary fw-bold">
                    <%= scene ? 'Editar Cena' : 'Nova Cena' %>
                </h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <a href="/admin/scenes" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card card-custom">
                        <div class="card-body p-4">
                            <% if (error) { %>
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <%= error %>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"
                                            aria-label="Close"></button>
                                </div>
                                <% } %>

                                    <form action="<%= scene ? '/admin/scenes/' + scene.id : '/admin/scenes' %>"
                                        method="POST">
                                        <div class="row mb-3">
                                            <div class="col-md-8">
                                                <label for="adventure_id" class="form-label fw-bold">Aventura</label>
                                                <select class="form-select" id="adventure_id" name="adventure_id"
                                                    required>
                                                    <option value="">Selecione...</option>
                                                    <% adventures.forEach(adv=> { %>
                                                        <option value="<%= adv.id %>" <%=(scene &&
                                                            scene.adventure_id===adv.id) ? 'selected' : '' %>>
                                                            <%= adv.title %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label for="order_index" class="form-label fw-bold">Ordem da
                                                    Cena</label>
                                                <input type="number" class="form-control" id="order_index"
                                                    name="order_index" value="<%= scene ? scene.order_index : '1' %>"
                                                    min="1" required>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="title" class="form-label fw-bold">Título da Cena</label>
                                            <input type="text" class="form-control" id="title" name="title"
                                                value="<%= scene ? scene.title : '' %>" required>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="npc_name" class="form-label fw-bold">Nome do NPC
                                                    (Opcional)</label>
                                                <input type="text" class="form-control" id="npc_name" name="npc_name"
                                                    value="<%= scene ? scene.npc_name : '' %>">
                                            </div>
                                            <div class="col-md-6">
                                                <label for="npc_mood" class="form-label fw-bold">Humor do NPC</label>
                                                <select class="form-select" id="npc_mood" name="npc_mood">
                                                    <option value="neutral" <%=(scene && scene.npc_mood==='neutral' )
                                                        ? 'selected' : '' %>>Neutro</option>
                                                    <option value="happy" <%=(scene && scene.npc_mood==='happy' )
                                                        ? 'selected' : '' %>>Feliz</option>
                                                    <option value="angry" <%=(scene && scene.npc_mood==='angry' )
                                                        ? 'selected' : '' %>>Bravo</option>
                                                    <option value="sad" <%=(scene && scene.npc_mood==='sad' )
                                                        ? 'selected' : '' %>>Triste</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="environment_description" class="form-label fw-bold">Descrição do
                                                Ambiente</label>
                                            <textarea class="form-control" id="environment_description"
                                                name="environment_description"
                                                rows="2"><%= scene ? scene.environment_description : '' %></textarea>
                                        </div>

                                        <div class="mb-3">
                                            <label for="scene_text" class="form-label fw-bold">Texto da Cena
                                                (Diálogo/Narrativa)</label>
                                            <textarea class="form-control" id="scene_text" name="scene_text" rows="4"
                                                required><%= scene ? scene.scene_text : '' %></textarea>
                                        </div>

                                        <hr class="my-4">
                                        <h5 class="text-primary mb-3">Desafio / Teste</h5>

                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <label for="test_type" class="form-label fw-bold">Tipo de Teste</label>
                                                <select class="form-select" id="test_type" name="test_type">
                                                    <option value="" <%=(!scene || !scene.test_type) ? 'selected' : ''
                                                        %>>Nenhum (Apenas Narrativa)</option>
                                                    <option value="Físico" <%=(scene && scene.test_type==='Físico' )
                                                        ? 'selected' : '' %>>Físico</option>
                                                    <option value="Mental" <%=(scene && scene.test_type==='Mental' )
                                                        ? 'selected' : '' %>>Mental</option>
                                                    <option value="Social" <%=(scene && scene.test_type==='Social' )
                                                        ? 'selected' : '' %>>Social</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label for="attribute_used" class="form-label fw-bold">Atributo
                                                    Usado</label>
                                                <select class="form-select" id="attribute_used" name="attribute_used">
                                                    <option value="" <%=(!scene || !scene.attribute_used) ? 'selected'
                                                        : '' %>>Nenhum</option>
                                                    <option value="strength" <%=(scene &&
                                                        scene.attribute_used==='strength' ) ? 'selected' : '' %>>Força
                                                    </option>
                                                    <option value="dexterity" <%=(scene &&
                                                        scene.attribute_used==='dexterity' ) ? 'selected' : '' %>
                                                        >Destreza</option>
                                                    <option value="intelligence" <%=(scene &&
                                                        scene.attribute_used==='intelligence' ) ? 'selected' : '' %>
                                                        >Inteligência</option>
                                                    <option value="charisma" <%=(scene &&
                                                        scene.attribute_used==='charisma' ) ? 'selected' : '' %>>Carisma
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label for="difficulty" class="form-label fw-bold">Dificuldade do
                                                    Teste</label>
                                                <input type="number" class="form-control" id="difficulty"
                                                    name="difficulty" value="<%= scene ? scene.difficulty : '0' %>"
                                                    min="0">
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="next_scene_success_id" class="form-label fw-bold">Próxima
                                                    Cena (Sucesso)</label>
                                                <select class="form-select" id="next_scene_success_id"
                                                    name="next_scene_success_id">
                                                    <option value="">Nenhuma (Fim ou Linear)</option>
                                                    <% otherScenes.forEach(s=> { %>
                                                        <option value="<%= s.id %>" <%=(scene &&
                                                            scene.next_scene_success_id===s.id) ? 'selected' : '' %>>
                                                            <%= s.order_index %> - <%= s.title %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="next_scene_failure_id" class="form-label fw-bold">Próxima
                                                    Cena (Falha)</label>
                                                <select class="form-select" id="next_scene_failure_id"
                                                    name="next_scene_failure_id">
                                                    <option value="">Nenhuma</option>
                                                    <% otherScenes.forEach(s=> { %>
                                                        <option value="<%= s.id %>" <%=(scene &&
                                                            scene.next_scene_failure_id===s.id) ? 'selected' : '' %>>
                                                            <%= s.order_index %> - <%= s.title %>
                                                        </option>
                                                        <% }); %>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="is_end_scene"
                                                    name="is_end_scene" <%=(scene && scene.is_end_scene) ? 'checked'
                                                    : '' %>>
                                                <label class="form-check-label" for="is_end_scene">
                                                    Esta é uma cena final (Encerra a aventura)
                                                </label>
                                            </div>
                                        </div>

                                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                            <button type="submit" class="btn btn-magic px-4">
                                                <i class="bi bi-save"></i> Salvar
                                            </button>
                                        </div>
                                    </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../../partials/admin/footer') %>