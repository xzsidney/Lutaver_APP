<h1 class="admin-page-title">Cenas</h1>
<p class="admin-page-subtitle">
    Edição de cena
</p>

<section class="admin-table-card admin-form-card">
    <div class="admin-table-header">
        <h2>Editar Cena</h2>
        <a href="/admin/scenes" class="admin-btn admin-btn-secondary" style="font-size: 0.8rem;">
            ← Voltar para a lista
        </a>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="admin-alert admin-alert-error">
            <%= error %>
        </div>
        <% } %>

            <form action="/admin/scenes/<%= scene.id %>" method="POST" class="admin-form">
                <div class="admin-form-grid">
                    <!-- Título -->
                    <div class="admin-form-group">
                        <label for="title">Título da Cena</label>
                        <input type="text" id="title" name="title" class="admin-input" value="<%= scene.title %>"
                            required>
                    </div>

                    <!-- ID da Aventura -->
                    <div class="admin-form-group">
                        <label for="adventure_id">ID da Aventura</label>
                        <input type="number" id="adventure_id" name="adventure_id" class="admin-input"
                            value="<%= scene.adventure_id %>" required>
                    </div>

                    <!-- Ordem -->
                    <div class="admin-form-group">
                        <label for="order_index">Ordem da Cena</label>
                        <input type="number" id="order_index" name="order_index" class="admin-input" min="1"
                            value="<%= scene.order_index || 1 %>">
                    </div>

                    <!-- Tipo de Cena -->
                    <div class="admin-form-group">
                        <label for="scene_type">Tipo de Cena</label>
                        <select id="scene_type" name="scene_type" class="admin-input">
                            <option value="narrativa" <%=scene.scene_type==='narrativa' ? 'selected' : '' %>>📖
                                Narrativa</option>
                            <option value="combate" <%=scene.scene_type==='combate' ? 'selected' : '' %>>⚔️ Combate
                            </option>
                            <option value="dialogo" <%=scene.scene_type==='dialogo' ? 'selected' : '' %>>💬 Diálogo
                            </option>
                            <option value="quiz" <%=scene.scene_type==='quiz' ? 'selected' : '' %>>❓ Quiz</option>
                        </select>
                    </div>

                    <!-- Descrição -->
                    <div class="admin-form-group admin-form-group-inline">
                        <label for="description">Descrição Narrativa</label>
                        <textarea id="description" name="description" class="admin-input"
                            rows="4"><%= scene.description || '' %></textarea>
                    </div>

                    <!-- Checkboxes -->
                    <div class="admin-form-group">
                        <label class="admin-checkbox-label">
                            <input type="checkbox" id="is_start" name="is_start" <%=scene.is_start ? 'checked' : '' %>>
                            Cena Inicial
                        </label>
                    </div>

                    <div class="admin-form-group">
                        <label class="admin-checkbox-label">
                            <input type="checkbox" id="is_end" name="is_end" <%=scene.is_end ? 'checked' : '' %>>
                            Cena Final
                        </label>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a href="/admin/scenes" class="admin-btn admin-btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="admin-btn admin-btn-primary">
                        Salvar
                    </button>
                </div>
            </form>
</section>