<h1 class="admin-page-title">Cenas</h1>

<p class="admin-page-subtitle">
    Gerencie as cenas usadas nas aventuras. Cada cena representa um passo
    da narrativa, com possíveis caminhos de sucesso e falha.
</p>

<section class="admin-table-card">
    <div class="admin-table-header">
        <h2>Lista de cenas</h2>
        <a href="/admin/scenes/new" class="admin-card-link">+ Nova cena</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Aventura</th>
                <th>Ordem</th>
                <th>Dificuldade</th>
                <th>Sucesso</th>
                <th>Falha</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (scenes && scenes.length> 0) { %>
                <% scenes.forEach(s=> { %>
                    <tr>
                        <td>
                            <%= s.id %>
                        </td>

                        <!-- Nome/título -->
                        <td>
                            <% const title=s.name || s.title || `Cena ${s.id}`; %>
                                <%= title %>
                        </td>

                        <!-- Aventura -->
                        <td>
                            <%= s.adventure ? s.adventure.name : '-' %>
                        </td>

                        <!-- Ordem (ou número da cena) -->
                        <td>
                            <% if (typeof s.order !=='undefined' && s.order !==null) { %>
                                <%= s.order %>
                                    <% } else if (typeof s.scene_number !=='undefined' && s.scene_number !==null) { %>
                                        <%= s.scene_number %>
                                            <% } else { %>
                                                -
                                                <% } %>
                        </td>

                        <!-- Dificuldade -->
                        <td>
                            <% if (typeof s.difficulty !=='undefined' && s.difficulty !==null) { %>
                                <%= s.difficulty %>
                                    <% } else { %>
                                        -
                                        <% } %>
                        </td>

                        <!-- Cenas de sucesso/falha -->
                        <td>
                            <% if (s.successScene) { %>
                                #<%= s.successScene.id %> - <%= s.successScene.name || s.successScene.title || '' %>
                                        <% } else if (s.success_scene_id) { %>
                                            #<%= s.success_scene_id %>
                                                <% } else { %>
                                                    -
                                                    <% } %>
                        </td>
                        <td>
                            <% if (s.failureScene) { %>
                                #<%= s.failureScene.id %> - <%= s.failureScene.name || s.failureScene.title || '' %>
                                        <% } else if (s.failure_scene_id) { %>
                                            #<%= s.failure_scene_id %>
                                                <% } else { %>
                                                    -
                                                    <% } %>
                        </td>

                        <td>
                            <a href="/admin/scenes/<%= s.id %>/edit" class="admin-table-action">Editar</a>
                            <a href="/admin/scenes/<%= s.id %>/delete"
                                class="admin-table-action admin-table-action-danger">
                                Remover
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="admin-table-empty">
                                    Nenhuma cena cadastrada.
                                </td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</section>