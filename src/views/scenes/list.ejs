<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cenas - <%= adventure.title %> - Lutaver</title>
    <link rel="stylesheet" href="/css/lutaver.css">
    <style>
        .scene-timeline {
            position: relative;
            padding-left: 40px;
        }

        .scene-timeline::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(to bottom, #1E90FF, #34D399);
        }

        .scene-item {
            position: relative;
            margin-bottom: 25px;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            border-left: 4px solid #F7D046;
        }

        .scene-item::before {
            content: attr(data-order);
            position: absolute;
            left: -40px;
            top: 20px;
            width: 30px;
            height: 30px;
            background: #1E90FF;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
        }

        .scene-item.ending {
            border-left-color: #34D399;
        }

        .scene-item.ending::before {
            background: #34D399;
            content: '🏁';
            font-size: 16px;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar', { user }) %>

        <div class="dashboard-container">
            <div class="header">
                <h1>📖 Cenas da Aventura</h1>
                <p><strong>
                        <%= adventure.title %>
                    </strong> - Gerencie a narrativa da aventura</p>
            </div>

            <div style="display: flex; gap: 10px; margin-bottom: 20px;">
                <a href="/adventures/<%= adventure.id %>/scenes/new" class="btn btn-primary">+ Nova Cena</a>
                <a href="/adventures" class="btn btn-secondary">← Voltar para Aventuras</a>
            </div>

            <% if (scenes.length===0) { %>
                <div
                    style="background: white; padding: 60px; border-radius: 10px; text-align: center; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 80px; margin-bottom: 20px;">📜</div>
                    <h3 style="color: #666; margin-bottom: 10px;">Nenhuma cena criada</h3>
                    <p style="color: #999;">Comece criando a primeira cena desta aventura!</p>
                    <a href="/adventures/<%= adventure.id %>/scenes/new" class="btn btn-primary"
                        style="margin-top: 20px;">Criar Primeira Cena</a>
                </div>
                <% } else { %>
                    <div class="scene-timeline">
                        <% scenes.forEach((scene, index)=> { %>
                            <div class="scene-item <%= scene.is_ending ? 'ending' : '' %>"
                                data-order="<%= scene.order_index %>">
                                <div
                                    style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                                    <div>
                                        <h3 style="color: #1E90FF; margin-bottom: 5px;">
                                            Cena <%= scene.order_index %>: <%= scene.title %>
                                        </h3>
                                        <% if (scene.is_ending) { %>
                                            <span class="badge badge-active">🏁 Cena Final</span>
                                            <% } %>
                                                <% if (scene.test_type !=='nenhum' ) { %>
                                                    <span class="badge" style="background: #F7D046; color: #1A1A1A;">
                                                        Teste: <%= scene.test_type.charAt(0).toUpperCase() +
                                                            scene.test_type.slice(1) %>
                                                    </span>
                                                    <% } %>
                                    </div>
                                    <div style="display: flex; gap: 5px;">
                                        <a href="/scenes/<%= scene.id %>/edit" class="btn btn-warning btn-sm">Editar</a>
                                        <form action="/scenes/<%= scene.id %>/delete" method="POST"
                                            style="display: inline;"
                                            onsubmit="return confirm('Tem certeza que deseja excluir esta cena?');">
                                            <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                                        </form>
                                    </div>
                                </div>

                                <div
                                    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;">
                                    <% if (scene.npc_name) { %>
                                        <div>
                                            <strong style="color: #666; font-size: 12px;">NPC:</strong>
                                            <p style="margin: 5px 0;">
                                                <%= scene.npc_name %> (<%= scene.npc_mood || 'neutro' %>)
                                            </p>
                                        </div>
                                        <% } %>
                                            <% if (scene.player_feeling) { %>
                                                <div>
                                                    <strong style="color: #666; font-size: 12px;">Sentimento do
                                                        Jogador:</strong>
                                                    <p style="margin: 5px 0;">
                                                        <%= scene.player_feeling %>
                                                    </p>
                                                </div>
                                                <% } %>
                                                    <% if (scene.test_type !=='nenhum' && scene.difficulty) { %>
                                                        <div>
                                                            <strong
                                                                style="color: #666; font-size: 12px;">Dificuldade:</strong>
                                                            <p style="margin: 5px 0; color: #F7D046;">
                                                                <% for(let i=0; i < scene.difficulty; i++) { %>⭐<% } %>
                                                            </p>
                                                        </div>
                                                        <% } %>
                                </div>

                                <% if (scene.environment_description) { %>
                                    <div
                                        style="background: #F9FAFB; padding: 10px; border-radius: 5px; margin-bottom: 10px;">
                                        <strong style="color: #666; font-size: 12px;">Ambiente:</strong>
                                        <p style="margin: 5px 0; font-style: italic;">
                                            <%= scene.environment_description %>
                                        </p>
                                    </div>
                                    <% } %>

                                        <div
                                            style="background: #F0F9FF; padding: 15px; border-radius: 5px; border-left: 3px solid #1E90FF;">
                                            <p style="line-height: 1.6; margin: 0;">
                                                <%= scene.scene_text %>
                                            </p>
                                        </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
        </div>
</body>

</html>