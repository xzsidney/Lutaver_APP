<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Cena - Lutaver</title>
    <link rel="stylesheet" href="/css/lutaver.css">
</head>

<body>
    <%- include('../partials/navbar', { user }) %>

        <div class="dashboard-container">
            <div class="header">
                <h1>📖 Editar Cena</h1>
                <p>Atualize a cena <strong>
                        <%= scene.title %>
                    </strong></p>
            </div>

            <div
                style="background: white; padding: 30px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); max-width: 1000px;">
                <% if (error) { %>
                    <div class="error-message">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/scenes/<%= scene.id %>" method="POST">
                            <!-- Informações Básicas -->
                            <fieldset
                                style="border: 2px solid #1E90FF; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                                <legend style="color: #1E90FF; font-weight: 600; padding: 0 10px;">📌 Informações
                                    Básicas</legend>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="order_index">Ordem da Cena *</label>
                                        <input type="number" id="order_index" name="order_index"
                                            value="<%= scene.order_index %>" required min="1">
                                    </div>

                                    <div class="form-group">
                                        <label for="title">Título da Cena *</label>
                                        <input type="text" id="title" name="title" value="<%= scene.title %>" required>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Personagens e Ambiente -->
                            <fieldset
                                style="border: 2px solid #F7D046; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                                <legend style="color: #F7D046; font-weight: 600; padding: 0 10px;">🎭 Personagens e
                                    Ambiente</legend>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="npc_name">Nome do NPC</label>
                                        <input type="text" id="npc_name" name="npc_name"
                                            value="<%= scene.npc_name || '' %>">
                                    </div>

                                    <div class="form-group">
                                        <label for="npc_mood">Humor do NPC</label>
                                        <select id="npc_mood" name="npc_mood">
                                            <option value="">Selecione</option>
                                            <option value="amigável" <%=scene.npc_mood==='amigável' ? 'selected' : '' %>
                                                >Amigável</option>
                                            <option value="neutro" <%=scene.npc_mood==='neutro' ? 'selected' : '' %>
                                                >Neutro</option>
                                            <option value="hostil" <%=scene.npc_mood==='hostil' ? 'selected' : '' %>
                                                >Hostil</option>
                                            <option value="misterioso" <%=scene.npc_mood==='misterioso' ? 'selected'
                                                : '' %>>Misterioso</option>
                                            <option value="preocupado" <%=scene.npc_mood==='preocupado' ? 'selected'
                                                : '' %>>Preocupado</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="player_feeling">Sentimento do Jogador</label>
                                    <input type="text" id="player_feeling" name="player_feeling"
                                        value="<%= scene.player_feeling || '' %>">
                                </div>

                                <div class="form-group">
                                    <label for="environment_description">Descrição do Ambiente</label>
                                    <textarea id="environment_description" name="environment_description"
                                        rows="2"><%= scene.environment_description || '' %></textarea>
                                </div>
                            </fieldset>

                            <!-- Narrativa -->
                            <fieldset
                                style="border: 2px solid #34D399; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                                <legend style="color: #34D399; font-weight: 600; padding: 0 10px;">📜 Narrativa</legend>

                                <div class="form-group">
                                    <label for="scene_text">Texto da Cena *</label>
                                    <textarea id="scene_text" name="scene_text" rows="6"
                                        required><%= scene.scene_text %></textarea>
                                </div>
                            </fieldset>

                            <!-- Sistema de Teste -->
                            <fieldset
                                style="border: 2px solid #9333EA; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                                <legend style="color: #9333EA; font-weight: 600; padding: 0 10px;">⚔️ Sistema de Teste
                                </legend>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="test_type">Tipo de Teste *</label>
                                        <select id="test_type" name="test_type" required
                                            onchange="toggleTestFields(this.value)">
                                            <option value="nenhum" <%=scene.test_type==='nenhum' ? 'selected' : '' %>
                                                >Nenhum</option>
                                            <option value="fisico" <%=scene.test_type==='fisico' ? 'selected' : '' %>
                                                >Físico</option>
                                            <option value="mental" <%=scene.test_type==='mental' ? 'selected' : '' %>
                                                >Mental</option>
                                            <option value="social" <%=scene.test_type==='social' ? 'selected' : '' %>
                                                >Social</option>
                                        </select>
                                    </div>

                                    <div class="form-group" id="difficulty-group"
                                        style="display: <%= scene.test_type !== 'nenhum' ? 'block' : 'none' %>;">
                                        <label for="difficulty">Dificuldade</label>
                                        <select id="difficulty" name="difficulty">
                                            <option value="">Selecione</option>
                                            <option value="1" <%=scene.difficulty===1 ? 'selected' : '' %>>⭐ Muito Fácil
                                            </option>
                                            <option value="2" <%=scene.difficulty===2 ? 'selected' : '' %>>⭐⭐ Fácil
                                            </option>
                                            <option value="3" <%=scene.difficulty===3 ? 'selected' : '' %>>⭐⭐⭐ Médio
                                            </option>
                                            <option value="4" <%=scene.difficulty===4 ? 'selected' : '' %>>⭐⭐⭐⭐ Difícil
                                            </option>
                                            <option value="5" <%=scene.difficulty===5 ? 'selected' : '' %>>⭐⭐⭐⭐⭐ Muito
                                                Difícil</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group" id="attribute-group"
                                    style="display: <%= scene.test_type !== 'nenhum' ? 'block' : 'none' %>;">
                                    <label for="attribute_used">Atributo Usado</label>
                                    <input type="text" id="attribute_used" name="attribute_used"
                                        value="<%= scene.attribute_used || '' %>">
                                </div>

                                <div class="form-row" id="branching-group"
                                    style="display: <%= scene.test_type !== 'nenhum' ? 'grid' : 'none' %>;">
                                    <div class="form-group">
                                        <label for="success_scene_id">Cena em Caso de Sucesso</label>
                                        <select id="success_scene_id" name="success_scene_id">
                                            <option value="">Nenhuma (fim)</option>
                                            <% existingScenes.forEach(s=> { %>
                                                <% if (s.id !==scene.id) { %>
                                                    <option value="<%= s.id %>" <%=scene.success_scene_id===s.id
                                                        ? 'selected' : '' %>>
                                                        Cena <%= s.order_index %>: <%= s.title %>
                                                    </option>
                                                    <% } %>
                                                        <% }); %>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label for="failure_scene_id">Cena em Caso de Falha</label>
                                        <select id="failure_scene_id" name="failure_scene_id">
                                            <option value="">Nenhuma (fim)</option>
                                            <% existingScenes.forEach(s=> { %>
                                                <% if (s.id !==scene.id) { %>
                                                    <option value="<%= s.id %>" <%=scene.failure_scene_id===s.id
                                                        ? 'selected' : '' %>>
                                                        Cena <%= s.order_index %>: <%= s.title %>
                                                    </option>
                                                    <% } %>
                                                        <% }); %>
                                        </select>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Opções -->
                            <div class="form-group">
                                <div class="checkbox-group">
                                    <input type="checkbox" id="is_ending" name="is_ending" <%=scene.is_ending
                                        ? 'checked' : '' %>>
                                    <label for="is_ending" style="margin: 0;">🏁 Esta é uma cena final da
                                        aventura?</label>
                                </div>
                            </div>

                            <div style="display: flex; gap: 10px; margin-top: 30px;">
                                <button type="submit" class="btn btn-success">Salvar Alterações</button>
                                <a href="/adventures/<%= scene.adventure_id %>/scenes"
                                    class="btn btn-secondary">Cancelar</a>
                            </div>
                        </form>
            </div>
        </div>

        <script>
            function toggleTestFields(testType) {
                const difficultyGroup = document.getElementById('difficulty-group');
                const attributeGroup = document.getElementById('attribute-group');
                const branchingGroup = document.getElementById('branching-group');

                if (testType === 'nenhum') {
                    difficultyGroup.style.display = 'none';
                    attributeGroup.style.display = 'none';
                    branchingGroup.style.display = 'none';
                } else {
                    difficultyGroup.style.display = 'block';
                    attributeGroup.style.display = 'block';
                    branchingGroup.style.display = 'grid';
                }
            }
        </script>
</body>

</html>