<%- include('../partials/header') %>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="display-6 fw-bold text-primary">
                    <i class="bi bi-backpack"></i> Inventario - <%= character.name %>
                </h1>
                <div class="d-flex align-items-center gap-2">
                    <div class="badge bg-warning text-dark fs-6 px-3 py-2">
                        <i class="bi bi-coin"></i>
                        <%= character.coins %> Moedas
                    </div>
                    <a href="/shop/<%= character.id %>" class="btn btn-success btn-sm">
                        <i class="bi bi-shop"></i> Loja
                    </a>
                    <a href="/my/characters/<%= character.id %>" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Voltar para Ficha
                    </a>
                </div>
            </div>

            <div class="row g-4">
                <!-- Left Panel: Equipment Slots -->
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-person-circle"></i> Equipamentos</h5>
                        </div>
                        <div class="card-body">
                            <!-- Head Slot -->
                            <div class="mb-3 p-3 border rounded" style="background: #f8f9fa;">
                                <div class="small text-muted fw-bold">🎩 CABECA</div>
                                <% if (equippedItems.head) { %>
                                    <div class="fw-bold">
                                        <%= equippedItems.head.item.icon %>
                                            <%= equippedItems.head.item.name %>
                                    </div>
                                    <form
                                        action="/inventory/<%= character.id %>/unequip/<%= equippedItems.head.item.id %>"
                                        method="POST" class="d-inline">
                                        <button type="submit"
                                            class="btn btn-sm btn-outline-danger mt-1">Desequipar</button>
                                    </form>
                                    <% } else { %>
                                        <div class="text-muted">Vazio</div>
                                        <% } %>
                            </div>

                            <!-- Body Slot -->
                            <div class="mb-3 p-3 border rounded" style="background: #f8f9fa;">
                                <div class="small text-muted fw-bold">👕 CORPO</div>
                                <% if (equippedItems.body) { %>
                                    <div class="fw-bold">
                                        <%= equippedItems.body.item.icon %>
                                            <%= equippedItems.body.item.name %>
                                    </div>
                                    <form
                                        action="/inventory/<%= character.id %>/unequip/<%= equippedItems.body.item.id %>"
                                        method="POST" class="d-inline">
                                        <button type="submit"
                                            class="btn btn-sm btn-outline-danger mt-1">Desequipar</button>
                                    </form>
                                    <% } else { %>
                                        <div class="text-muted">Vazio</div>
                                        <% } %>
                            </div>

                            <!-- Feet Slot -->
                            <div class="mb-3 p-3 border rounded" style="background: #f8f9fa;">
                                <div class="small text-muted fw-bold">👟 PES</div>
                                <% if (equippedItems.feet) { %>
                                    <div class="fw-bold">
                                        <%= equippedItems.feet.item.icon %>
                                            <%= equippedItems.feet.item.name %>
                                    </div>
                                    <form
                                        action="/inventory/<%= character.id %>/unequip/<%= equippedItems.feet.item.id %>"
                                        method="POST" class="d-inline">
                                        <button type="submit"
                                            class="btn btn-sm btn-outline-danger mt-1">Desequipar</button>
                                    </form>
                                    <% } else { %>
                                        <div class="text-muted">Vazio</div>
                                        <% } %>
                            </div>

                            <!-- Accessory Slot -->
                            <div class="p-3 border rounded" style="background: #f8f9fa;">
                                <div class="small text-muted fw-bold">💍 ACESSORIO</div>
                                <% if (equippedItems.accessory) { %>
                                    <div class="fw-bold">
                                        <%= equippedItems.accessory.item.icon %>
                                            <%= equippedItems.accessory.item.name %>
                                    </div>
                                    <form
                                        action="/inventory/<%= character.id %>/unequip/<%= equippedItems.accessory.item.id %>"
                                        method="POST" class="d-inline">
                                        <button type="submit"
                                            class="btn btn-sm btn-outline-danger mt-1">Desequipar</button>
                                    </form>
                                    <% } else { %>
                                        <div class="text-muted">Vazio</div>
                                        <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Panel: Inventory -->
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <ul class="nav nav-tabs card-header-tabs" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#consumables">🧪
                                        Consumiveis</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#equipment">🛡️ Equipamentos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#keys">🔑 Chaves</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#cosmetics">✨ Cosmeticos</a>
                                </li>
                            </ul>
                        </div>
                        <div class="card-body">
                            <div class="tab-content">
                                <!-- Consumables Tab -->
                                <div class="tab-pane fade show active" id="consumables">
                                    <% if (inventoryByType.consumable.length===0) { %>
                                        <div class="text-center py-5 text-muted">
                                            <i class="bi bi-box display-4 opacity-25"></i>
                                            <p class="mt-3">Nenhum consumivel no inventario.</p>
                                        </div>
                                        <% } else { %>
                                            <div class="row g-3">
                                                <% inventoryByType.consumable.forEach(ci=> { %>
                                                    <div class="col-md-6">
                                                        <div class="card h-100 border">
                                                            <div class="card-body">
                                                                <div class="d-flex align-items-start">
                                                                    <span class="fs-2 me-3">
                                                                        <%= ci.item.icon %>
                                                                    </span>
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="mb-1">
                                                                            <%= ci.item.name %>
                                                                                <% if (ci.quantity> 1) { %>
                                                                                    <span class="badge bg-secondary">x
                                                                                        <%= ci.quantity %>
                                                                                    </span>
                                                                                    <% } %>
                                                                        </h6>
                                                                        <p class="small text-muted mb-2">
                                                                            <%= ci.item.description %>
                                                                        </p>
                                                                        <div class="d-flex gap-2">
                                                                            <form
                                                                                action="/inventory/<%= character.id %>/use/<%= ci.item.id %>"
                                                                                method="POST" class="d-inline">
                                                                                <button type="submit"
                                                                                    class="btn btn-sm btn-success">Usar</button>
                                                                            </form>
                                                                            <form
                                                                                action="/inventory/<%= character.id %>/discard/<%= ci.item.id %>"
                                                                                method="POST" class="d-inline">
                                                                                <button type="submit"
                                                                                    class="btn btn-sm btn-outline-danger">Descartar</button>
                                                                            </form>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                            </div>
                                            <% } %>
                                </div>

                                <!-- Equipment Tab -->
                                <div class="tab-pane fade" id="equipment">
                                    <% if (inventoryByType.equipment.length===0) { %>
                                        <div class="text-center py-5 text-muted">
                                            <i class="bi bi-box display-4 opacity-25"></i>
                                            <p class="mt-3">Nenhum equipamento no inventario.</p>
                                        </div>
                                        <% } else { %>
                                            <div class="row g-3">
                                                <% inventoryByType.equipment.forEach(ci=> { %>
                                                    <div class="col-md-6">
                                                        <div class="card h-100 border">
                                                            <div class="card-body">
                                                                <div class="d-flex align-items-start">
                                                                    <span class="fs-2 me-3">
                                                                        <%= ci.item.icon %>
                                                                    </span>
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="mb-1">
                                                                            <%= ci.item.name %>
                                                                                <span
                                                                                    class="badge bg-light text-dark border">
                                                                                    <%= ci.item.slot %>
                                                                                </span>
                                                                        </h6>
                                                                        <p class="small text-muted mb-2">
                                                                            <%= ci.item.description %>
                                                                        </p>
                                                                        <div class="d-flex gap-2">
                                                                            <form
                                                                                action="/inventory/<%= character.id %>/equip/<%= ci.item.id %>"
                                                                                method="POST" class="d-inline">
                                                                                <button type="submit"
                                                                                    class="btn btn-sm btn-primary">Equipar</button>
                                                                            </form>
                                                                            <form
                                                                                action="/inventory/<%= character.id %>/discard/<%= ci.item.id %>"
                                                                                method="POST" class="d-inline">
                                                                                <button type="submit"
                                                                                    class="btn btn-sm btn-outline-danger">Descartar</button>
                                                                            </form>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                            </div>
                                            <% } %>
                                </div>

                                <!-- Keys Tab -->
                                <div class="tab-pane fade" id="keys">
                                    <% if (inventoryByType.key.length===0) { %>
                                        <div class="text-center py-5 text-muted">
                                            <i class="bi bi-box display-4 opacity-25"></i>
                                            <p class="mt-3">Nenhuma chave no inventario.</p>
                                        </div>
                                        <% } else { %>
                                            <div class="row g-3">
                                                <% inventoryByType.key.forEach(ci=> { %>
                                                    <div class="col-md-6">
                                                        <div class="card h-100 border-warning border-2">
                                                            <div class="card-body">
                                                                <div class="d-flex align-items-start">
                                                                    <span class="fs-2 me-3">
                                                                        <%= ci.item.icon %>
                                                                    </span>
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="mb-1">
                                                                            <%= ci.item.name %>
                                                                        </h6>
                                                                        <p class="small text-muted mb-0">
                                                                            <%= ci.item.description %>
                                                                        </p>
                                                                        <span
                                                                            class="badge bg-warning text-dark mt-2">Item
                                                                            de Missao</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                            </div>
                                            <% } %>
                                </div>

                                <!-- Cosmetics Tab -->
                                <div class="tab-pane fade" id="cosmetics">
                                    <% if (inventoryByType.cosmetic.length===0) { %>
                                        <div class="text-center py-5 text-muted">
                                            <i class="bi bi-box display-4 opacity-25"></i>
                                            <p class="mt-3">Nenhum cosmetico no inventario.</p>
                                        </div>
                                        <% } else { %>
                                            <div class="row g-3">
                                                <% inventoryByType.cosmetic.forEach(ci=> { %>
                                                    <div class="col-md-6">
                                                        <div class="card h-100 border">
                                                            <div class="card-body">
                                                                <div class="d-flex align-items-start">
                                                                    <span class="fs-2 me-3">
                                                                        <%= ci.item.icon %>
                                                                    </span>
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="mb-1">
                                                                            <%= ci.item.name %>
                                                                        </h6>
                                                                        <p class="small text-muted mb-2">
                                                                            <%= ci.item.description %>
                                                                        </p>
                                                                        <form
                                                                            action="/inventory/<%= character.id %>/discard/<%= ci.item.id %>"
                                                                            method="POST" class="d-inline">
                                                                            <button type="submit"
                                                                                class="btn btn-sm btn-outline-danger">Descartar</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                            </div>
                                            <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>