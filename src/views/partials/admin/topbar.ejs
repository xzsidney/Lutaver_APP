<header class="admin-topbar">
    <div class="admin-topbar-left">
        <span class="admin-logo">🎮 Lutaver</span>
        <span class="admin-topbar-title">Painel Administrativo</span>
    </div>

    <div class="admin-topbar-right">

        <% if (locals.user) { %>
            <span class="admin-user">
                👤 <%= locals.user.name %> (<%= locals.user.role %>)
            </span>
            <% } %>

                <button type="button" id="adminThemeToggle" class="admin-theme-toggle">
                    🌙 Modo escuro
                </button>

                <a href="/logout" class="admin-logout">Sair</a>
    </div>



</header>