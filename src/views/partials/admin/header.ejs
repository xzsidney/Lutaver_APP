<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Lutaver</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --blue-magic: #1E90FF;
            --yellow-spark: #F7D046;
            --green-energy: #34D399;
            --white-radiant: #FFFFFF;
            --dark-text: #2c3e50;
            --light-bg: #f8f9fa;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--light-bg);
            color: var(--dark-text);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--blue-magic);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #187bcd;
        }

        /* Admin Specific Styles */
        .admin-sidebar {
            background: var(--blue-magic);
            min-height: 100vh;
            color: white;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
        }

        .admin-sidebar .nav-link {
            color: rgba(255, 255, 255, 0.8);
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: all 0.3s ease;
        }

        .admin-sidebar .nav-link:hover,
        .admin-sidebar .nav-link.active {
            background: rgba(255, 255, 255, 0.1);
            color: var(--yellow-spark);
            transform: translateX(5px);
        }

        .admin-sidebar .nav-link i {
            margin-right: 10px;
            font-size: 1.1rem;
        }

        .main-content {
            padding: 30px;
        }

        .card-custom {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease;
            background: var(--white-radiant);
        }

        .card-custom:hover {
            transform: translateY(-5px);
        }

        .btn-magic {
            background-color: var(--blue-magic);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .btn-magic:hover {
            background-color: #187bcd;
            color: white;
            transform: translateY(-2px);
        }

        .btn-energy {
            background-color: var(--green-energy);
            color: white;
            border: none;
        }

        .btn-energy:hover {
            background-color: #2cb67d;
            color: white;
        }

        .table-custom th {
            background-color: #f8f9fa;
            border-bottom: 2px solid var(--blue-magic);
            color: var(--blue-magic);
            font-weight: 600;
        }

        .badge-role {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
        }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">