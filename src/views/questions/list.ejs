<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Banco de Questões - Lutaver</title>
    <link rel="stylesheet" href="/css/lutaver.css">
</head>

<body>
    <%- include('../partials/navbar', { user }) %>

        <div class="dashboard-container">
            <div class="header">
                <h1>❓ Banco de Questões</h1>
                <p>Gerencie todas as questões do quiz educacional</p>
            </div>

            <!-- Filtros -->
            <div
                style="background: white; padding: 20px; border-radius: 10px; margin-bottom: 20px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">
                <h3 style="color: #1E90FF; margin-bottom: 15px;">🔍 Filtros</h3>
                <form method="GET" action="/questions">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                        <div class="form-group" style="margin: 0;">
                            <label for="discipline_id">Disciplina</label>
                            <select id="discipline_id" name="discipline_id">
                                <option value="">Todas</option>
                                <% disciplines.forEach(d=> { %>
                                    <option value="<%= d.id %>" <%=filters.discipline_id==d.id ? 'selected' : '' %>>
                                        <%= d.icon || '📚' %>
                                            <%= d.name %>
                                    </option>
                                    <% }); %>
                            </select>
                        </div>

                        <div class="form-group" style="margin: 0;">
                            <label for="adventure_id">Aventura</label>
                            <select id="adventure_id" name="adventure_id">
                                <option value="">Todas</option>
                                <% adventures.forEach(a=> { %>
                                    <option value="<%= a.id %>" <%=filters.adventure_id==a.id ? 'selected' : '' %>>
                                        <%= a.title %>
                                    </option>
                                    <% }); %>
                            </select>
                        </div>

                        <div class="form-group" style="margin: 0;">
                            <label for="school_year">Ano Escolar</label>
                            <select id="school_year" name="school_year">
                                <option value="">Todos</option>
                                <option value="6º ano" <%=filters.school_year==='6º ano' ? 'selected' : '' %>>6º ano
                                </option>
                                <option value="7º ano" <%=filters.school_year==='7º ano' ? 'selected' : '' %>>7º ano
                                </option>
                                <option value="8º ano" <%=filters.school_year==='8º ano' ? 'selected' : '' %>>8º ano
                                </option>
                                <option value="9º ano" <%=filters.school_year==='9º ano' ? 'selected' : '' %>>9º ano
                                </option>
                            </select>
                        </div>

                        <div class="form-group" style="margin: 0;">
                            <label for="difficulty">Dificuldade</label>
                            <select id="difficulty" name="difficulty">
                                <option value="">Todas</option>
                                <option value="1" <%=filters.difficulty==1 ? 'selected' : '' %>>⭐ Muito Fácil</option>
                                <option value="2" <%=filters.difficulty==2 ? 'selected' : '' %>>⭐⭐ Fácil</option>
                                <option value="3" <%=filters.difficulty==3 ? 'selected' : '' %>>⭐⭐⭐ Médio</option>
                                <option value="4" <%=filters.difficulty==4 ? 'selected' : '' %>>⭐⭐⭐⭐ Difícil</option>
                                <option value="5" <%=filters.difficulty==5 ? 'selected' : '' %>>⭐⭐⭐⭐⭐ Muito Difícil
                                </option>
                            </select>
                        </div>
                    </div>
                    <div style="display: flex; gap: 10px; margin-top: 15px;">
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                        <a href="/questions" class="btn btn-secondary">Limpar</a>
                    </div>
                </form>
            </div>

            <div style="margin-bottom: 20px;">
                <a href="/questions/new" class="btn btn-success btn-large">+ Nova Questão</a>
            </div>

            <% if (questions.length===0) { %>
                <div
                    style="background: white; padding: 60px; border-radius: 10px; text-align: center; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 80px; margin-bottom: 20px;">📝</div>
                    <h3 style="color: #666; margin-bottom: 10px;">Nenhuma questão encontrada</h3>
                    <p style="color: #999;">Tente ajustar os filtros ou crie uma nova questão!</p>
                </div>
                <% } else { %>
                    <div class="cards-grid">
                        <% questions.forEach((q, index)=> { %>
                            <div class="card"
                                style="border-top: 4px solid <%= q.difficulty <= 2 ? '#34D399' : q.difficulty === 3 ? '#F7D046' : '#E74C3C' %>;">
                                <div
                                    style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                                    <div>
                                        <h3 style="color: #1E90FF; margin-bottom: 8px; font-size: 18px;">
                                            Questão #<%= q.id %>
                                        </h3>
                                        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px;">
                                            <% if (q.discipline) { %>
                                                <span class="badge"
                                                    style="background: <%= q.discipline.color_theme || '#1E90FF' %>;">
                                                    <%= q.discipline.icon || '📚' %>
                                                        <%= q.discipline.name %>
                                                </span>
                                                <% } %>
                                                    <span class="badge" style="background: #34D399;">
                                                        <%= q.school_year %>
                                                    </span>
                                                    <span style="color: #F7D046; font-size: 14px;">
                                                        <% for(let i=0; i < q.difficulty; i++) { %>⭐<% } %>
                                                    </span>
                                        </div>
                                        <% if (q.adventure) { %>
                                            <div style="font-size: 12px; color: #666;">
                                                🗺️ Aventura: <strong>
                                                    <%= q.adventure.title %>
                                                </strong>
                                            </div>
                                            <% } %>
                                    </div>
                                </div>

                                <div
                                    style="background: #F0F9FF; padding: 15px; border-radius: 8px; margin-bottom: 15px; border-left: 3px solid #1E90FF;">
                                    <p style="font-weight: 500; line-height: 1.6; margin: 0;">
                                        <%= q.question_text.substring(0, 150) %>
                                            <%= q.question_text.length> 150 ? '...' : '' %>
                                    </p>
                                </div>

                                <div
                                    style="background: #F9FAFB; padding: 12px; border-radius: 8px; margin-bottom: 15px;">
                                    <div style="display: grid; gap: 8px;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span
                                                style="background: <%= q.correct_option === 'A' ? '#34D399' : '#E5E7EB' %>; color: <%= q.correct_option === 'A' ? 'white' : '#666' %>; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px;">A</span>
                                            <span style="font-size: 13px; color: #666;">
                                                <%= q.option_a.substring(0, 40) %>...
                                            </span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span
                                                style="background: <%= q.correct_option === 'B' ? '#34D399' : '#E5E7EB' %>; color: <%= q.correct_option === 'B' ? 'white' : '#666' %>; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px;">B</span>
                                            <span style="font-size: 13px; color: #666;">
                                                <%= q.option_b.substring(0, 40) %>...
                                            </span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span
                                                style="background: <%= q.correct_option === 'C' ? '#34D399' : '#E5E7EB' %>; color: <%= q.correct_option === 'C' ? 'white' : '#666' %>; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px;">C</span>
                                            <span style="font-size: 13px; color: #666;">
                                                <%= q.option_c.substring(0, 40) %>...
                                            </span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span
                                                style="background: <%= q.correct_option === 'D' ? '#34D399' : '#E5E7EB' %>; color: <%= q.correct_option === 'D' ? 'white' : '#666' %>; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px;">D</span>
                                            <span style="font-size: 13px; color: #666;">
                                                <%= q.option_d.substring(0, 40) %>...
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div style="display: flex; gap: 8px; justify-content: space-between;">
                                    <a href="/questions/<%= q.id %>/edit" class="btn btn-warning btn-sm"
                                        style="flex: 1;">✏️ Editar</a>
                                    <form action="/questions/<%= q.id %>/delete" method="POST" style="flex: 1;"
                                        onsubmit="return confirm('Tem certeza que deseja excluir esta questão?');">
                                        <button type="submit" class="btn btn-danger btn-sm" style="width: 100%;">🗑️
                                            Excluir</button>
                                    </form>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
        </div>
</body>

</html>