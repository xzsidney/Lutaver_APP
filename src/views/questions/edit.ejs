<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Questão - Lutaver</title>
    <link rel="stylesheet" href="/css/lutaver.css">
</head>

<body>
    <%- include('../partials/navbar', { user }) %>

        <div class="dashboard-container">
            <div class="header">
                <h1>✏️ Editar Questão</h1>
                <p>Atualize a questão #<%= question.id %>
                </p>
            </div>

            <div
                style="background: white; padding: 30px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); max-width: 900px;">
                <% if (error) { %>
                    <div class="error-message">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/questions/<%= question.id %>" method="POST">
                            <!-- Informações da Questão -->
                            <fieldset
                                style="border: 2px solid #1E90FF; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                                <legend style="color: #1E90FF; font-weight: 600; padding: 0 10px;">📚 Informações da
                                    Questão</legend>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="discipline_id">Disciplina *</label>
                                        <select id="discipline_id" name="discipline_id" required>
                                            <% disciplines.forEach(d=> { %>
                                                <option value="<%= d.id %>" <%=question.discipline_id===d.id
                                                    ? 'selected' : '' %>>
                                                    <%= d.icon || '📚' %>
                                                        <%= d.name %>
                                                </option>
                                                <% }); %>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label for="adventure_id">Aventura (Opcional)</label>
                                        <select id="adventure_id" name="adventure_id">
                                            <option value="">Nenhuma</option>
                                            <% adventures.forEach(a=> { %>
                                                <option value="<%= a.id %>" <%=question.adventure_id===a.id ? 'selected'
                                                    : '' %>>
                                                    <%= a.title %>
                                                </option>
                                                <% }); %>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="school_year">Ano Escolar *</label>
                                        <select id="school_year" name="school_year" required>
                                            <option value="6º ano" <%=question.school_year==='6º ano' ? 'selected' : ''
                                                %>>6º ano</option>
                                            <option value="7º ano" <%=question.school_year==='7º ano' ? 'selected' : ''
                                                %>>7º ano</option>
                                            <option value="8º ano" <%=question.school_year==='8º ano' ? 'selected' : ''
                                                %>>8º ano</option>
                                            <option value="9º ano" <%=question.school_year==='9º ano' ? 'selected' : ''
                                                %>>9º ano</option>
                                            <option value="1º ano EM" <%=question.school_year==='1º ano EM' ? 'selected'
                                                : '' %>>1º ano EM</option>
                                            <option value="2º ano EM" <%=question.school_year==='2º ano EM' ? 'selected'
                                                : '' %>>2º ano EM</option>
                                            <option value="3º ano EM" <%=question.school_year==='3º ano EM' ? 'selected'
                                                : '' %>>3º ano EM</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label for="difficulty">Dificuldade *</label>
                                        <select id="difficulty" name="difficulty" required>
                                            <option value="1" <%=question.difficulty===1 ? 'selected' : '' %>>⭐ Muito
                                                Fácil</option>
                                            <option value="2" <%=question.difficulty===2 ? 'selected' : '' %>>⭐⭐ Fácil
                                            </option>
                                            <option value="3" <%=question.difficulty===3 ? 'selected' : '' %>>⭐⭐⭐ Médio
                                            </option>
                                            <option value="4" <%=question.difficulty===4 ? 'selected' : '' %>>⭐⭐⭐⭐
                                                Difícil</option>
                                            <option value="5" <%=question.difficulty===5 ? 'selected' : '' %>>⭐⭐⭐⭐⭐
                                                Muito Difícil</option>
                                        </select>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Pergunta -->
                            <fieldset
                                style="border: 2px solid #F7D046; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                                <legend style="color: #F7D046; font-weight: 600; padding: 0 10px;">❓ Pergunta</legend>

                                <div class="form-group">
                                    <label for="question_text">Texto da Pergunta *</label>
                                    <textarea id="question_text" name="question_text" rows="4"
                                        required><%= question.question_text %></textarea>
                                </div>
                            </fieldset>

                            <!-- Alternativas -->
                            <fieldset
                                style="border: 2px solid #34D399; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                                <legend style="color: #34D399; font-weight: 600; padding: 0 10px;">📝 Alternativas
                                </legend>

                                <div class="form-group">
                                    <label for="option_a">Alternativa A *</label>
                                    <input type="text" id="option_a" name="option_a" value="<%= question.option_a %>"
                                        required>
                                </div>

                                <div class="form-group">
                                    <label for="option_b">Alternativa B *</label>
                                    <input type="text" id="option_b" name="option_b" value="<%= question.option_b %>"
                                        required>
                                </div>

                                <div class="form-group">
                                    <label for="option_c">Alternativa C *</label>
                                    <input type="text" id="option_c" name="option_c" value="<%= question.option_c %>"
                                        required>
                                </div>

                                <div class="form-group">
                                    <label for="option_d">Alternativa D *</label>
                                    <input type="text" id="option_d" name="option_d" value="<%= question.option_d %>"
                                        required>
                                </div>

                                <div class="form-group">
                                    <label for="correct_option">Alternativa Correta *</label>
                                    <select id="correct_option" name="correct_option" required
                                        style="font-size: 18px; font-weight: bold;">
                                        <option value="A" <%=question.correct_option==='A' ? 'selected' : '' %>>A
                                        </option>
                                        <option value="B" <%=question.correct_option==='B' ? 'selected' : '' %>>B
                                        </option>
                                        <option value="C" <%=question.correct_option==='C' ? 'selected' : '' %>>C
                                        </option>
                                        <option value="D" <%=question.correct_option==='D' ? 'selected' : '' %>>D
                                        </option>
                                    </select>
                                </div>
                            </fieldset>

                            <!-- Explicação -->
                            <fieldset
                                style="border: 2px solid #9333EA; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                                <legend style="color: #9333EA; font-weight: 600; padding: 0 10px;">💡 Explicação
                                </legend>

                                <div class="form-group">
                                    <label for="explanation">Explicação da Resposta (Opcional)</label>
                                    <textarea id="explanation" name="explanation"
                                        rows="3"><%= question.explanation || '' %></textarea>
                                </div>
                            </fieldset>

                            <div style="display: flex; gap: 10px; margin-top: 30px;">
                                <button type="submit" class="btn btn-success btn-large">✅ Salvar Alterações</button>
                                <a href="/questions" class="btn btn-secondary btn-large">❌ Cancelar</a>
                            </div>
                        </form>
            </div>
        </div>
</body>

</html>